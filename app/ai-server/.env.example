OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
OLLAMA_NATIVE_URL=http://localhost:11434
DATABASE_URL=postgres://user:password@localhost:5432/vizi_db
DB_POOL_MAX=10
APP_VERSION=
DB_SCHEMA_VERSION=
AUTO_ALIGN_DB_VERSION=true
PORT=5055
JSON_BODY_LIMIT=64mb
DEBUG_ROUTES=0

# Microsoft OAuth (optional)
# Register a Web app in Microsoft Entra ID and add redirect URI:
#   http://localhost:5055/api/auth/microsoft/callback
# (or your deployed base URL + /api/auth/microsoft/callback)
MS_OAUTH_TENANT=common
MS_OAUTH_ENABLED=1
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=
MS_OAUTH_SCOPES=openid profile email User.Read
