OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
OLLAMA_NATIVE_URL=http://localhost:11434
CHAT_AI_HISTORY_MAX=8
CHAT_AI_MESSAGE_CHAR_MAX=900
OLLAMA_CHAT_MAX_PREDICT=320
OLLAMA_CHAT_TEMPERATURE=0.2
OLLAMA_CHAT_KEEP_ALIVE=20m
FLOUR_KNOWLEDGE_MAX_CHARS=6000
DATABASE_URL=postgres://user:password@localhost:5432/vizi_db
DB_CLIENT=postgres
DB_POOL_MAX=10
TREND_DATABASE_URL=postgres://user:password@localhost:5432/vizi_trends
TREND_DB_POOL_MAX=10
LOG_DATABASE_URL=postgres://user:password@localhost:5432/vizi_logs
LOG_DB_POOL_MAX=10
APP_VERSION=
DB_SCHEMA_VERSION=
AUTO_ALIGN_DB_VERSION=true
PORT=5055
JSON_BODY_LIMIT=64mb
DEBUG_ROUTES=0

# SQL Server scaffold (Phase 1 option)
# Set DB_CLIENT=sqlserver and fill values below.
# Runtime query parity for SQL Server is completed in a later phase.
DB_SQLSERVER_HOST=localhost
DB_SQLSERVER_PORT=1433
DB_SQLSERVER_DATABASE=vizi_db
DB_SQLSERVER_USER=sa
DB_SQLSERVER_PASSWORD=
DB_SQLSERVER_ENCRYPT=true
DB_SQLSERVER_TRUST_SERVER_CERTIFICATE=true
DB_SQLSERVER_APP_NAME=mesora

# Microsoft OAuth (optional)
# Register a Web app in Microsoft Entra ID and add redirect URI:
#   http://localhost:5055/api/auth/microsoft/callback
# (or your deployed base URL + /api/auth/microsoft/callback)
MS_OAUTH_TENANT=common
MS_OAUTH_ENABLED=1
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=
MS_OAUTH_REDIRECT_URI=
MS_OAUTH_SCOPES=openid profile email User.Read
