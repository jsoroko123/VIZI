mat="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="i_MinimumRawFlow" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="i_MaxiimumRawFlow" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="i_OneSecondPulse" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_TotalFlow" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="i_ResetTotal" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_FlowRateCalculated" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="i_UnitsPerMInute" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_UnitsPerHour" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_UnitsPerSecond" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_SimulateTrigger" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_Simulate" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_FlowActive" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_FlowRateActiveSetpoint" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="i_RawFlowActiveSimSP" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="AnalogFlow" DataType="Scaling2" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[1,0.00000000e+000,0.00000000e+000,0,0,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="Scaling2"><DataValueMember Name="EnableIn" DataType="BOOL" Value="1" /><DataValueMember Name="EnableOut" DataType="BOOL" Value="0" /><DataValueMember Name="o_Value" DataType="REAL" Radix="Float" Value="0.0" /><DataValueMember Name="i_Value" DataType="REAL" Radix="Float" Value="0.0" /><DataValueMember Name="i_MinEU" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="i_MaxEU" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="i_MinRaw" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="i_MaxRaw" DataType="DINT" Radix="Decimal" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="RawFlowRate" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[Flow Totalizer]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIO(i_Simulate)MOVE(i_RawFlowRate,RawFlowRate);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[Scaling2(AnalogFlow,o_FlowRateScaled,RawFlowRate,i_MinimumScaledFlow,i_MaximumScaledFlow,i_MinimumRawFlow,i_MaxiimumRawFlow);]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[If the Scaled Flow Rate is Gallons Per Hour this rung converts to GallonsPerSecond and moves this value into o_FlowRateCalculated]]></Comment><Text><![CDATA[XIC(i_UnitsPerHour)DIV(o_FlowRateScaled,3600.00,o_FlowRateCalculated);]]></Text></Rung><Rung Number="4" Type="N"><Comment><![CDATA[If the Scaled Flow Rate is Gallons Per Hour this rung converts to GallonsPerSecond and moves this value into o_FlowRateCalculated]]></Comment><Text><![CDATA[XIC(i_UnitsPerMInute)DIV(o_FlowRateScaled,60,o_FlowRateCalculated);]]></Text></Rung><Rung Number="5" Type="N"><Comment><![CDATA[If the Scaled Flow Rate is Gallons Per Second this rung  moves this value into o_FlowRateCalculated]]></Comment><Text><![CDATA[XIC(i_UnitsPerSecond)MOVE(o_FlowRateScaled,o_FlowRateCalculated);]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[XIC(i_OneSecondPulse)ADD(o_FlowRateCalculated,o_TotalFlow,o_TotalFlow);]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[XIC(i_ResetTotal)MOVE(0,o_TotalFlow);]]></Text></Rung><Rung Number="8" Type="N"><Text><![CDATA[XIC(i_Simulate)[XIC(i_SimulateTrigger) MOVE(i_RawFlowActiveSimSP,RawFlowRate) ,XIO(i_SimulateTrigger) MOVE(4000,RawFlowRate) ];]]></Text></Rung><Rung Number="9" Type="N"><Text><![CDATA[GT(o_FlowRateScaled,i_FlowRateActiveSetpoint)OTE(o_FlowActive);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="IFM_AL1x2x_DeviceInfo_8P" Class="Standard" Revision="2.2" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2019-04-24T23:09:59.887Z" CreatedBy="INTRAIFM\ushoopla" EditedDate="2023-10-10T20:46:53.036Z" EditedBy="ACI\kkeller" SoftwareRevision="v32.03"><RevisionNote><![CDATA[When device is connected all parameters are read automatically. WrApp data is diabled for during device connected read. 
Add compare levels
4/15/20: Device can be disconnected an connected while processing commands. The cmd Trigger is reset via the added CmdTrig_Timer
7/9/20: If Commands are interupted by device disconnect during commands processing AOI resets]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false" /><Parameter Name="PLC_Output" TagType="Base" DataType="INT" Dimensions="151" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false" /><Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_Not_Connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="AOI_Settings_Error" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="IOLinkMaster_Name" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible