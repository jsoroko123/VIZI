Line><Line Number="16"><![CDATA[o_MaxAmps := MaxAmps;]]></Line><Line Number="17"><![CDATA[]]></Line><Line Number="18"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="19"><![CDATA[' Simulated Value]]></Line><Line Number="20"><![CDATA[']]></Line><Line Number="21"><![CDATA[******************************************************************************************************************************************************)]]></Line><Line Number="22"><![CDATA[IF i_SimulateEnabled THEN]]></Line><Line Number="23"><![CDATA[]]></Line><Line Number="24"><![CDATA[(*]]></Line><Line Number="25"><![CDATA[*)]]></Line><Line Number="26"><![CDATA[IF i_Running THEN]]></Line><Line Number="27"><![CDATA[]]></Line><Line Number="28"><![CDATA[IF NOT Sim_Inrush THEN]]></Line><Line Number="29"><![CDATA[]]></Line><Line Number="30"><![CDATA[Sim_Curve.i_LastValue := MaxAmps * Sim_InrushMultiplier ;]]></Line><Line Number="31"><![CDATA[]]></Line><Line Number="32"><![CDATA[IF Sim_State <> 1 THEN]]></Line><Line Number="33"><![CDATA[Sim_TriggerRamp := 1 ;]]></Line><Line Number="34"><![CDATA[Sim_State := 1 ;]]></Line><Line Number="35"><![CDATA[END_IF ;]]></Line><Line Number="36"><![CDATA[]]></Line><Line Number="37"><![CDATA[ELSIF i_Dirty THEN]]></Line><Line Number="38"><![CDATA[]]></Line><Line Number="39"><![CDATA[Sim_Curve.i_LastValue := MaxAmps * Sim_LoadedMultiplier ;]]></Line><Line Number="40"><![CDATA[]]></Line><Line Number="41"><![CDATA[IF Sim_State <> 2 THEN]]></Line><Line Number="42"><![CDATA[Sim_TriggerRamp := 1 ;]]></Line><Line Number="43"><![CDATA[Sim_State := 2 ;]]></Line><Line Number="44"><![CDATA[END_IF ;]]></Line><Line Number="45"><![CDATA[]]></Line><Line Number="46"><![CDATA[ELSE]]></Line><Line Number="47"><![CDATA[]]></Line><Line Number="48"><![CDATA[Sim_Curve.i_LastValue := MaxAmps * Sim_NormalMultiplier ;]]></Line><Line Number="49"><![CDATA[]]></Line