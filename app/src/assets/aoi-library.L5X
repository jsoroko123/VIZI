 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Set Timer Values
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[MOVE(i_MonTime,MonTimer.PRE)MOVE(i_DelayFaultTime,DelayFaultTimer.PRE)MOVE(i_StartDelayTime,StartDelayTimer.PRE)MOVE(i_StartingTime,StartingTimer.PRE)MOVE(i_StoppingTime,StoppingTimer.PRE)MOVE(i_IdlingTime,IdlingTimer.PRE)MOVE(i_CleanOutTime,CleanOutTimer.PRE);]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Disable Push Button
