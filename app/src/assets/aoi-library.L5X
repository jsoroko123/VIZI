<AddOnInstructionDefinition Name="PN_PE_Status_B_8PORT_IOL" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2022-05-13T19:57:08.674Z" CreatedBy="INTRAIFM\ushoopla" EditedDate="2022-09-12T17:01:14.528Z" EditedBy="INTRAIFM\ushoopla" SoftwareRevision="v32.02"><RevisionNote><![CDATA[
]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[Reference the Input Controller tag <IOLinkMasterName>:I1.Data]]></Description></Parameter><Parameter Name="Port_Process_Data_Size" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value from the Configuration Controller tag <IOLinkMasterName>:C.Port_Process_Data_Size]]></Description><DefaultData Format="L5K"><![CDATA[4]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="4" /></DefaultData></Parameter><Parameter Name="Port_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value = Port number of the IO-Link Master]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Vendor_ID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value indicating the manufacturer of the IO-Link Device. ifm=310 dec]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_ID" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value set by the manufacturer of the device. Varies by product family]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Port is configured for IO-Link Communication. False: Port is not configured for IO-Link Communication]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_Not_Connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: No IO-Link Device is connected
False: IO-Link Device is connected]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Invalid_Data" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Data is invalid False: IO-Link Data is valid]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Wrong_VID_DID" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Vendor ID and/or Device ID does not match the configured VID or DID set in Configuration Controller Tag(s) <IOLink MasterName>:C.Vendor_ID_Port_n or ...C.Device_ID_Port_n]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Diagnostic_Avail" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Event data is available False: No Event data is present]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="AOI_Settings_Error" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[A user input is out of range. Check port process data size and port number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="OUT1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Status depends on [OU1]]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="OUT2" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Status depends on [OU2]]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Pressure" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Current pressure]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Gradient" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Gradient Value as specified by the IO-Link Device Description pdf]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Device_OK" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Maintenance_required" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Out_Of_Specification" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Functional_check" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Failure" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Data_Size" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Factor of the RealPort_Num to calcualated the Offset_Address]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_StatusFlgs" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[RealPort_Num+9]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_Address" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Data_Size*RealPort_Number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Process_Offset" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_Address+95(8port Master) or Offset_Address+59(4port Master). Used to indicate the word offset for where the IO-Link device’s process input data starts]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="RealPort_Num" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of the Port_Number-1]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="StatusFlgs_Offset" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_StatusFlgs+23]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Pressure_Calc" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Shifting Word bits]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Device_Status" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Current device status]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[Calculate Data_Size depending on Port_Process_Data_Size input by the user]]></Comment><Text><![CDATA[[EQ(Port_Process_Data_Size,0) MOVE(1,Data_Size) ,EQ(Port_Process_Data_Size,1) MOVE(2,Data_Size) ,EQ(Port_Process_Data_Size,2) MOVE(4,Data_Size) ,EQ(Port_Process_Data_Size,3) MOVE(8,Data_Size) ,EQ(Port_Process_Data_Size,4) MOVE(16,Data_Size) ];]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[If the user input Port_Number <= to the maximum number of ports on the IO-Link master (4 or 8) and the Port_Number != to 0 then 
calculate the Process_Offset  (if process input data is produced by the IO-Link Device) and/or calculate the Process_Value_Offset (if process output data is consumed by the IO-Link Device). 
Parallel to the Calculation of the Process_Offset and/or Process_Value_Offset calculate the value of the StatusFlgs_Offset
]]></Comment><Text><![CDATA[LE(Port_Number,8)GT(Port_Number,0)SUB(Port_Number,1,RealPort_Num)[MUL(Data_Size,RealPort_Num,Offset_Address) ADD(Offset_Address,95,Process_Offset) ,MUL(9,RealPort_Num,Offset_StatusFlgs) ADD(Offset_StatusFlgs,23,StatusFlgs_Offset) ];]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[Sets states of IOL_Mode, Device_Not_Connected, Invalid_Data, Wrong_VID_DID and Diagnostic Available and set the values for the Vendor ID and Device ID from the Controller input tags of the user input Port_Number
]]></Comment><Text><![CDATA[[XIC(PLC_Input[StatusFlgs_Offset].0) OTE(IOL_Mode) ,XIC(PLC_Input[StatusFlgs_Offset].1) OTE(Device_Not_Connected) ,XIC(PLC_Input[StatusFlgs_Offset].2) OTE(Invalid_Data) ,XIC(PLC_Input[StatusFlgs_Offset].3) OTE(Wrong_VID_DID) ,XIC(PLC_Input[StatusFlgs_Offset].7) OTE(Diagnostic_Avail) ,MOVE(PLC_Input[StatusFlgs_Offset+1],Vendor_ID) ,COP(PLC_Input[StatusFlgs_Offset+2],Device_ID,1) ];]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[Set the State of AOI_Setting_Error by verifying the user input setting of Port_Number and Port_Process_Data_Size is within range of the IO-Link Master. GRT instruction for Port_Number compares to value=8 for 8 port masters and =4 for 4 port masters]]></Comment><Text><![CDATA[[LE(Port_Number,0) ,GT(Port_Number,8) ,LT(Port_Process_Data_Size,0) ,GT(Port_Process_Data_Size,4) ]OTE(AOI_Settings_Error);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[MUL(PLC_Input[Process_Offset],Gradient,Pressure) ,XIC(PLC_Input[Process_Offset+1].0) OTE(OUT1) ,XIC(PLC_Input[Process_Offset+1].0) OTE(OUT2) ];]]></Text></Rung><Rung Number="5" Type="N"><Comment><![CDATA[Device Status byte is converted to binary outputs]]></Comment><Text><![CDATA[BTD(PLC_Input[Process_Offset+1],4,Device_Status,0,4)[EQ(Device_Status,0) OTE(Device_OK) ,EQ(Device_Status,1) OTE(Maintenance_required) ,EQ(Device_Status,2) OTE(Out_Of_Specification) ,EQ(Device_Status,3) OTE(Functional_check) ,EQ(Device_Status,4) OTE(Failure) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="PN_PI2_PP_8PORT_IOL" Class="Standard" Revision="1.1" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2022-05-13T19:57:08.674Z" CreatedBy="INTRAIFM\ushoopla" EditedDate="2022-10-14T16:46:28.178Z" EditedBy="INTRAIFM\ushoopla" SoftwareRevision="v32.02"><RevisionNote><![CDATA[Replaces PN_PI_PP_nPORT_IOL
1/2023: changed Pres_Calc tag from SINT to INT]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[Reference the Input Controller tag <IOLinkMasterName>:I1.Data]]></Description></Parameter><Parameter Name="Port_Process_Data_Size" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value from the Configuration Controller tag <IOLinkMasterName>:C.Port_Process_Data_Size]]></Description><DefaultData Format="L5K"><![CDATA[4]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="4" /></DefaultData></Parameter><Parameter Name="Port_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value = Port number of the IO-Link Master]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Vendor_ID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value indicating the manufacturer of the IO-Link Device. ifm=310 dec]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_ID" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value set by the manufacturer of the device. Varies by product family]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Port is configured for IO-Link Communication. False: Port is not configured for IO-Link Communication]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_Not_Connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: No IO-Link Device is connected
False: IO-Link Device is connected]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Invalid_Data" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Data is invalid False: IO-Link Data is valid]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Wrong_VID_DID" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Vendor ID and/or Device ID does not match the configured VID or DID set in Configuration Controller Tag(s) <IOLink MasterName>:C.Vendor_ID_Port_n or ...C.Device_ID_Port_n]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Diagnostic_Avail" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Event data is available False: No Event data is present]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="AOI_Settings_Error" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[A user input is out of range. Check port process data size and port number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="OUT1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Status depends on [OU1]]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="OUT2" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Status depends on [OU2]]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Gradient" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Gradient Value as specified by the IO-Link Device Description pdf]]></Description><DefaultData Format="L5K"><![CDATA[1.00000000e-001]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.1" /></DefaultData></Parameter><Parameter Name="Pressure" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Current pressure]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Data_Size" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Factor of the RealPort_Num to calcualated the Offset_Address]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_StatusFlgs" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[RealPort_Num+9]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_Address" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Data_Size*RealPort_Number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Process_Offset" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_Address+95(8port Master) or Offset_Address+59(4port Master). Used to indicate the word offset for where the IO-Link device’s process input data starts]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="RealPort_Num" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of the Port_Number-1]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="StatusFlgs_Offset" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_StatusFlgs+23]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Pressure_Calc" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Shifting Word bits]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[Calculate Data_Size depending on Port_Process_Data_Size input by the user]]></Comment><Text><![CDATA[[EQ(Port_Process_Data_Size,0) MOVE(1,Data_Size) ,EQ(Port_Process_Data_Size,1) MOVE(2,Data_Size) ,EQ(Port_Process_Data_Size,2) MOVE(4,Data_Size) ,EQ(Port_Process_Data_Size,3) MOVE(8,Data_Size) ,EQ(Port_Process_Data_Size,4) MOVE(16,Data_Size) ];]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[If the user input Port_Number <= to the maximum number of ports on the IO-Link master (4 or 8) and the Port_Number != to 0 then 
calculate the Process_Offset  (if process input data is produced by the IO-Link Device) and/or calculate the Process_Value_Offset (if process output data is consumed by the IO-Link Device). 
Parallel to the Calculation of the Process_Offset and/or Process_Value_Offset calculate the value of the StatusFlgs_Offset
]]></Comment><Text><![CDATA[LE(Port_Number,8)GT(Port_Number,0)SUB(Port_Number,1,RealPort_Num)[MUL(Data_Size,RealPort_Num,Offset_Address) ADD(Offset_Address,95,Process_Offset) ,MUL(9,RealPort_Num,Offset_StatusFlgs) ADD(Offset_StatusFlgs,23,StatusFlgs_Offset) ];]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[Sets states of IOL_Mode, Device_Not_Connected, Invalid_Data, Wrong_VID_DID and Diagnostic Available and set the values for the Vendor ID and Device ID from the Controller input tags of the user input Port_Number
]]></Comment><Text><![CDATA[[XIC(PLC_Input[StatusFlgs_Offset].0) OTE(IOL_Mode) ,XIC(PLC_Input[StatusFlgs_Offset].1) OTE(Device_Not_Connected) ,XIC(PLC_Input[StatusFlgs_Offset].2) OTE(Invalid_Data) ,XIC(PLC_Input[StatusFlgs_Offset].3) OTE(Wrong_VID_DID) ,XIC(PLC_Input[StatusFlgs_Offset].7) OTE(Diagnostic_Avail) ,MOVE(PLC_Input[StatusFlgs_Offset+1],Vendor_ID) ,COP(PLC_Input[StatusFlgs_Offset+2],Device_ID,1) ];]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[Set the State of AOI_Setting_Error by verifying the user input setting of Port_Number and Port_Process_Data_Size is within range of the IO-Link Master. GRT instruction for Port_Number compares to value=8 for 8 port masters and =4 for 4 port masters]]></Comment><Text><![CDATA[[LE(Port_Number,0) ,GT(Port_Number,8) ,LT(Port_Process_Data_Size,0) ,GT(Port_Process_Data_Size,4) ]OTE(AOI_Settings_Error);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[DIV(PLC_Input[Process_Offset],4,Pressure_Calc) MUL(Pressure_Calc,Gradient,Pressure) ,XIC(PLC_Input[Process_Offset].0) OTE(OUT1) ,XIC(PLC_Input[Process_Offset].1) OTE(OUT2) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="PULSES" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2020-04-14T14:20:23.517Z" CreatedBy="ACI\kkeller" EditedDate="2020-05-01T11:22:02.803Z" EditedBy="ACI\kkeller" SoftwareRevision="v32.02"><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PULSE" TagType="Base" DataType="KK_PULSES" Usage="InOut" Required="true" Visible="true" Constant="false" /><Parameter Name="Trigger_CmdTick500ms" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Trigger_CmdTick1000ms" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Counter1Min" DataType="COUNTER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,60,36]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="COUNTER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="60" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="36" /><DataValueMember Name="CU" DataType="BOOL" Value="0" /><DataValueMember Name="CD" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /><DataValueMember Name="OV" DataType="BOOL" Value="0" /><DataValueMember Name="UN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="tmpBit" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[XIO(PULSE.CycleFlasher)OTE(PULSE.CycleFlasher);]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[
500 ms tick.]]></Comment><Text><![CDATA[XIC(Trigger_CmdTick500ms)[OTE(PULSE.Tick500ms) ,OTU(Trigger_CmdTick500ms) ];]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[
1000 ms tick.]]></Comment><Text><![CDATA[XIC(Trigger_CmdTick1000ms)[OTE(PULSE.Tick1s) ,OTE(PULSE.Tick1000ms) ,OTU(Trigger_CmdTick1000ms) ];]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[
 1min tick.]]></Comment><Text><![CDATA[[XIC(PULSE.Tick1s) MOVE(60,Counter1Min.PRE) CTU(Counter1Min,?,?) ,OTU(Counter1Min.CU) ,XIC(Counter1Min.DN) [OTE(PULSE.Tick1min) ,RES(Counter1Min) ] ];]]></Text></Rung><Rung Number="4" Type="N"><Comment><![CDATA[	===Set all 500 ms tick flags===
]]></Comment><Text><![CDATA[XIC(PULSE.Tick500ms)[XIC(PULSE.Pulse500ms) [OTE(tmpBit) ,OTU(PULSE.Pulse500ms) ] ,XIO(tmpBit) OTL(PULSE.Pulse500ms) ];]]></Text></Rung><Rung Number="5" Type="N"><Comment><![CDATA[	===Set all 1000 ms tick flags===
]]></Comment><Text><![CDATA[XIC(PULSE.Tick1000ms)[XIC(PULSE.Pulse1000ms) [OTE(tmpBit) ,OTU(PULSE.Pulse1000ms) ] ,XIO(tmpBit) OTL(PULSE.Pulse1000ms) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
