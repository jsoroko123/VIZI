ent Index="[5]" Value="0" /><Element Index="[6]" Value="0" /></Array></DefaultData></LocalTag><LocalTag Name="LIVECLOCK" DataType="KK_CONTROLLER_TIME" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,0,0,0,0,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="KK_CONTROLLER_TIME"><DataValueMember Name="Year" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="Month" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="Day" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="Hour" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="Minutes" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="Seconds" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="MicroSeconds" DataType="DINT" Radix="Decimal" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="AGCOM_DATETIME" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Wrk_F" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Wrk_G" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[GSV(WALLCLOCKTIME,,LocalDateTime,DATETIME[0]);]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[COP(DATETIME[0],LIVECLOCK,1)MOVE(LIVECLOCK.Year,YEAR)MOVE(LIVECLOCK.Month,MONTH)MOVE(LIVECLOCK.Day,DAY)MOVE(LIVECLOCK.Hour,HOUR)MOVE(LIVECLOCK.Minutes,MIN)MOVE(LIVECLOCK.Seconds,SEC)MOVE(LIVECLOCK.MicroSeconds,MS);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[[[DTOS(DATETIME[0],YEARSTRING) DTOS(DATETIME[1],MONTHSTRING) DTOS(DATETIME[2],DAYSTRING) ,GT(DATETIME[3],12) SUB(DATETIME[3],12,HOURSTRINGTEMP) DTOS(HOURSTRINGTEMP,HOURSTRING) MOVE(PM,AMPM) ,LE(DATETIME[3],12) DTOS(DATETIME[3],HOURSTRING) MOVE(AM,AMPM) ,GT(DATETIME[4],9) DTOS(DATETIME[4],MINSTRING) ,LE(DATETIME[4],9) DTOS(DATETIME[4],MINSTRINGTEMP) CONCAT(ZERO,MINSTRINGTEMP,MINSTRING) ] ,CONCAT(MONTHSTRING,SLASH,DATETIMESTRING) CONCAT(DATETIMESTRING,DAYSTRING,DATETIMESTRING) CONCAT(DATETIMESTRING,SLASH,DATETIMESTRING) CONCAT(DATETIMESTRING,YEARSTRING,DATETIMESTRING) ,CONCAT(DATETIMESTRING,SPACE,DATETIMESTRING) CONCAT(DATETIMESTRING,HOURSTRING,DATETIMESTRING) CONCAT(DATETIMESTRING,COLAN,DATETIMESTRING) CONCAT(DATETIMESTRING,MINSTRING,DATETIMESTRING) CONCAT(DATETIMESTRING,SPACE,DATETIMESTRING) CONCAT(DATETIMESTRING,AMPM,DATETIMESTRING) ];]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[Day of the Week

This instruction takes a given Date and returns the Day of the Week
  (0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat)

The given date is assumed valid (exists on the common Gregorian
calendar) -- it won't warn you if you input, say, February 30th!

NOTE:  This instruction does NOT switch to Julian dates for dates
before 1582 (or 1753 or whenever your place of interest switched
to the Gregorian Calendar (see Wikipedia on Gregorian Calendar
for details)!  This instruction assumes the Gregorian Calendar extends
"indefinitely" (at least 5.8 million years) either side of "zero"!  It DOES
handle the Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a
valid date, but Feb. 29, 2100 is not.

TIP: if you leave off the "+2) MOD 7" on the last CPT, you can use
the resulting value as a "sequential day number" for calculating the
number of days between two dates.

============================================================
CALCULATE THE DAY OF THE WEEK
============================================================
This version of the day of the week is based on:

http://alcor.concordia.ca/~gpkatch/gdate-algorithm.html

(NOTE:  ALL divisions are INTEGER -- truncated -- divisions!  So this method is FAST!)
F = ( month + 9 ) MOD 12
G = year - ( F / 10 )
Gregorian DayNumber [ D ] = ( 365 * G ) + ( G / 4 ) - ( G / 100 ) + ( G / 400 ) + ( ( ( F * 306 ) + 5 ) / 10 ) + day - 1
DayOfWeek = ( DayNumber + 3 ) MOD 7
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
This rung calculates the "G" and "F" functions shown in the algorithm above.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~]]></Comment><Text><![CDATA[CPT(Wrk_F,(MONTH+9)MOD 12)CPT(Wrk_G,YEAR-(Wrk_F/10));]]></Text></Rung><Rung Number="4" Type="N"><Comment><![CDATA[~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
This rung calculates the remainder of the algorithm.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
The "Day Number" is calculated, and the MOD 7
(remainder after division by 7) is stored as the Day of the Week.

NOTE:  The "+2" offset aligns Out_DayOfWeek as:
0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat]]></Comment><Text><![CDATA[CPT(DAYOFWEEK,(365*Wrk_G+(Wrk_G/4)-(Wrk_G/100)+(Wrk_G/400)+((Wrk_F*306+5)/10)+DAY+2)MOD 7);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
