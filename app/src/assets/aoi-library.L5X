<AddOnInstructionDefinition Name="DayOfWeek_LD" Class="Standard" Revision="1.0" RevisionExtension="00 Release" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2010-12-23T03:12:07.685Z" CreatedBy="Not Available" EditedDate="2024-03-14T16:45:44.692Z" EditedBy="KNOBELSDORFF\Jeremy.Noble" SoftwareRevision="v33.00"><Description><![CDATA[Day of the Week]]></Description><RevisionNote><![CDATA[Ladder Diagram (LD) implementation to determine Day of the Week given Date (year, month, day of the month)]]></RevisionNote><AdditionalHelpText><![CDATA[Day of the Week
 
 This instruction takes a given Date and returns the Day of the Week
 (0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat)
 
 The given date is assumed valid (exists on the common Gregorian
 calendar) -- it won't warn you if you input, say, February 30th!
 
 NOTE: This instruction does NOT switch to Julian dates for dates
 before 1582 (or 1753 or whenever your place of interest switched
 to the Gregorian Calendar (see Wikipedia on Gregorian Calendar
 for details)! This instruction assumes the Gregorian Calendar extends
 "indefinitely" (at least 5.8 million years) either side of "zero"! It DOES
 handle the Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a
 valid date, but Feb. 29, 2100 is not.
 
 TIP: if you leave off the "+2) MOD 7" on the last CPT, you can use
 the resulting value as a "sequential day number" for calculating the
 number of days between two dates.]]></AdditionalHelpText><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="Inp_Year" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[Calendar Year]]></Description><DefaultData Format="L5K"><![CDATA[2010]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="2010" /></DefaultData></Parameter><Parameter Name="Inp_Month" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[Calendar Month]]></Description><DefaultData Format="L5K"><![CDATA[1]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="1" /></DefaultData></Parameter><Parameter Name="Inp_Day" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[Calendar Day of the Montrh]]></Description><DefaultData Format="L5K"><![CDATA[1]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="1" /></DefaultData></Parameter><Parameter Name="Out_DayOfWeek" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Calculated Day of the Week 0=Sun, 1=Mon, ..., 6=Sat]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Wrk_G" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Intermediate value, function of Year and Wrk_F]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Wrk_F" DataType="DINT" Radix="Decimal" ExternalAccess="Read/Write"><Description><![CDATA[Intermediate value, function of Month]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><Description><![CDATA[Calculate the day of the week given the date]]></Description><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[Day of the Week
 
 This instruction takes a given Date and returns the Day of the Week
 (0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat)
 
 The given date is assumed valid (exists on the common Gregorian
 calendar) -- it won't warn you if you input, say, February 30th!
 
 NOTE: This instruction does NOT switch to Julian dates for dates
 before 1582 (or 1753 or whenever your place of interest switched
 to the Gregorian Calendar (see Wikipedia on Gregorian Calendar
 for details)! This instruction assumes the Gregorian Calendar extends
 "indefinitely" (at least 5.8 million years) either side of "zero"! It DOES
 handle the Gregorian 4 / 100 / 400 year rules, so Feb. 29, 2000 is a
 valid date, but Feb. 29, 2100 is not.
 
 TIP: if you leave off the "+2) MOD 7" on the last CPT, you can use
 the resulting value as a "sequential day number" for calculating the
 number of days between two dates.
 
 ============================================================
 CALCULATE THE DAY OF THE WEEK
 ============================================================
 This version of the day of the week is based on:
 
 http://alcor.concordia.ca/~gpkatch/gdate-algorithm.html
 
 (NOTE: ALL divisions are INTEGER -- truncated -- divisions! So this method is FAST!)
 F = ( month + 9 ) MOD 12
 G = year - ( F / 10 )
 Gregorian DayNumber [ D ] = ( 365 * G ) + ( G / 4 ) - ( G / 100 ) + ( G / 400 ) + ( ( ( F * 306 ) + 5 ) / 10 ) + day - 1
 DayOfWeek = ( DayNumber + 3 ) MOD 7
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 This rung calculates the "G" and "F" functions shown in the algorithm above.
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~]]></Comment><Text><![CDATA[CPT(Wrk_F,(Inp_Month+9)MOD 12)CPT(Wrk_G,Inp_Year-(Wrk_F/10));]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 This rung calculates the remainder of the algorithm.
 ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
 The "Day Number" is calculated, and the MOD 7
 (remainder after division by 7) is stored as the Day of the Week.
 
 NOTE: The "+2" offset aligns Out_DayOfWeek as:
 0=Sun, 1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat]]></Comment><Text><![CDATA[CPT(Out_DayOfWeek,(365*Wrk_G+(Wrk_G/4)-(Wrk_G/100)+(Wrk_G/400)+((Wrk_F*306+5)/10)+Inp_Day+2)MOD 7);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="DI6xxx_8PORT_IOL" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2022-05-13T19:57:08.674Z" CreatedBy="IFM\ifmengineer" EditedDate="2025-07-31T19:00:40.521Z" EditedBy="INTRAIFM\ustranho" SoftwareRevision="v35.00"><RevisionNote><![CDATA[Replaces LDLxxx_nP_IOL]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[Reference the Input Controller tag <IOLinkMasterName>:I1.Data]]></Description></Parameter><Parameter Name="Port_Process_Data_Size" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value from the Configuration Controller tag <IOLinkMasterName>:C.Port_Process_Data_Size]]></Description><DefaultData Format="L5K"><![CDATA[4]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="4" /></DefaultData></Parameter><Parameter Name="Port_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value = Port number of the IO-Link Master]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Vendor_ID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value indicating the manufacturer of the IO-Link Device. ifm=310 dec]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_ID" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value set by the manufacturer of the device. Varies by product family]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Port is configured for IO-Link Communication. False: Port is not configured for IO-Link Communication]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_Not_Connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: No IO-Link Device is connected
False: IO-Link Device is connected]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Invalid_Data" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Data is invalid False: IO-Link Data is valid]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Wrong_VID_DID" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Vendor ID and/or Device ID does not match the configured VID or DID set in Configuration Controller Tag(s) <IOLink MasterName>:C.Vendor_ID_Port_n or ...C.Device_ID_Port_n]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Diagnostic_Avail" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Event data is available False: No Event data is present]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="AOI_Settings_Error" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[A user input is out of range. Check port process data size and port number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Revolution" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Current conductivity value in µS/cm]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Device_OK" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Maintenance_required" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Out_Of_Specification" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Device temperature under/over-run Process variable range under/over-run]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Functional_check" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Measurement range over-run, simulation mode active, component malfunction]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Failure" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="SSC1" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="SSC2" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Device_Status" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Current device status]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Data_Size" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Factor of the RealPort_Num to calcualated the Offset_Address]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_Address" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Data_Size*RealPort_Number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_StatusFlgs" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[RealPort_Num+9]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="RealPort_Num" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of the Port_Number-1]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Process_Offset" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_Address+95(8port Master) or Offset_Address+59(4port Master). Used to indicate the word offset for where the IO-Link device’s process input data starts]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="StatusFlgs_Offset" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_StatusFlgs+23]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Revolution_DINT" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Units1" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Device ID: 921, 922]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Unknown_DID" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[An unknown Device ID was detected.Set as Units1 device]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Gradient" DataType="REAL" Radix="Float" ExternalAccess="None"><Description><![CDATA[Factor of the Raw Value]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[Calculate Data_Size depending on Port_Process_Data_Size input by the user]]></Comment><Text><![CDATA[[EQ(Port_Process_Data_Size,0) MOVE(1,Data_Size) ,EQ(Port_Process_Data_Size,1) MOVE(2,Data_Size) ,EQ(Port_Process_Data_Size,2) MOVE(4,Data_Size) ,EQ(Port_Process_Data_Size,3) MOVE(8,Data_Size) ,EQ(Port_Process_Data_Size,4) MOVE(16,Data_Size) ];]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[If the user input Port_Number <= to the maximum number of ports on the IO-Link master (4 or 8) and the Port_Number != to 0 then 
calculate the Process_Offset  (if process input data is produced by the IO-Link Device) and/or calculate the Process_Value_Offset (if process output data is consumed by the IO-Link Device). 
Parallel to the Calculation of the Process_Offset and/or Process_Value_Offset calculate the value of the StatusFlgs_Offset
]]></Comment><Text><![CDATA[LE(Port_Number,8)GT(Port_Number,0)SUB(Port_Number,1,RealPort_Num)[MUL(Data_Size,RealPort_Num,Offset_Address) ADD(Offset_Address,95,Process_Offset) ,MUL(9,RealPort_Num,Offset_StatusFlgs) ADD(Offset_StatusFlgs,23,StatusFlgs_Offset) ];]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[Sets states of IOL_Mode, Device_Not_Connected, Invalid_Data, Wrong_VID_DID and Diagnostic Available and set the values for the Vendor ID and Device ID from the Controller input tags of the user input Port_Number
]]></Comment><Text><![CDATA[[XIC(PLC_Input[StatusFlgs_Offset].0) OTE(IOL_Mode) ,XIC(PLC_Input[StatusFlgs_Offset].1) OTE(Device_Not_Connected) ,XIC(PLC_Input[StatusFlgs_Offset].2) OTE(Invalid_Data) ,XIC(PLC_Input[StatusFlgs_Offset].3) OTE(Wrong_VID_DID) ,XIC(PLC_Input[StatusFlgs_Offset].7) OTE(Diagnostic_Avail) ,MOVE(PLC_Input[StatusFlgs_Offset+1],Vendor_ID) ,COP(PLC_Input[StatusFlgs_Offset+2],Device_ID,1) ];]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[Set the State of AOI_Setting_Error by verifying the user input setting of Port_Number and Port_Process_Data_Size is within range of the IO-Link Master. GRT instruction for Port_Number compares to value=8 for 8 port masters and =4 for 4 port masters]]></Comment><Text><![CDATA[[LE(Port_Number,0) ,GT(Port_Number,8) ,LT(Port_Process_Data_Size,0) ,GT(Port_Process_Data_Size,4) ]OTE(AOI_Settings_Error);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[EQ(Device_ID,1444) OTE(Units1) ,XIC(Unknown_DID) ]MOVE(0.1,Gradient);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIO(Units1)OTE(Unknown_DID);]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[[BTD(PLC_Input[Process_Offset],0,Revolution_DINT,16,16) ,BTD(PLC_Input[Process_Offset+1],0,Revolution_DINT,0,16) ]MUL(Revolution_DINT,Gradient,Revolution);]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[[XIC(PLC_Input[Process_Offset+2].0) OTE(SSC1) ,XIC(PLC_Input[Process_Offset+2].1) OTE(SSC2) ];]]></Text></Rung><Rung Number="8" Type="N"><Comment><![CDATA[Device Status byte is converted to binary outputs]]></Comment><Text><![CDATA[BTD(PLC_Input[Process_Offset+5],4,Device_Status,0,4)[EQ(Device_Status,0) OTE(Device_OK) ,EQ(Device_Status,1) OTE(Maintenance_required) ,EQ(Device_Status,2) OTE(Out_Of_Specification) ,EQ(Device_Status,3) OTE(Functional_check) ,EQ(Device_Status,4) OTE(Failure) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
