]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[MOVE(Scale.Plc.i_ScaleWeight,Scale.Plc.o_ScaleWeight);]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[Initialize
 Set StepNo to 1000 (Passive)
 
]]></Comment><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,0)MOVE(1000,Scale.HMI_Read.StepNo);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[XIC(Scale.HMI_Write.CmdPause)OTL(Scale.Plc.o_FeedHold);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[XIC(Scale.HMI_Write.CmdFaultReset)OTU(Scale.HMI_Read.AlmDosingMonitor);]]></Text></Rung><Rung Number="5" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
