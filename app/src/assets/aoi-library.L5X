ultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="FORCEONS" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[[XIC(ID.FORCEOFF) OTE(FORCED_OFF) ,XIC(ID.FORCEON) OTE(FORCED_ON) ,MOVE(ID.OFFACC,OFFACC) MOVE(ID.ONACC,ONACC) ];]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIC(Motion_IO_Trigger)MOVE(ID.PAR.MotionDelaytoWatch,DELAYTOWATCH.PRE)TON(DELAYTOWATCH,?,?);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[[XIO(ID.PAR.UseForMotion) [XIC(ID.PAR.FAILSAFE) XIO(ID.SWITCH_I_O) ,XIO(ID.PAR.FAILSAFE) XIC(ID.SWITCH_I_O) ] ,XIC(ID.PAR.UseForMotion) XIC(DELAYTOWATCH.DN) XIO(ID.SWITCH_I_O) ]OTE(DEVICE_TRIGGERED);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[XIC(ID.PAR.UseForMotion)OTU(ID.FORCEOFF);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[XIC(ID.FORCEOFF) ONS(FORCEONS) OTU(ID.FORCEON) ,XIC(ID.FORCEON) ONS(FORCEONS1) OTU(ID.FORCEOFF) ];]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[[[XIC(DEVICE_TRIGGERED) ,XIC(ID.FORCEON) ] XIO(ID.FORCEOFF) [XIO(ID.PAR.UseForMotion) ,XIC(ID.PAR.UseForMotion) XIO(ID.FORCEON) ] [OTE(ID.SWITCH_INPUT) ,TON(ONDELAY,?,?) ] ,[XIC(ONDELAY.DN) EQ(OFFDELAY.ACC,0) OTE(DNLATCH) ,XIC(DNLATCH) TOF(OFFDELAY,?,?) ,GE(OFFDELAY.ACC,OFFDELAY.PRE) RES(OFFDELAY) ,XIC(OFFDELAY.TT) XIC(ONDELAY.DN) RES(OFFDELAY) ] ];]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[XIO(ID.PAR.UseForMotion)[XIO(ID.SWITCH_INPUT) MOVE(0,ID.SWITCH_STATE_FOR_HMI) ,XIC(ID.SWITCH_INPUT) XIC(ONDELAY.TT) XIO(OFFDELAY.TT) MOVE(1,ID.SWITCH_STATE_FOR_HMI) ,XIO(ID.SWITCH_INPUT) XIC(OFFDELAY.TT) MOVE(3,ID.SWITCH_STATE_FOR_HMI) ,XIC(ID.SWITCH_INPUT) [XIC(ONDELAY.DN) XIO(OFFDELAY.TT) ,XIC(ONDELAY.TT) XIC(OFFDELAY.TT) ] [MOVE(2,ID.SWITCH_STATE_FOR_HMI) ,ONS(STAMPONS) DATE_TIME_STAMP(DTSTAMP,ID.DTSTAMPSTRING) ] ];]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[XIC(ID.PAR.UseForMotion)[XIO(ID.SWITCH_INPUT) MOVE(0,ID.SWITCH_STATE_FOR_HMI) ,XIC(ID.SWITCH_INPUT) XIC(ONDELAY.TT) XIO(OFFDELAY.TT) MOVE(1,ID.SWITCH_STATE_FOR_HMI) ,XIO(ID.SWITCH_INPUT) XIC(OFFDELAY.TT) MOVE(3,ID.SWITCH_STATE_FOR_HMI) ,XIC(ID.SWITCH_INPUT) [XIC(ONDELAY.DN) XIO(OFFDELAY.TT) ,XIC(ONDELAY.TT) XIC(OFFDELAY.TT) ] [MOVE(2,ID.SWITCH_STATE_FOR_HMI) ,ONS(STAMPONS) DATE_TIME_STAMP(DTSTAMP,ID.DTSTAMPSTRING) ] ];]]></Text></Rung><Rung Number="8" Type="N"><Text><![CDATA[LT(ID.SWITCH_STATE_FOR_HMI,2)OTE(ID.BIN_NO_FULL_AVAILABLE);]]></Text></Rung><Rung Number="9" Type="N"><Text><![CDATA[MOVE(ID.PAR.DelayFalse,OFFDELAY.PRE)MOVE(ID.PAR.DelayTrue,ONDELAY.PRE);]]></Text></Rung><Rung Number="10" Type="N"><Text><![CDATA[[XIC(ONDELAY.DN) ,XIC(ID.ALARM_FOR_WW) XIO(ALARM_CLEAR_FROM_WW) [NE(OFFDELAY.ACC,OFFDELAY.PRE) ,XIC(ID.PAR.UseForMotion) ] ][XIC(ID.PAR.AudiableAlarmNeeded) XIO(ALARM_SILENCE) OTE(ALARM_HORN) ,XIC(ID.PAR.VisualAlarmNeeded) OTE(ID.ALARM_FOR_WW) ,[XIC(ALARM_SILENCE_FROM_WW) ,XIC(ALARM_SILENCE) ] OTE(ALARM_SILENCE) ];]]></Text></Rung><Rung Number="11" Type="N"><Text><![CDATA[[XIC(ONDELAY.EN) OTE(ID.ONDELAYEN) ,XIC(ONDELAY.TT) OTE(ID.ONDELAYTT) ,XIC(ONDELAY.DN) OTE(ID.ONDELAYDN) ,XIC(OFFDELAY.EN) OTE(ID.OFFDELAYEN) ,XIC(OFFDELAY.TT) OTE(ID.OFFDELAYTT) ,XIC(OFFDELAY.DN) OTE(ID.OFFDELAYDN) ,MOVE(ONDELAY.ACC,ID.ONACC) MOVE(OFFDELAY.ACC,ID.OFFACC) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SCP" Class="Standard" Revision="1.2" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2007-02-02T20:31:08.937Z" CreatedBy="Not Available" EditedDate="2007-02-13T14:38:40.692Z" EditedBy="Not Available" SoftwareRevision="v16.00"><Description><![CDATA[Scale w/Parameters]]></Description><AdditionalHelpText><![CDATA[Use this instruction to scale data from your analog module and bring it into the limits prescribed by the process variable or another analog module. 
Equations used in calculating a linear relationship: 

Scaled value = (input value - input min.) x rate + scaled minimum 
Rate = (scaled max. - scaled min.) / (input max. - input min.) 


]]></AdditionalHelpText><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="Input" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Input_Min" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Input_Max" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Scaled_Min" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Scaled_Max" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0.