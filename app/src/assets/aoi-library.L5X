 ----------------------------------------------------------------------------------------------------
 
 on first scan - complete clean timer.
 ----------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="14" Type="N"><Text><![CDATA[[XIC(i_FirstScan) ,XIC(i_ClearProduct) ]OTL(CleanOutTimer.DN);]]></Text></Rung><Rung Number="15" Type="N"><Text><![CDATA[[XIC(i_Feed) ,XIO(CleanOutTimer.DN) ]OTE(o_Dirty);]]></Text></Rung><Rung Number="16" Type="N"><Text><![CDATA[[XIC(o_Dirty) [XIC(o_StRunningFwd) ,XIC(o_StRunningRev) ] ,XIC(CleanOutTimer.DN) ]XIO(i_Feed)TON(CleanOutTimer,?,?);]]></Text></Rung><Rung Number="17" Type="N"><Text><![CDATA[[XIC(o_Dirty) CPT(o_CleanoutTimeRemaining,(CleanOutTimer.PRE - CleanOutTimer.ACC)/1000) ,XIO(o_Dirty) MOVE(0,o_CleanoutTimeRemaining) ];]]></Text></Rung><Rung Number="18" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
