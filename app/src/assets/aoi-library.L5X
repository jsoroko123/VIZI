mensions="3" Radix="Decimal"><Element Index="[0]" Value="0" /><Element Index="[1]" Value="0" /><Element Index="[2]" Value="0" /></Array></DefaultData></LocalTag><LocalTag Name="ControllerFaultTimer" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,500,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="500" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[|==================================================|
 Simulation Control
 |==================================================|]]></Comment><Text><![CDATA[XIC(i_SimulateEnabled)OTE(o_Simulated)MOVE(o_Request,PositionInputSim);]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[|==================================================|
 Mode Control
 |==================================================|]]></Comment><Text><![CDATA[XIO(Disabled)XIC(HMI_ModeStatus.4)OTL(HMI_Control.2)OTU(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[XIC(HMI_Control.0)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3)OTL(HMI_ModeStatus.0);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[XIC(HMI_Control.1)OTU(HMI_ModeStatus.0)OTL(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[XIC(HMI_Control.2)OTU(HMI_ModeStatus.0)OTU(HMI_ModeStatus.1)OTL(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIC(HMI_Control.3)OTU(HMI_ModeStatus.0)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTL(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="6" Type="N"><Comment><![CDATA[|==================================================|
 Disable Push Button
 Flip/Flop
 |==================================================|]]></Comment><Text><![CDATA[[[XIC(HMI_Control.10) OTL(Disabled) ,XIC(HMI_Control.10) XIC(Disable_FlipFlop) OTU(Disabled) ] ,XIO(HMI_Control.10) XIC(Disabled) OTE(Disable_FlipFlop) ];]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[XIC(Disabled)OTE(o_Disabled)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3)OTL(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="8" Type="N"><Comment><![CDATA[|==================================================|
 Equipment ID
 |==================================================|]]></Comment><Text><![CDATA[NE(i_RouteID,0)OTE(o_Owned);]]></Text></Rung><Rung Number="9" Type="N"><Comment><![CDATA[|==================================================|
 Equipment cleanout
 on first scan - complete clean timer.
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="10" Type="N"><Text><![CDATA[MUL(i_DirtyDelayTimerPre,1000,DirtyDelay.PRE)[XIC(i_Feed) ,XIO(Cleanout.DN) ]TON(DirtyDelay,?,?)XIC(DirtyDelay.DN)OTE(o_Dirty);]]></Text></Rung><Rung Number="11" Type="N"><Text><![CDATA[MUL(i_CleanoutTimerPre,1000,Cleanout.PRE)[[XIC(o_Dirty) ,XIC(Cleanout.DN) ] XIO(i_Feed) ,XIC(i_FirstScan) MOVE(Cleanout.PRE,Cleanout.ACC) ]TON(Cleanout,?,?);]]></Text></Rung><Rung Number="12" Type="N"><Comment><![CDATA[|==================================================|
 Local Control
 
 In Maintenance Mode
 Control Of The Distributor Is Moved From The PLC To 
 The Local VGC Controller
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="13" Type="N"><Text><![CDATA[XIC(HMI_ModeStatus.3)OTE(o_InLocal)MOVE(0,o_Position);]]></Text></Rung><Rung Number="14" Type="N"><Comment><![CDATA[|==================================================|
 Position Control
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="15" Type="N"><Comment><![CDATA[Move Command From
