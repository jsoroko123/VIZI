 ----------------------------------------------------------------------------------------------------
Do CutOff Weight Correction if CutOffWtMaxCorrection Is Not 0
 
]]></Comment><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,5000)[[[EQ(Scale.BinList[Scale.Plc.IndexBin].SettlingTime,0) MOVE(Scale.Plc.ParSettlingTime,Scale.Plc.SettlingTimer.PRE) ,GT(Scale.BinList[Scale.Plc.IndexBin].SettlingTime,0) MOVE(Scale.BinList[Scale.Plc.IndexBin].SettlingTime,Scale.Plc.SettlingTimer.PRE) ] ,TON(Scale.Plc.SettlingTimer,?,?) ] ,XIO(Scale.Plc.Ingredient.WtToleranceLbs) [CPT(IngrTestWtUnder,Scale.Plc.o_IngrTargetWeight - (Scale.Plc.o_IngrTargetWeight * Scale.Plc.Ingredient.UnderWtTolerance * 0.01)) ,CPT(IngrTestWtOver,Scale.Plc.o_IngrTargetWeight + (Scale.Plc.o_IngrTargetWeight * Scale.Plc.Ingredient.OverWtTolerance * 0.01)) ] ,XIC(Scale.Plc.Ingredient.WtToleranceLbs) [CPT(IngrTestWtUnder,Scale.Plc.o_IngrTargetWeight - Scale.Plc.Ingredient.UnderWtTolerance) ,CPT(IngrTestWtOver,Scale.Plc.o_IngrTargetWeight + Scale.Plc.Ingredient.OverWtTolerance) ] ,XIO(Scale.BinList[Scale.Plc.IndexBin].FixedFreefall) [MOVE(Scale.Plc.Ingredient.CutOffWtMaxCorrection,CutOffWtMaxCorrectionPos) MUL(Scale.Plc.Ingredient.CutOffWtMaxCorrection,-1.0,CutOffWtMaxCorrectionNeq) SUB(Scale.Plc.o_IngrTargetWeight,Scale.Plc.o_IngrActualWeight,CutOffWtCorrection) ,LT(CutOffWtCorrection,CutOffWtMaxCorrectionNeq) MOVE(CutOffWtMaxCorrectionNeq,CutOffWtCorrection) ,GT(CutOffWtCorrection,CutOffWtMaxCorrectionPos) MOVE(CutOffWtMaxCorrectionPos,CutOffWtCorrection) ] ,XIC(Scale.Plc.SettlingTimer.DN) [XIO(Scale.Plc.o_IntermediateEmptyingFlag) XIO(Scale.Plc.o_ModifyBinFlag) [XIO(Scale.Plc.o_CutOffWtCalculated) XIO(Scale.Plc.o_AbortedIngredientFlag) XIO(Scale.BinList[Scale.Plc.IndexBin].FixedFreefall) GT(Scale.Plc.Ingredient.CutOffWtMaxCorrection,0) SUB(Scale.BinList[Scale.Plc.IndexBin].CutOffWt,CutOffWtCorrection,Scale.BinList[Scale.Plc.IndexBin].CutOffWt) OTL(Scale.Plc.o_CutOffWtCalculated) ,XIO(Scale.BinList[Scale.Plc.IndexBin].FixedFreefall) GT(Scale.Plc.Ingredient.CutOffWtMaxCorrection,0) GE(Scale.BinList[Scale.Plc.IndexBin].CutOffWt,Scale.BinList[Scale.Plc.IndexBin].MaxFreeFallLimit) GT(Scale.BinList[Scale.Plc.IndexBin].MaxFreeFallLimit,0) MOVE(Scale.BinList[Scale.Plc.IndexBin].MaxFreeFallLimit,Scale.BinList[Scale.Plc.IndexBin].CutOffWt) ,XIO(Scale.BinList[Scale.Plc.IndexBin].FixedFreefall) LT(Scale.BinList[Scale.Plc.IndexBin].CutOffWt,0) MOVE(0,Scale.BinList[Scale.Plc.IndexBin].CutOffWt) ,SUB(Scale.Plc.o_IngrTargetWeight,Scale.BinList[Scale.Plc.IndexBin].LowToleranceWarn_Ref,ScaleWarnTestLo) LT(Scale.Plc.o_IngrActualWeight,ScaleWarnTestLo) XIO(Scale.Plc.o_AbortedIngredientFlag) OTE(Scale.BinList[Scale.Plc.IndexBin].o_LowToleranceWarn) ,ADD(Scale.Plc.o_IngrTargetWeight,Scale.BinList[Scale.Plc.IndexBin].HiToleranceWarn_Ref,ScaleWarnTestHi) GT(Scale.Plc.o_IngrActualWeight,ScaleWarnTestHi) XIO(Scale.Plc.o_AbortedIngredientFlag) OTE(Scale.BinList[Scale.Plc.IndexBin].o_HiToleranceWarn) ,[LIMIT(IngrTestWtUnder,Scale.Plc.o_IngrActualWeight,IngrTestWtOver) ,XIC(Scale.Plc.o_AbortedIngredientFlag) ] MOVE(5100,Scale.HMI_Read.StepNo) ,LT(Scale.Plc.o_IngrActualWeight,IngrTestWtUnder) XIO(Scale.Plc.o_AbortedIngredientFlag) [LT(Scale.Plc.o_JogCount,Scale.Plc.Ingredient.MaxJogNo) MOVE(4300,Scale.HMI_Read.StepNo) ,GE(Scale.Plc.o_JogCount,Scale.Plc.Ingredient.MaxJogNo) [GT(Scale.Plc.Ingredient.MaxJogNo,0) OTE(Scale.HMI_Read.AlmJogNoExceeded) ,OTE(Scale.HMI_Read.AlmUnderWt) ] ] ,GT(Scale.Plc.o_IngrActualWeight,IngrTestWtOver) XIO(Scale.Plc.o_AbortedIngredientFlag) OTE(Scale.HMI_Read.AlmOverWt) ,[XIC(Scale.HMI_Read.AlmJogNoExceeded) ,XIC(Scale.HMI_Read.AlmUnderWt) ] XIC(Scale.HMI_Write.CmdFaultReset) CLR(Scale.Plc.o_JogCount) MOVE(4300,Scale.HMI_Read.StepNo) ,[XIC(Scale.HMI_Read.AlmJogNoExceeded) ,XIC(Scale.HMI_Read.AlmUnderWt) ,XIC(Scale.HMI_Read.AlmOverWt) ] XIC(Scale.HMI_Write.CmdAcceptWt) MOVE(5100,Scale.HMI_Read.StepNo) ] ,[XIC(Scale.Plc.o_IntermediateEmptyingFlag) ,XIC(Scale.Plc.o_ModifyBinFlag) ] MOVE(5100,Scale.HMI_Read.StepNo) ] ];]]></Text></Rung><Rung Number="31" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 StepNo 5100 (Log Ingredient Weight)
 ----------------------------------------------------------------------------------------------------
  
Once logged, advance recipe pointer to next ingredient
 If next ingredient is 0, advance to Emptying
 
]]></Comment><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,5100)XIO(Scale.Plc.o_IntermediateEmptyingFlag)XIO(Scale.Plc.o_ModifyBinFlag)[MOVE(Scale.Plc.o_IngrTargetWeight,Scale.Plc.Ingredient.o_TargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.Plc.Ingredient.o_ActualWeight) ,MOVE(Scale.Plc.o_IngrTargetWeight,Scale.BinList[Scale.Plc.IndexBin].o_TargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.BinList[Scale.Plc.IndexBin].o_ActualWeight) ,OTL(Scale.HMI_Read.Hsk_RegisterBinReq) ,XIC(Scale.HMI_Read.Hsk_RegisterBinReq) XIC(Scale.HMI_Write.Hsk_RegisterBinDone) [XIO(Scale.Plc.o_SingleIngrModeOn) [OTU(Scale.HMI_Read.Hsk_RegisterBinReq) OTU(Scale.HMI_Write.Hsk_RegisterBinDone) ,OTU(Scale.Plc.o_AbortedIngredientFlag) ,ADD(tmp_IndexIngr,1,tmp_IndexIngr) MOVE(0,tmp_IndexBin) ,XIO(Scale.Plc.o_AbortedBatchFlag) NE(Scale.Recipe.Ingr[tmp_IndexIngr].BinNo,0) MOVE(5200,Scale.HMI_Read.StepNo) ,[EQ(Scale.Recipe.Ingr[tmp_IndexIngr].BinNo,0) ,XIC(Scale.Plc.o_AbortedBatchFlag) ] MOVE(6000,Scale.HMI_Read.StepNo) ,ADD(Scale.Plc.o_BatchActualWeight,Scale.Plc.o_IngrActualWeight,Scale.Plc.o_BatchActualWeight) ] ,XIC(Scale.Plc.o_SingleIngrModeOn) [OTU(Scale.HMI_Read.Hsk_RegisterBinReq) OTU(Scale.HMI_Write.Hsk_RegisterBinDone) ,OTU(Scale.Plc.o_AbortedIngredientFlag) ,MOVE(8000,Scale.HMI_Read.StepNo) ,XIC(SingleIngrEndEmptying) ADD(Scale.Plc.o_BatchActualWeight,Scale.Plc.o_IngrActualWeight,Scale.Plc.o_BatchActualWeight) ] ] ];]]></Text></Rung><Rung Number="32" Type="N"><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,5100)XIC(Scale.Plc.o_IntermediateEmptyingFlag)[MOVE(Scale.Plc.o_IngrTargetWeight,Scale.Plc.Ingredient.o_TargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.Plc.Ingredient.o_ActualWeight) ,MOVE(Scale.Plc.o_IngrTargetWeight,Scale.BinList[Scale.Plc.IndexBin].o_TargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.BinList[Scale.Plc.IndexBin].o_ActualWeight) ,OTL(Scale.HMI_Read.Hsk_RegisterBinReq) ,XIC(Scale.HMI_Read.Hsk_RegisterBinReq) XIC(Scale.HMI_Write.Hsk_RegisterBinDone) [OTU(Scale.HMI_Read.Hsk_RegisterBinReq) OTU(Scale.HMI_Write.Hsk_RegisterBinDone) ,OTU(Scale.Plc.o_AbortedIngredientFlag) ,XIO(Scale.Plc.o_AbortedBatchFlag) MOVE(6100,Scale.HMI_Read.StepNo) ,XIC(Scale.Plc.o_AbortedBatchFlag) MOVE(6000,Scale.HMI_Read.StepNo) ,SUB(Scale.Plc.o_IngrTargetWeight,Scale.Plc.o_IngrActualWeight,Scale.Plc.o_IngrTargetWeight) ,ADD(Scale.Plc.o_BatchActualWeight,Scale.Plc.o_IngrActualWeight,Scale.Plc.o_BatchActualWeight) ,CLR(Scale.Plc.o_IngrActualWeight) ] ];]]></Text></Rung><Rung Number="33" Type="N"><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,5100)XIC(Scale.Plc.o_ModifyBinFlag)[MOVE(Scale.Plc.o_IngrTargetWeight,Scale.Plc.Ingredient.o_TargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.Plc.Ingredient.o_ActualWeight) ,MOVE(Scale.Plc.o_IngrTargetWeight,Scale.BinList[Scale.Plc.IndexBin].o_TargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.BinList[Scale.Plc.IndexBin].o_ActualWeight) ,OTL(Scale.HMI_Read.Hsk_RegisterBinReq) ,XIC(Scale.HMI_Read.Hsk_RegisterBinReq) XIC(Scale.HMI_Write.Hsk_RegisterBinDone) [OTU(Scale.HMI_Read.Hsk_RegisterBinReq) OTU(Scale.HMI_Write.Hsk_RegisterBinDone) ,OTU(Scale.Plc.o_AbortedIngredientFlag) ,XIO(Scale.Plc.o_AbortedBatchFlag) MOVE(5200,Scale.HMI_Read.StepNo) ,XIC(Scale.Plc.o_AbortedBatchFlag) MOVE(6000,Scale.HMI_Read.StepNo) ,[XIO(Scale.Plc.o_ModifyBinMultiFlag) SUB(Scale.Plc.o_IngrTargetWeight,Scale.Plc.o_IngrActualWeight,Scale.Plc.o_IngrTargetWeight) ,XIC(Scale.Plc.o_ModifyBinMultiFlag) [SUB(Scale.Plc.o_IngrTargetWeight,Scale.Plc.o_IngrActualWeight,tmp_IngrTargetWeight) ,CPT(Scale.Plc.o_IngrTargetWeight,(tmp_IngrTargetWeight) * Scale.Recipe.Substitute[0].TargetValue * 0.01) ] ] ,ADD(Scale.Plc.o_BatchActualWeight,Scale.Plc.o_IngrActualWeight,Scale.Plc.o_BatchActualWeight) ,CLR(Scale.Plc.o_IngrActualWeight) ,MOVE(Scale.Recipe.Substitute[0].BinNo,Scale.Recipe.Ingr[tmp_IndexIngr].BinNo) ,XIC(Scale.Plc.o_ModifyBinMultiFlag) [SUB(Scale.Plc.o_IngrCount,Scale.Plc.o_IngrNo,tmp_ArrayCopyLength) GT(tmp_ArrayCopyLength,0) [CPS(Scale.Recipe.Ingr[tmp_IndexIngr+1],tmp_RecipeArray[0],tmp_ArrayCopyLength) ,CPS(tmp_RecipeArray[0],Scale.Recipe.Ingr[tmp_IndexIngr+Scale.HMI_Write.ModifyIngrCount],tmp_ArrayCopyLength) ,CPS(tmp_RecipeArrayBlank[0],tmp_RecipeArray[0],30) ] ,GE(Scale.HMI_Write.ModifyIngrCount,2) [MOVE(Scale.Recipe.Substitute[1].BinNo,Scale.Recipe.Ingr[tmp_IndexIngr+1].BinNo) ,CPT(Scale.Recipe.Ingr[tmp_IndexIngr+1].TargetValue,(tmp_IngrTargetWeight) * Scale.Recipe.Substitute[1].TargetValue * 0.01) ] ,GE(Scale.HMI_Write.ModifyIngrCount,3) [MOVE(Scale.Recipe.Substitute[2].BinNo,Scale.Recipe.Ingr[tmp_IndexIngr+2].BinNo) ,CPT(Scale.Recipe.Ingr[tmp_IndexIngr+2].TargetValue,(tmp_IngrTargetWeight) * Scale.Recipe.Substitute[2].TargetValue * 0.01) ] ,GE(Scale.HMI_Write.ModifyIngrCount,4) [MOVE(Scale.Recipe.Substitute[3].BinNo,Scale.Recipe.Ingr[tmp_IndexIngr+3].BinNo) ,CPT(Scale.Recipe.Ingr[tmp_IndexIngr+3].TargetValue,(tmp_IngrTargetWeight) * Scale.Recipe.Substitute[3].TargetValue * 0.01) ] ,GE(Scale.HMI_Write.ModifyIngrCount,5) [MOVE(Scale.Recipe.Substitute[4].BinNo,Scale.Recipe.Ingr[tmp_IndexIngr+4].BinNo) ,CPT(Scale.Recipe.Ingr[tmp_IndexIngr+4].TargetValue,(tmp_IngrTargetWeight) * Scale.Recipe.Substitute[4].TargetValue * 0.01) ] ,CPT(Scale.Plc.o_IngrCount,Scale.Plc.o_IngrCount + Scale.HMI_Write.ModifyIngrCount - 1) ] ,OTU(Scale.Plc.o_FeedHold) ] ];]]></Text></Rung><Rung Number="34" Type="N"><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,5200)[MOVE(0,tmp_IndexBin) ,OTU(Scale.HMI_Read.AlmInvalidIngr) OTU(tmp_BinFoundFlag) ];]]></Text></Rung><Rung Number="35" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 StepNo 5200 (Next Ingredient)
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[LBL(Loop_Bin2)EQ(Scale.HMI_Read.StepNo,5200)[EQ(Scale.Recipe.Ingr[tmp_IndexIngr].BinNo,Scale.BinList[tmp_IndexBin].BinNo) [MOVE(Scale.Recipe.Ingr[tmp_IndexIngr].BinNo,Scale.Plc.o_IngrBinNo) MOVE(Scale.Recipe.Ingr[tmp_IndexIngr].BinNoSubstituted,Scale.Plc.o_IngrBinNoSubstituted) XIO(Scale.Plc.o_ModifyBinFlag) MOVE(Scale.Recipe.Ingr[tmp_IndexIngr].TargetValue,Scale.Plc.o_IngrTargetWeight) ,CPS(Scale.BinList[tmp_IndexBin],Scale.Plc.Ingredient,1) ,MOVE(tmp_IndexIngr,Scale.Plc.IndexIngr) MOVE(tmp_IndexBin,Scale.Plc.IndexBin) ,OTL(Scale.BinList[tmp_IndexBin].o_Active) MOVE(Scale.Plc.o_IngrTargetWeight,Scale.BinList[tmp_IndexBin].o_TargetWeight) ,CLR(Scale.BinList[tmp_IndexBin].o_ActualWeight) CLR(Scale.BinList[tmp_IndexBin].o_DosingSpeed) ,EQ(Scale.HMI_Read.BatchNo,Scale.HMI_Read.TargetBatchNo) XIC(Scale.Recipe.HoldBackFlush) EQ(Scale.Recipe.Ingr[tmp_IndexIngr].BinNo,Scale.Recipe.FlushIngr.BinNo) XIO(HoldBackFlushCalculated) [SUB(Scale.Plc.o_IngrTargetWeight,Scale.Recipe.FlushIngr.TargetValue,Scale.Plc.o_IngrTargetWeight) ,MOVE(Scale.Plc.o_IngrTargetWeight,Scale.BinList[tmp_IndexBin].o_TargetWeight) ,OTL(HoldBackFlushCalculated) ] ,OTL(tmp_BinFoundFlag) ] ,NE(Scale.Recipe.Ingr[tmp_IndexIngr].BinNo,Scale.BinList[tmp_IndexBin].BinNo) [OTU(Scale.BinList[tmp_IndexBin].o_Active) CLR(Scale.BinList[tmp_IndexBin].o_TargetWeight) ,CLR(Scale.BinList[tmp_IndexBin].o_ActualWeight) CLR(Scale.BinList[tmp_IndexBin].o_DosingSpeed) ] ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,Scale.Plc.ParBinCount) JMP(Loop_Bin2) ,XIC(tmp_BinFoundFlag) [XIO(Scale.Plc.o_RefillMode) MOVE(3000,Scale.HMI_Read.StepNo) ,XIC(Scale.Plc.o_RefillMode) MOVE(9000,Scale.HMI_Read.StepNo) ,XIC(Scale.Plc.o_ModifyBinFlag) OTU(Scale.Plc.o_ModifyBinFlag) OTU(Scale.Plc.o_ModifyBinMultiFlag) ] ,XIO(tmp_BinFoundFlag) OTL(Scale.HMI_Read.AlmInvalidIngr) ];]]></Text></Rung><Rung Number="36" Type="N"><Text><![CDATA[LBL(Loop_Bin2_End)NOP();]]></Text></Rung><Rung Number="37" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 StepNo 6000 (Emptying)
StepNo 6100 (Intermediate Emptying)
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[[EQ(Scale.HMI_Read.StepNo,6000) ,EQ(Scale.HMI_Read.StepNo,6100) ][ONS(EmptyingWeightOns1) MOVE(Scale.Plc.o_ScaleWeight,EmptyingWeightTare) ,MOVE(Scale.Plc.ParMaxEmptyingTime,Scale.Plc.EmptyingTimer.PRE) MOVE(Scale.Plc.ParClosingDelayTime,Scale.Plc.ClosingDelayTimer.PRE) ,XIC(Scale.Plc.ParNoEmptying) MOVE(7000,Scale.HMI_Read.StepNo) ,[XIO(Scale.Plc.o_FeedHold) ,XIC(Scale.Plc.o_FeedHold) XIC(Scale.HMI_Write.CmdContinue) OTU(Scale.Plc.o_FeedHold) ] XIO(Scale.Plc.i_FeedHold) XIC(Scale.Plc.i_AutoRun) [EQ(Scale.HMI_Read.StepNo,6000) OTE(Scale.Plc.o_Emptying) ,EQ(Scale.HMI_Read.StepNo,6100) OTE(Scale.Plc.o_IntermediateEmptying) ] ,[XIC(Scale.Plc.o_Emptying) ,XIC(Scale.Plc.o_IntermediateEmptying) ] XIC(Scale.Plc.i_Emptying) [TON(Scale.Plc.EmptyingTimer,?,?) ,LE(Scale.Plc.o_ScaleWeight,Scale.Plc.ParEmptyWeight) RTO(Scale.Plc.ClosingDelayTimer,?,?) ] ,XIC(Scale.Plc.EmptyingTimer.DN) OTE(Scale.HMI_Read.AlmEmptyingTime) ,[XIC(Scale.Plc.ClosingDelayTimer.DN) RES(Scale.Plc.ClosingDelayTimer) ,XIC(Scale.HMI_Read.AlmEmptyingTime) XIC(Scale.HMI_Write.CmdAcceptWt) ] [EQ(Scale.HMI_Read.StepNo,6000) MOVE(7000,Scale.HMI_Read.StepNo) ,EQ(Scale.HMI_Read.StepNo,6100) [MOVE(1200,Scale.HMI_Read.StepNo) ,OTU(Scale.Plc.o_IntermediateEmptyingFlag) ] ] ];]]></Text></Rung><Rung Number="38" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 StepNo 7000 (Log Batch Weight)
 ----------------------------------------------------------------------------------------------------
 Batch Actual Weight is Updated After Each Ingredient
 
]]></Comment><Text><![CDATA[EQ(Scale.HMI_Read.StepNo,7000)[MOVE(Scale.Plc.i_BatchTargetWeight,Scale.Plc.o_BatchTargetWeight) ,AFI() SUB(EmptyingWeightTare,Scale.Plc.o_ScaleWeight,Scale.Plc.o_BatchActualWeight) ,SUB(Scale.Plc.o_BatchTargetWeight,Scale.Plc.o_BatchActualWeight,Scale.Plc.o_BatchWeightDifference) ,OTL(Scale.HMI_Read.Hsk_RegisterBatchReq) ,XIC(Scale.HMI_Read.Hsk_RegisterBatchReq) XIC(Scale.HMI_Write.Hsk_RegisterBatchDone) [OTU(Scale.HMI_Read.Hsk_RegisterBatchReq) OTU(Scale.HMI_Write.Hsk_RegisterBatchDone) ,OTL(Scale.HMI_Read.Hsk_BatchComplete) ,MOVE(1000,Scale.HMI_Read.StepNo) ] ];]]></Text></Rung><Rung Number="39" Type="N"><Text><![CDATA[LBL(End)NOP();]]></Text></Rung><Rung Number="40" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 Map Data to HMI Read
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[[MOVE(Scale.Plc.o_ScaleWeight,Scale.HMI_Read.ScaleWeight) ,GT(Scale.HMI_Read.StepNo,1000) [MOVE(Scale.Plc.o_IngrBinNo,Scale.HMI_Read.BinSelected) MOVE(Scale.Plc.o_IngrBinNoSubstituted,Scale.HMI_Read.BinNoSubstituted) MOVE(Scale.Plc.o_IngrTargetWeight,Scale.HMI_Read.IngrTargetWeight) MOVE(Scale.Plc.o_IngrActualWeight,Scale.HMI_Read.IngrActualWeight) ,MOVE(Scale.Plc.o_BatchTargetWeight,Scale.HMI_Read.BatchTargetWeight) MOVE(Scale.Plc.o_BatchActualWeight,Scale.HMI_Read.BatchActualWeight) ,ADD(Scale.Plc.IndexIngr,1,Scale.Plc.o_IngrNo) ] ];]]></Text></Rung><Rung Number="41" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 Scale Active
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[GT(Scale.HMI_Read.StepNo,1000)OTE(Scale.Plc.o_Active);]]></Text></Rung><Rung Number="42" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 Reset Vibrator Flag
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[XIC(Scale.Plc.TriggerVibrator)[LT(Scale.HMI_Read.StepNo,4100) ,GT(Scale.HMI_Read.StepNo,4300) ]OTU(Scale.Plc.TriggerVibrator);]]></Text></Rung><Rung Number="43" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 Reset Alarms
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[XIC(Scale.HMI_Read.AlmDosingMonitor)[EQ(Scale.HMI_Read.StepNo,1000) ,EQ(Scale.HMI_Read.StepNo,5100) ]OTU(Scale.HMI_Read.AlmDosingMonitor);]]></Text></Rung><Rung Number="44" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 Reset Cmds
 ----------------------------------------------------------------------------------------------------
  
]]></Comment><Text><![CDATA[OTU(Scale.HMI_Write.CmdFaultReset)OTU(Scale.HMI_Write.CmdStart)OTU(Scale.HMI_Write.CmdContinue)OTU(Scale.HMI_Write.CmdPause)OTU(Scale.HMI_Write.CmdModify)OTU(Scale.HMI_Write.CmdModifyMulti)OTU(Scale.HMI_Write.CmdReset)OTU(Scale.HMI_Write.CmdAcceptWt)OTU(Scale.HMI_Write.CmdAbortIngr)OTU(Scale.HMI_Write.CmdAbortBatch)OTU(Scale.HMI_Write.CmdLogged);]]></Text></Rung><Rung Number="45" Type="N"><Text><![CDATA[OTU(Scale.HMI_Write.CmdSingleIngrModeOn)OTU(Scale.HMI_Write.CmdSingleIngrModeOff)OTU(Scale.HMI_Write.CmdSingleIngrModeStart)OTU(Scale.Plc.i_SingleIngrModeDosingAck);]]></Text></Rung><Rung Number="46" Type="N"><Text><![CDATA[OTU(Scale.HMI_Write.CmdRefillModeOn)OTU(Scale.HMI_Write.CmdRefillModeOff)OTU(Scale.Plc.i_CmdRefillModeOn)OTU(Scale.Plc.i_CmdRefillModeOff);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="BatchController_RecipeCheck" Class="Standard" Revision="1.0" Vendor="KE" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2023-10-19T15:06:26.437Z" CreatedBy="KNOBELSDORFF\Jeremy.Noble" EditedDate="2024-03-27T18:33:56.755Z" EditedBy="KNOBELSDORFF\Jeremy.Noble" SoftwareRevision="v33.00"><RevisionNote><![CDATA[v1.0]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="Scale" TagType="Base" DataType="BatchControl" Usage="InOut" Required="true" Visible="true" Constant="false" /><Parameter Name="RecipeEmpty" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="InvalidIngr" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="tmp_IndexIngr" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="tmp_IndexBin" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="tmp_IngrArraySize" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Recipe Check
 ----------------------------------------------------------------------------------------------------
 
]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[Initialize flags
 
]]></Comment><Text><![CDATA[OTU(RecipeEmpty)OTU(InvalidIngr);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[MOVE(0,tmp_IndexIngr)MOVE(0,tmp_IndexBin)SIZE(Scale.Recipe.Ingr,0,tmp_IngrArraySize)MOVE(0,Scale.Plc.o_IngrCount);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[MOVE(0,Scale.Plc.i_BatchTargetWeight);]]></Text></Rung><Rung Number="4" Type="N"><Comment><![CDATA[ ----------------------------------------------------------------------------------------------------
 Check if recipe for job is valid
If recipe is empty, set flag and jump to end of routine
If invalide BinNo is found, set flag and jump to end of routine
 ----------------------------------------------------------------------------------------------------
 

