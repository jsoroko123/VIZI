 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[XIO(Disabled)XIC(HMI_ModeStatus.4)OTL(HMI_Control.2)OTU(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[XIC(HMI_Control.1)OTL(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[XIC(HMI_Control.2)OTU(HMI_ModeStatus.1)OTL(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIC(HMI_Control.3)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTL(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[[[XIC(HMI_Control.10) OTL(Disabled) ,XIC(HMI_Control.10) XIC(Disable_FlipFlop) OTU(Disabled) ] ,XIO(HMI_Control.10) XIC(Disabled) OTE(Disable_FlipFlop) ];]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[XIC(Disabled)OTE(o_Disabled)OTU(HMI_Control.4)OTU(HMI_Control.5)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3)OTL(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="8" Type="N"><Comment><![CDATA[|==================================================|
 Postion Logic
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="9" Type="N"><Text><![CDATA[XIC(i_SimulateEnabled)OTE(o_Simulated);]]></Text></Rung><Rung Number="10" Type="N"><Text><![CDATA[XIO(o_Simulated)XIO(i_Force)MOVE(inp_Position,o_Position);]]></Text></Rung><Rung Number="11" Type="N"><Text><![CDATA[[XIC(o_Simulated) ,XIC(i_Force) ][XIC(outp_Pos1Cmd) XIO(o_stInPos1) OTE(PosSimDecrease) ,XIC(outp_Pos2Cmd) XIO(o_stInPos2) OTE(PosSimIncrease) ];]]></Text></Rung><Rung Number="12" Type="N"><Text><![CDATA[[XIC(o_Simulated) ,XIC(i_Force) ][XIC(PosSimDecrease) TON(SimDecreaseTMR,?,?) XIC(SimDecreaseTMR.DN) SUB(o_Position,I_SimDecreaseMul,o_Position) LT(o_Position,0) MOVE(0,o_Position) ,XIC(PosSimIncrease) TON(SimIncreaseTMR,?,?) XIC(SimIncreaseTMR.DN) ADD(o_Position,I_SimAdditionMul,o_Position) GT(o_Position,100) MOVE(100,o_Position) ];]]></Text></Rung><Rung Number="13" Type="N"><Text><![CDATA[[XIO(i_Force) XIO(o_Simulated) XIC(inp_Pos2LimitSwitch) XIO(inp_Pos1LimitSwitch) ,[XIC(o_Simulated) ,XIC(i_Force) ] [[XIC(i_MaintainOutputEnabled) XIC(outp_Pos2Cmd) ,XIO(i_MaintainOutputEnabled) XIC(outp_Pos2Cmd) ] EQ(o_Position,100) ,XIC(o_stInPos2) XIO(outp_Pos1Cmd) XIO(Mov1_Req) ] ]OTE(o_stInPos2);]]></Text></Rung><Rung Number="14" Type="N"><Text><![CDATA[[XIO(i_Force) XIO(o_Simulated) XIC(inp_Pos1LimitSwitch) XIO(inp_Pos2LimitSwitch) ,[XIC(o_Simulated) ,XIC(i_Force) ] [[XIC(i_MaintainOutputEnabled) XIC(outp_Pos1Cmd) ,XIO(i_MaintainOutputEnabled) XIC(Mov1_Req) ] EQ(o_Position,0) ,XIC(o_stInPos1) XIO(outp_Pos2Cmd) XIO(Mov2_Req) ] ]OTE(o_stInPos1);]]></Text></Rung><Rung Number="15" Type="N"><Comment><![CDATA[|==================================================|
 Fault Handling
 |==================================================|
 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="16" Type="N"><Text><![CDATA[[XIC(outp_Pos1Cmd) [XIO(o_stInPos1) ,XIC(o_stInPos2) ] XIO(inBandwidth) MOVE(i_Pos1TimerPre,InternalFaultDelay_Timer[0].PRE) TON(InternalFaultDelay_Timer[0],?,?) XIC(InternalFaultDelay_Timer[0].DN) ,XIC(o_Pos1Fault) XIO(i_FaultReset) XIO(HMI_EquipmentReset) ]OTE(o_Pos1Fault);]]></Text></Rung><Rung Number="17" Type="N"><Text><![CDATA[[XIC(outp_Pos2Cmd) [XIO(o_stInPos2) ,XIC(o_stInPos1) ] XIO(inBandwidth) MOVE(i_Pos2TimerPre,InternalFaultDelay_Timer[1].PRE) TON(InternalFaultDelay_Timer[1],?,?) XIC(InternalFaultDelay_Timer[1].DN) ,XIC(o_Pos2Fault) XIO(i_FaultReset) XIO(HMI_EquipmentReset) ]OTE(o_Pos2Fault);]]></Text></Rung><Rung Number="18" Type="N"><Text><![CDATA[[XIC(i_FaultPresent) ,XIC(o_Pos1Fault) ,XIC(o_Pos2Fault) ]OTE(o_StFault)ONS(ONS)OTL(o_Horn);]]></Text></Rung><Rung Number="19" Type="N"><Text><![CDATA[XIC(o_ResetExternalFaults)OTU(o_ResetExternalFaults);]]></Text></Rung><Rung Number="20" Type="N"><Text><![CDATA[[XIC(i_HornReset) ,[XIC(i_FaultReset) ,XIC(HMI_EquipmentReset) ] OTL(o_ResetExternalFaults) ]OTU(o_Horn);]]></Text></Rung><Rung Number="21" Type="N"><Comment><![CDATA[|==================================================|
 Commodity and Route
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="22" Type="N"><Text><![CDATA[NE(i_RouteID,0)OTE(o_Owned);]]></Text></Rung><Rung Number="23" Type="N"><Text><![CDATA[[XIC(S:FS) ,XIC(i_ClearProduct) ]OTL(Cleanout.DN);]]></Text></Rung><Rung Number="24" Type="N"><Text><![CDATA[[XIC(i_Feed) ,XIO(Cleanout.DN) ]MOVE(i_DirtyDelayTimerPre,DirtyDelay.PRE)TON(DirtyDelay,?,?)XIC(DirtyDelay.DN)[OTE(o_Dirty) ,MOVE(i_Commodity,Commodity) ];]]></Text></Rung><Rung Number="25" Type="N"><Text><![CDATA[[XIC(o_Dirty) ,XIC(Cleanout.DN) ]XIO(i_Feed)[MOVE(i_CleanoutTimerPre,Cleanout.PRE) TON(Cleanout,?,?) ,XIC(Cleanout.DN) MOVE(0,Commodity) ];]]></Text></Rung><Rung Number="26" Type="N"><Text><![CDATA[CPT(o_CleanoutTimeRemaining,(Cleanout.PRE - Cleanout.ACC));]]></Text></Rung><Rung Number="27" Type="N"><Comment><![CDATA[|==================================================|
 Interlock
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="28" Type="N"><Text><![CDATA[[XIC(HMI_ModeStatus.1) [XIC(i_AutoPos2) ,XIC(i_AutoPos1) ] ,XIC(HMI_ModeStatus.2) XIC(i_InterlocksEnableInManual) ]XIO(i_EquipmentInterlock)OTE(o_Waiting);]]></Text></Rung><Rung Number="29" Type="N"><Comment><![CDATA[Commands
 ]]></Comment><Text><![CDATA[[SUB(i_PositionRequest,i_Bandwidth,BandwidthPosMin) ADD(i_PositionRequest,i_Bandwidth,BandwidthPosMax) ,EQ(i_PositionRequest,100) MOVE(i_PositionRequest,BandwidthPosMin) ADD(BandwidthPosMin,i_Bandwidth,BandwidthPosMax) ,EQ(i_PositionRequest,0) MOVE(i_PositionRequest,BandwidthPosMax) SUB(BandwidthPosMax,i_Bandwidth,BandwidthPosMin) ];]]></Text></Rung><Rung Number="30" Type="N"><Text><![CDATA[[XIO(o_Waiting) LIMIT(BandwidthPosMin,o_Position,BandwidthPosMax) ,XIC(o_Waiting) XIC(o_stInPos1) ]OTE(o_InPosition);]]></Text></Rung><Rung Number="31" Type="N"><Text><![CDATA[[GT(o_Position,BandwidthPosMax) OTE(Mov1_Req) ,LT(o_Position,BandwidthPosMin) OTE(Mov2_Req) ];]]></Text></Rung><Rung Number="32" Type="N"><Text><![CDATA[[XIC(o_Waiting) XIC(i_InterlockType) ,[XIC(HMI_ModeStatus.1) XIC(i_AutoPos1) ,XIO(HMI_ModeStatus.1) [XIC(HMI_Control.4) XIO(outp_Pos1Cmd) ,XIC(outp_Pos1Cmd) [XIO(i_MaintainOutputEnabled) XIC(HMI_Control.4) ,XIC(i_MaintainOutputEnabled) XIC(HMI_Control.4) ] ] ] [XIC(Mov1_Req) ,XIO(HMI_ModeStatus.1) ,XIO(i_AutoPos2) ] [XIO(o_StFault) ,XIC(HMI_ModeStatus.3) ] ][XIO(i_MaintainOutputEnabled) XIO(o_stInPos1) ,XIC(i_MaintainOutputEnabled) ]XIO(outp_Pos2Cmd)XIO(Disabled)OTE(outp_Pos1Cmd);]]></Text></Rung><Rung Number="33" Type="N"><Text><![CDATA[[XIC(HMI_ModeStatus.1) XIC(i_AutoPos2) ,XIO(HMI_ModeStatus.1) [XIC(HMI_Control.5) XIO(outp_Pos2Cmd) ,XIC(outp_Pos2Cmd) [XIO(i_MaintainOutputEnabled) XIC(HMI_Control.5) ,XIC(i_MaintainOutputEnabled) XIC(HMI_Control.5) ] ] ][XIC(Mov2_Req) ,XIO(HMI_ModeStatus.1) ][XIO(o_StFault) XIO(o_Waiting) ,XIC(HMI_ModeStatus.3) ][XIO(o_stInPos2) XIO(outp_Pos1Cmd) ,XIC(i_MaintainOutputEnabled) ]XIO(Disabled)OTE(outp_Pos2Cmd);]]></Text></Rung><Rung Number="34" Type="N"><Text><![CDATA[XIO(o_stInPos1)XIO(o_stInPos2)[XIC(outp_Pos1Cmd) OTE(o_stInMotiontoPos1) ,XIC(outp_Pos2Cmd) OTE(o_stInMotiontoPos2) ];]]></Text></Rung><Rung Number="35" Type="N"><Text><![CDATA[XIO(o_stInMotiontoPos1)XIO(o_stInMotiontoPos2)XIO(o_StFault)XIO(o_stInPos1)XIO(o_stInPos2)OTE(o_stNoPosition);]]></Text></Rung><Rung Number="36" Type="N"><Comment><![CDATA[HMI_States]]></Comment><Text><![CDATA[[XIC(o_stInPos1) MOVE(1,HMI_State) ,XIC(o_stInPos2) MOVE(2,HMI_State) ,XIC(o_stNoPosition) MOVE(4,HMI_State) ,XIC(o_stInMotiontoPos1) MOVE(8,HMI_State) ,XIC(o_stInMotiontoPos2) MOVE(16,HMI_State) ,XIC(o_StFault) MOVE(32,HMI_State) ];]]></Text></Rung><Rung Number="37" Type="N"><Comment><![CDATA[|==================================================|
 Reset HMI Commands
