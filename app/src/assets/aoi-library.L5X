<AddOnInstructionDefinition Name="CountDown" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2018-04-17T15:10:56.397Z" CreatedBy="KNOBELSDORFF\DylanD" EditedDate="2024-03-14T16:45:44.678Z" EditedBy="KNOBELSDORFF\Jeremy.Noble" SoftwareRevision="v33.00"><RevisionNote><![CDATA[DD - Knobelsdorff Electric
 4-17-18]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="i_Reset" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_Min" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_Sec" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_Enable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_RemainingMin" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_RemainingSec" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Done" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Timing" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="TimeOff" DataType="FBD_TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[1,0,0,0,0,0,0,0,0,4,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="FBD_TIMER"><DataValueMember Name="EnableIn" DataType="BOOL" Value="1" /><DataValueMember Name="TimerEnable" DataType="BOOL" Value="0" /><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="Reset" DataType="BOOL" Value="0" /><DataValueMember Name="EnableOut" DataType="BOOL" Value="0" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /><DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000" /><DataValueMember Name="InstructFault" DataType="BOOL" Value="0" /><DataValueMember Name="PresetInv" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="Timer_Reset" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="ST"><STContent><Line Number="0"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="1"><![CDATA[' Counts Down with user specified Min and Sec Inputs ]]></Line><Line Number="2"><![CDATA[' Outputs Reamining Time in 2 words Min and Sec]]></Line><Line Number="3"><![CDATA[' ]]></Line><Line Number="4"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="5"><![CDATA[TimeOff.PRE := ((i_Min*60)+i_Sec)*1000;]]></Line><Line Number="6"><![CDATA[TimeOff.Reset := 0;]]></Line><Line Number="7"><![CDATA[if i_Reset or o_Done Then]]></Line><Line Number="8"><![CDATA[TimeOff.Reset := 1;]]></Line><Line Number="9"><![CDATA[i_Reset := 0;]]></Line><Line Number="10"><![CDATA[End_if;]]></Line><Line Number="11"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="12"><![CDATA[' Disable the Timer until the next High pulse of i_TimerEnable]]></Line><Line Number="13"><![CDATA[' ]]></Line><Line Number="14"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="15"><![CDATA[if not o_Done Then]]></Line><Line Number="16"><![CDATA[TimeOff.TimerEnable := i_Enable;]]></Line><Line Number="17"><![CDATA[Else]]></Line><Line Number="18"><![CDATA[TimeOff.TimerEnable := 0;]]></Line><Line Number="19"><![CDATA[End_if;]]></Line><Line Number="20"><![CDATA[(* ----- *)]]></Line><Line Number="21"><![CDATA[RTOR(TimeOff);]]></Line><Line Number="22"><![CDATA[o_Timing := TimeOff.TT;]]></Line><Line Number="23"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="24"><![CDATA[' Set the o_Remaining words. Does not allow the value to be below 0]]></Line><Line Number="25"><![CDATA[' ]]></Line><Line Number="26"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="27"><![CDATA[o_RemainingMin := ((TimeOff.PRE-TimeOff.ACC)/1000)/60;]]></Line><Line Number="28"><![CDATA[if o_RemainingMin < 0 or o_Done Then]]></Line><Line Number="29"><![CDATA[o_RemainingMin := 0;]]></Line><Line Number="30"><![CDATA[End_if;]]></Line><Line Number="31"><![CDATA[o_RemainingSec := ((TimeOff.PRE-TimeOff.ACC)/1000)-(o_RemainingMin*60);]]></Line><Line Number="32"><![CDATA[if o_RemainingSec < 0 or o_Done Then]]></Line><Line Number="33"><![CDATA[o_RemainingSec := 0;]]></Line><Line Number="34"><![CDATA[End_if;]]></Line><Line Number="35"><![CDATA[if TimeOff.DN Then]]></Line><Line Number="36"><![CDATA[o_Done := 1;]]></Line><Line Number="37"><![CDATA[End_if;]]></Line><Line Number="38"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="39"><![CDATA[' Clear the o_TimerDone bit on the Low pulse of i_TimerEnable]]></Line><Line Number="40"><![CDATA[' ]]></Line><Line Number="41"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="42"><![CDATA[if o_Done and not i_Enable Then]]></Line><Line Number="43"><![CDATA[o_Done := 0;]]></Line><Line Number="44"><![CDATA[End_if;]]></Line><Line Number="45"><![CDATA[(* end *)]]></Line><Line Number="46"><![CDATA[]]></Line></STContent></Routine></Routines></AddOnInstructionDefinition>
