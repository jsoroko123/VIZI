 Name="Loop" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="ValueSum" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag><LocalTag Name="ArrayEnd" DataType="DINT" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="ST"><STContent><Line Number="0"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="1"><![CDATA[' Filter An Analog Value.]]></Line><Line Number="2"><![CDATA[']]></Line><Line Number="3"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="4"><![CDATA[]]></Line><Line Number="5"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="6"><![CDATA[' Cycle The Table Each Scan As Long As i_Cycle Is True.]]></Line><Line Number="7"><![CDATA[']]></Line><Line Number="8"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="9"><![CDATA[Cycle := i_Cycle;]]></Line><Line Number="10"><![CDATA[]]></Line><Line Number="11"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="12"><![CDATA[' Determine The Last Value In The Array]]></Line><Line Number="13"><![CDATA[']]></Line><Line Number="14"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="15"><![CDATA[ArrayEnd := i_FilterSize -1;]]></Line><Line Number="16"><![CDATA[]]></Line><Line Number="17"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="18"><![CDATA[' Insert The New Value Into The Table, The Oldest Value Is Dropped.]]></Line><Line Number="19"><![CDATA[']]></Line><Line Number="20"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="21"><![CDATA[IF Cycle THEN]]></Line><Line Number="22"><![CDATA[CPS(Table[1], Table[0], ArrayEnd);]]></Line><Line Number="23"><![CDATA[Table[ArrayEnd] := i_Value;]]></Line><Line Number="24"><![CDATA[Cycle := 0;]]></Line><Line Number="25"><![CDATA[END_IF;]]></Line><Line Number="26"><![CDATA[]]></Line><Line Number="27"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="28"><![CDATA[' Find The Average Of i_Value. ]]></Line><Line Number="29"><![CDATA[' The Number in i_FilterSize Determinws How Many Values Are Evaluated.]]></Line><Line Number="30"><![CDATA[']]></Line><Line Number="31"><![CDATA[*******************************************************************************************************************************************************)]]></Line><Line Number="32"><![CDATA[(* Find The Average Of i_Value. The Number in i_FilterSize Determinws How Many Values Are Evaluated *)]]></Line><Line Number="33"><![CDATA[ValueSum := 0;]]></Line><Line Number="34"><![CDATA[FOR Loop := 0 TO ArrayEnd DO]]></Line><Line Number="35"><![CDATA[ValueSum := ValueSum + Table[Loop];]]></Line><Line Number="36"><![CDATA[END_FOR;]]></Line><Line Number="37"><![CDATA[o_Value := ValueSum / i_FilterSize;]]></Line><Line Number="38"><![CDATA[(* end *)]]></Line></STContent></Routine></Routines></AddOnInstructionDefinition>
