]]></Comment><Text><![CDATA[LIMIT(4100,Scale.HMI_Read.StepNo,4300)[[XIC(Scale.Plc.o_FeedHold) ,XIC(Scale.Plc.i_FeedHold) ,XIO(Scale.Plc.i_AutoRun) ] MOVE(4000,Scale.HMI_Read.StepNo) ,NE(Scale.HMI_Read.StepNo,4300) MOVE(Scale.Plc.ParDosingMonDelayTime,Scale.Plc.DosingMonDelayTimer.PRE) TON(Scale.Plc.DosingMonDelayTimer,?,?) ,MOVE(Scale.Plc.ParDosingMonTime,Scale.Plc.DosingMonTimer.PRE) XIC(Scale.Plc.DosingMonDelayTimer.DN) XIO(Scale.Plc.DosingMonTimer.DN) [TON(Scale.Plc.DosingMonTimer,?,?) ,ONS(dosingMonOns1) MOVE(Scale.Plc.o_ScaleWeight,dosingMonTareWt) CLR(dosingMonTestWt) ,SUB(Scale.Plc.o_ScaleWeight,dosingMonTareWt,dosingMonTestWt) ] ,XIC(Scale.Plc.DosingMonTimer.DN) [EQ(Scale.HMI_Read.StepNo,4100) GT(Scale.Plc.ParDosingMonWtFast,0) GE(dosingMonTestWt,Scale.Plc.ParDosingMonWtFast) ,EQ(Scale.HMI_Read.StepNo,4200) GT(Scale.Plc.ParDosingMonWtSlow,0) GE(dosingMonTestWt,Scale.Plc.ParDosingMonWtSlow) ] [OTU(Scale.HMI_Read.AlmDosingMonitor) ,OTU(Scale.Plc.TriggerVibrator) ] ,XIC(Scale.Plc.DosingMonTimer.DN) [XIC(Scale.Plc.TriggerVibrator) ,XIO(Scale.Plc.VibratorsEquipped) ] [EQ(Scale.HMI_Read.StepNo,4100) GT(Scale.Plc.ParDosingMonWtFast,0) LT(dosingMonTestWt,Scale.Plc.ParDosingMonWtFast) ,EQ(Scale.HMI_Read.StepNo,4200) GT(Scale.Plc.ParDosingMonWtSlow,0) LT(dosingMonTestWt,Scale.Plc.ParDosingMonWtSlow) ] [OTL(Scale.HMI_Read.AlmDosingMonitor) ,OTU(Scale.Plc.TriggerVibrator) ] ,XIC(Scale.Plc.DosingMonTimer.DN) XIC(Scale.Plc.VibratorsEquipped) XIO(Scale.Plc.TriggerVibrator) [EQ(Scale.HMI_Read.StepNo,4100) GT(Scale.Plc.ParDosingMonWtFast,0) LT(dosingMonTestWt,Scale.Plc.ParDosingMonWtFast) ,EQ(Scale.HMI_Read.StepNo,4200) GT(Scale.Plc.ParDosingMonWtSlow,0) LT(dosingMonTestWt,Scale.Plc.ParDosingMonWtSlow) ] OTL(Scale.Plc.TriggerVibrator) ,NE(Scale.HMI_Read.StepNo,4300) GE(Scale.Plc.o_ScaleWeight,Scale.Plc.ParScaleCapacity) OTL(Scale.Plc.o_IntermediateEmptyingFlag) MOVE(5000,Scale.HMI_Read.StepNo) ];]]></Text></Rung><Rung Number="26" Type="N"><Comment><![CDATA[ -----------------