 (Enable, Permissive, SoftStop)
 ---
 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[[CLR(Index) CLR(IndexRoute) SIZE(Route_Array.Route[0],0,local_RouteArraySize) ,LT(RouteArraySize,local_RouteArraySize) MOVE(RouteArraySize,local_RouteArraySize) ,ArrayClearBool(ClearBool,tmp_o_Enable,GroupArraySize) ArrayClearBool(ClearBool,tmp_o_Permissive,GroupArraySize) ,ArrayClearBool(ClearBool,tmp_o_SoftStop,GroupArraySize) ArrayFillBool(FillBool,tmp_o_NotSoftStop,GroupArraySize) ];]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[LBL(Section_Loop)NOP();]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[LBL(Gr_Loop)NOP();]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[XIC(Route_Array.Route[IndexRoute].Gr.o_Selected[Index]) ,XIC(Route_Array.Route[IndexRoute].Gr.o_SelectedIdle[Index]) ][XIC(Group_Control.i_Fgr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Fgr.i_Enable) ,XIC(Group_Control.i_Mgr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Mgr.i_Enable) ,XIC(Group_Control.i_Wgr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Wgr.i_Enable) ,XIC(Group_Control.i_Ggr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Ggr.i_Enable) ]OTL(tmp_o_Enable[Index]);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIC(Route_Array.Route[IndexRoute].Gr.o_Selected[Index])[XIC(Group_Control.i_Fgr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Fgr.i_Permissive) ,XIC(Group_Control.i_Mgr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Mgr.i_Permissive) ,XIC(Group_Control.i_Wgr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Wgr.i_Permissive) ,XIC(Group_Control.i_Ggr[Index]) XIC(Route_Array.Route[IndexRoute].Gr.Ggr.i_Permissive) ]OTL(tmp_o_Permissive[Index]);]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[[XIC(Route_Array.Route[IndexRoute].Gr.o_Selected[Index]) XIC(Route_Array.Route[IndexRoute].HMI_Read.Status.SoftStop) OTL(tmp_o_SoftStop[Index]) ,XIC(Route_Array.Route[IndexRoute].Gr.o_Selected[Index]) XIO(Route_Array.Route[IndexRoute].HMI_Read.Status.SoftStop) OTU(tmp_o_NotSoftStop[Index]) ];]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[[ADD(Index,1,Index) ,LT(Index,GroupArraySize) JMP(Gr_Loop) ];]]></Text></Rung><Rung Number="8" Type="N"><Text><![CDATA[[ADD(IndexRoute,1,IndexRoute) CLR(Index) ,LT(IndexRoute,local_RouteArraySize) JMP(Section_Loop) ];]]></Text></Rung><Rung Number="9" Type="N"><Text><![CDATA[ArrayCopyBool(CopyBool,GroupArraySize,tmp_o_Enable,Group_Control.o_Enable)ArrayCopyBool(CopyBool,GroupArraySize,tmp_o_Permissive,Group_Control.o_Permissive)ArrayAnd(ArrayAnd,GroupArraySize,tmp_o_SoftStop,tmp_o_NotSoftStop,Group_Control.o_SoftStop);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
