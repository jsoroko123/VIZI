 ]]></Comment><Text><![CDATA[LBL(ParBlend_UpdateJobWeight)[ADD(BinControl.BinList[tmp_IndexBin].o_JobWeight,tmp_JobWeight,tmp_JobWeight) ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_UpdateJobWeight) ,MOVE(tmp_JobWeight,BinControl.HMI_Read.JobWeight) ,MOVE(0,tmp_IndexBin) ];]]></Text></Rung><Rung Number="60" Type="N"><Comment><![CDATA[// ParBlend - Handle Bin Change
 
