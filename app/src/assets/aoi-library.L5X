 ]]></Comment><Text><![CDATA[LBL(ParBlend_CheckLevels)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]></Text></Rung><Rung Number="58" Type="N"><Text><![CDATA[LBL(ParBlend_CheckLevelBins)[XIC(BinControl.BinList[tmp_IndexBin].o_Active) [XIC(BinControl.Plc.ParSender) XIC(BinControl.BinList[tmp_IndexBin].i_LowLevel) OTL(BinControl.Plc.o_Empty) ,XIC(BinControl.Plc.ParReceiver) XIC(BinControl.BinList[tmp_IndexBin].i_HighLevel) OTL(BinControl.Plc.o_Full) ,XIC(BinControl.BinList[tmp_IndexBin].i_Lock) OTL(BinControl.Plc.o_Empty) OTL(BinControl.Plc.o_Full) ] ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_CheckLevelBins) ,MOVE(0,tmp_IndexBin) ];]]></Text></Rung><Rung Number="59" Type="N"><Comment><![CDATA[Update bin Job Weight and HMI Read Job Weight
 
