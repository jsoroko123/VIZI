T" Radix="Decimal" Value="20" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="UseVer2CmdTimer" DataType="TIMER" ExternalAccess="None"><Description><![CDATA[Timer to force UseVer2_ONS]]></Description><DefaultData Format="L5K"><![CDATA[[0,20,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="20" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="UseVer2_ONS" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Sets the V2 intial command array values]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Factory_Reset_Set" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Factory_Reset_ONS" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[[EQ(Port_Process_Data_Size,0) MOVE(1,Data_Size) ,EQ(Port_Process_Data_Size,1) MOVE(2,Data_Size) ,EQ(Port_Process_Data_Size,2) MOVE(4,Data_Size) ,EQ(Port_Process_Data_Size,3) MOVE(8,Data_Size) ,EQ(Port_Process_Data_Size,4) MOVE(16,Data_Size) ];]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[LE(Port_Number,8)NE(Port_Number,0)SUB(Port_Number,1,RealPort_Num)[MUL(Data_Size,RealPort_Num,Offset_Address) ADD(Offset_Address,95,Process_Offset) ,MUL(9,RealPort_Num,Offset_StatusFlgs) ADD(Offset_StatusFlgs,23,StatusFlgs_Offset) ];]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[XIO(AOI_Settings_Error)[XIC(PLC_Input[StatusFlgs_Offset].0) OTE(IOL_Mode) ,XIC(PLC_Input[StatusFlgs_Offset].1) [OTE(Device_Not_Connected) ,OTL(DevNotConn_Signal) ] ,[XIC(PLC_Input[StatusFlgs_Offset].2) ,XIC(Device_Not_Connected) ] OTE(Invalid_Data) ,XIC(PLC_Input[StatusFlgs_Offset].3) OTE(Wrong_VID_DID) ,XIC(PLC_Input[Process_Offset+2].0) OTE(Out1) ,XIC(PLC_Input[Process_Offset+2].1) OTE(Out2) ,MOVE(PLC_Input[StatusFlgs_Offset+1],Vendor_ID) ,COP(PLC_Input[StatusFlgs_Offset+2],Device_ID,1) ];]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[MOVE(PLC_Input[Process_Offset],Totalizer_array[1])MOVE(PLC_Input[Process_Offset+1],Totalizer_array[0])COP(Totalizer_array[0],FlowTotalizer,2);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[[EQ(Device_ID,573) ,EQ(Device_ID,576) ] [MOVE(0.01,Flow_Value_Gradient) ,MOVE(100,FlowSP_rp_Multiply) ] ,[EQ(Device_ID,570) ,EQ(Device_ID,671) ] [MOVE(0.001,Flow_Value_Gradient) ,MOVE(1000,FlowSP_rp_Multiply) ] ,[EQ(Device_ID,390) ,EQ(Device_ID,392) ] [OTE(UseVer1CmdArray) ,MOVE(0.1,Flow_Value_Gradient) ,MOVE(10,FlowSP_rp_Multiply) ] ]MUL(PLC_Input[Process_Offset+2],Flow_Value_Gradient,FlowRate);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[DIV(PLC_Input[Process_Offset+3],4,Temp_msk)MUL(Temp_msk,Temp_Value_Gradient,Temperature);]]></Text></Rung><Rung Number="6" Type="N"><Comment><![CDATA[Indicate if User input errors are present in the AOI]]></Comment><Text><![CDATA[[[EQ(Port_Number,0) ,GT(Port_Number,8) ,GT(Port_Process_Data_Size,4) ] OTE(AOI_Port_Error) ,[XIC(ConfigCmd_Trigger) XIC(FactoryReset_Trigger) XIC(ResetTotalizer_Trigger) ,XIC(ConfigCmd_Trigger) XIC(FactoryReset_Trigger) ,XIC(ConfigCmd_Trigger) XIC(ResetTotalizer_Trigger) ,XIC(FactoryReset_Trigger) XIC(ResetTotalizer_Trigger) ] ,[LT(OU1,3) ,GT(OU1,6) ] ,[EQ(SEL2,0) ,GT(SEL2,2) ] ,[LT(OU2,3) ,GT(OU2,6) ] ,[EQ(SELd,0) ,EQ(SELd,3) ,GT(SELd,4) ] ]OTE(AOI_Settings_Error);]]></Text></Rung><Rung Number="7" Type="N"><Comment><![CDATA[Start of Acyclic commands
Unlatch AL1x2x_Cmd_Rdy bit if the IO-Link device is not connected or if there is a AOI_Port_Error]]></Comment><Text><![CDATA[[XIC(Device_Not_Connected) [OTU(Config_Cmds_DN) ,OTU(FactoryReset_DN) ,OTU(Reset_Totalizer_DN) ,OTU(CmdModes_BusySignal) ] ,XIC(AOI_Port_Error) ]OTU(AL1x2x_Cmd_Rdy);]]></Text></Rung><Rung Number="8" Type="N"><Comment><![CDATA[A value is written to the IOLinkMaster_Name. As long as the IOLinkMaster_Name != 0 then AL1x2x_Cmd_Rdy bit is unlatached]]></Comment><Text><![CDATA[[XIC(PLC_Output[5].7) ,XIC(Cmds_Busy) ,XIO(DevNotConn_Signal) XIO(AOI_Settings_Error) [XIC(ConfigCmd_Trigger) OTL(ConfigCmd_Set) ,XIC(FactoryReset_Trigger) OTL(Factory_Reset_Set) ,XIC(ResetTotalizer_Trigger) OTL(Reset_Totalizer_Set) ] XIO(AL1x2x_Cmd_Rdy) ][XIO(AOI_Port_Error) OTE(IOLinkMaster_Name.[RealPort_Num]) ,OTU(AL1x2x_Cmd_Rdy) ];]]></Text></Rung><Rung Number="9" Type="N"><Text><![CDATA[XIO(ConfigCmd_Trigger)XIO(FactoryReset_Trigger)XIO(ResetTotalizer_Trigger)OTU(DevNotConn_Signal);]]></Text></Rung><Rung Number="10" Type="N"><Comment><![CDATA[AL1x2x_Cmd_Rdy bit goes high when IO-LinkMaster_Name & all triggers are set low & AL1x2x_Cmd_Rdy timer is done. ]]></Comment><Text><![CDATA[EQ(IOLinkMaster_Name,0)XIO(ConfigCmd_Trigger)XIO(FactoryReset_Trigger)XIO(ResetTotalizer_Trigger)XIO(Device_Not_Connected)XIO(AOI_Port_Error)TON(AL1x2x_Cmd_Rdy_Timer,?,?)XIC(AL1x2x_Cmd_Rdy_Timer.DN)OTL(AL1x2x_Cmd_Rdy);]]></Text></Rung><Rung Number="11" Type="N"><Comment><![CDATA[When a Trigger is set and the AL1x2x_Cmd_Rdy is high then commands are allows to start.
Cmds_DN signals are reset as necessary on the rising edge of the command trigger.]]></Comment><Text><![CDATA[XIO(Device_Not_Connected)[[XIC(ConfigCmd_Set) ,XIC(Factory_Reset_Set) ,XIC(Reset_Totalizer_Set) ] XIC(AL1x2x_Cmd_Rdy) ,XIC(ContinueCmdDelay.DN) ]ONS(TriggerCmdBuffer_ONS)[OTL(Cmd1) ,XIO(Reset_Totalizer_Set) [OTU(Config_Cmds_DN) ,OTL(CmdModes_BusySignal) ] ,OTU(FactoryReset_DN) ,XIO(ConfigCmd_Set) OTU(Reset_Totalizer_DN) ,OTU(TimeOut) ];]]></Text></Rung><Rung Number="12" Type="N"><Comment><![CDATA[CmdModes are set depending on the type of trigger set. Configuration commands start at 0 and System command start at -127. (Factory reset reserved for -127)]]></Comment><Text><![CDATA[[XIC(ConfigCmd_Set) ONS(ConfigCmd_ONS) MOVE(0,CmdMode) ,XIC(Factory_Reset_Set) ONS(Factory_Reset_ONS) MOVE(-127,CmdMode) ,XIC(Reset_Totalizer_Set) ONS(Reset_Totalizer_ONS) MOVE(-126,CmdMode) ];]]></Text></Rung><Rung Number="13" Type="N"><Comment><![CDATA[ISDU command values are coded in the ConfigCmdArray buffers. For the SM flow meters there are V1 and V2 commands. 
Depending on which device is connected V1 or V2 is coped to the ConfigCmdArray via a ONS because the Command values will be written in depending on the order of commands in the next rung.]]></Comment><Text><![CDATA[[XIC(UseVer1CmdArray) TON(UseVer1CmdTimer,?,?) XIC(UseVer1CmdTimer.DN) ONS(UseVer1_ONS) COP(ConfigCmdArray_V1[0],ConfigCmdArray[0],52) ,XIO(UseVer1CmdArray) TON(UseVer2CmdTimer,?,?) XIC(UseVer2CmdTimer.DN) ONS(UseVer2_ONS) COP(ConfigCmdArray_V2[0],ConfigCmdArray[0],52) ];]]></Text></Rung><Rung Number="14" Type="N"><Comment><![CDATA[The command Array values are input ino the ConfigCmdArray. The ConfigCmdArray_POS is incremeted as the command are processed. ]]></Comment><Text><![CDATA[EQ(CmdMode,0)XIC(Cmd1)XIO(Cmd2)[EQ(ConfigCmdArrray_POS,0) MOVE(3,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,4) MUL(SP1_Flow,FlowSP_rp_Multiply,SP1_Flow_INT) SWPB(SP1_Flow_INT,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,8) MUL(rp1_Flow,FlowSP_rp_Multiply,rP1_Flow_INT) SWPB(rP1_Flow_INT,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,12) MOVE(OU1,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,16) MOVE(SEL2,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,20) [EQ(SEL2,1) [[XIC(UseVer1CmdArray) MOVE(86,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ,XIO(UseVer1CmdArray) MOVE(593,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ] ,MUL(SP2,FlowSP_rp_Multiply,SP2_INT) SWPB(SP2_INT,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ,EQ(SEL2,2) [[XIC(UseVer1CmdArray) MOVE(88,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ,XIO(UseVer1CmdArray) MOVE(595,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ] ,MUL(SP2,10,SP2_INT) SWPB(SP2_INT,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ] ,EQ(ConfigCmdArrray_POS,24) [EQ(SEL2,1) [[XIC(UseVer1CmdArray) MOVE(87,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ,XIO(UseVer1CmdArray) MOVE(594,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ] ,MUL(rP2,FlowSP_rp_Multiply,rP2_INT) SWPB(rP2_INT,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ,EQ(SEL2,2) [[XIC(UseVer1CmdArray) MOVE(89,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ,XIO(UseVer1CmdArray) MOVE(596,ConfigCmdArray[ConfigCmdArrray_POS]) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ] ,MUL(rP2,10,rP2_INT) SWPB(rP2_INT,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ] ,EQ(ConfigCmdArrray_POS,28) MOVE(OU2,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,32) [XIO(FlowDirection) MOVE(0,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,XIC(FlowDirection) MOVE(1,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ,EQ(ConfigCmdArrray_POS,36) [XIO(Totalizer_CntRule) MOVE(0,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,XIC(Totalizer_CntRule) MOVE(1,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ,EQ(ConfigCmdArrray_POS,40) [XIO(Display_On_Off) XIO(Display_Rotated) MOVE(16#0400,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,XIC(Display_On_Off) XIO(Display_Rotated) MOVE(16#8400,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,XIO(Display_On_Off) XIC(Display_Rotated) MOVE(16#4400,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,XIC(Display_On_Off) XIC(Display_Rotated) MOVE(16#C400,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ,EQ(ConfigCmdArrray_POS,44) SWPB(SELd,REVERSE,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,EQ(ConfigCmdArrray_POS,48) [XIO(Units) MOVE(0,ConfigCmdArray[ConfigCmdArrray_POS+3]) ,XIC(Units) MOVE(1,ConfigCmdArray[ConfigCmdArrray_POS+3]) ] ];]]></Text></Rung><Rung Number="15" Type="N"><Comment><![CDATA[Sets the Port number, Index, Subindex, Write mode (always for Cmd1), and size of the command, and Command Data 
If a Cmd1 is set for longer then the Timeout Time the AOI is reset
The data is sorted given the set CmdMode ]]></Comment><Text><![CDATA[XIO(AOI_Port_Error)XIC(Cmd1)TON(TimeOut2,?,?)XIO(Cmd2)[EQ(CmdMode,0) [MOVE(Port_Number,PLC_Output[2]) ,NE(ConfigCmdArrray_POS,20) NE(ConfigCmdArrray_POS,24) MOVE(ConfigCmdArray[ConfigCmdArrray_POS],PLC_Output[3]) ,MOVE(ConfigCmdArray[ConfigCmdArrray_POS+1],PLC_Output[4]) ,BTD(2,0,PLC_Output[5],0,2) BTD(ConfigCmdArray[ConfigCmdArrray_POS+2],0,PLC_Output[5],8,8) ,MOVE(ConfigCmdArray[ConfigCmdArrray_POS+3],PLC_Output[6]) ] ,LE(CmdMode,-126) MOVE(Port_Number,PLC_Output[2]) MOVE(2,PLC_Output[3]) MOVE(0,PLC_Output[4]) [BTD(2,0,PLC_Output[5],0,2) ,BTD(1,0,PLC_Output[5],8,8) ] [EQ(CmdMode,-127) MOVE(130,PLC_Output[6]) ,EQ(CmdMode,-126) MOVE(164,PLC_Output[6]) ] ];]]></Text></Rung><Rung Number="16" Type="N"><Comment><![CDATA[The Command results is complete with or without error given by the response of the PLC_Input. ]]></Comment><Text><![CDATA[XIC(Cmd1)XIO(Cmd2)XIC(Cmd1_Busy)XIC(PLC_Input[5].7)[EQ(CmdMode,0) EQ(PLC_Input[3],ConfigCmdArray[ConfigCmdArrray_POS]) [[EQ(PLC_Input[5],129) ,EQ(PLC_Input[5],130) ] OTL(Cmd1_DN) ,NE(PLC_Input[5],129) NE(PLC_Input[5],130) OTL(Cmd1_DN_Error) ] ,LE(CmdMode,-126) ]OTL(Cmd1ReleaseTrigger);]]></Text></Rung><Rung Number="17" Type="N"><Comment><![CDATA[The response of the command is written to the Config_CmdsResp_Buffer]]></Comment><Text><![CDATA[[XIC(Cmd1_DN) ,XIC(Cmd1_DN_Error) ]XIC(Cmd1)XIO(Cmd2)NE(ConfigCmdArrray_POS,0)[BTD(PLC_Input[6],8,Config_CmdsResp_Buffer[RespArray_POS],8,8) ,BTD(PLC_Input[7],0,Config_CmdsResp_Buffer[RespArray_POS],0,8) ];]]></Text></Rung><Rung Number="18" Type="N"><Comment><![CDATA[Logic is ready to start processing Cmd2]]></Comment><Text><![CDATA[XIC(Cmd1ReleaseTrigger)XIO(PLC_Output[5].7)OTL(Cmd2);]]></Text></Rung><Rung Number="19" Type="N"><Comment><![CDATA[Cmd 2 is always set to read the same Index set by Command 1. 
If a system command is process it is write only. The Logic is passed by.]]></Comment><Text><![CDATA[XIC(Cmd2)XIO(Config_Cmds_DN)XIO(Factory_Reset_Set)XIO(Reset_Totalizer_Set)[BTD(1,0,PLC_Output[5],0,2) ,BTD(0,0,PLC_Output[5],8,8) ,COP(Cmd_Array_Empty[0],PLC_Output[6],16) ];]]></Text></Rung><Rung Number="20" Type="N"><Comment><![CDATA[The Command results is complete with or without error given by the response of the PLC_Input. ]]></Comment><Text><![CDATA[XIC(Cmd2)[XIO(Config_Cmds_DN) XIO(Factory_Reset_Set) XIO(Reset_Totalizer_Set) XIC(Cmd2_Busy) XIC(PLC_Input[5].7) EQ(PLC_Input[3],ConfigCmdArray[ConfigCmdArrray_POS]) [[EQ(PLC_Input[5],129) ,EQ(PLC_Input[5],130) ] OTL(Cmd2_DN) ,NE(PLC_Input[5],129) NE(PLC_Input[5],130) OTL(Cmd2_DN_Error) ] ,XIC(Factory_Reset_Set) ,XIC(Reset_Totalizer_Set) ]OTL(Cmd2ReleaseTrigger);]]></Text></Rung><Rung Number="21" Type="N"><Comment><![CDATA[Given the length of the command repsonses (for SM only 1 or 2 bytes responses are possible) are written to the Confi_CmdsResp_Buffer array]]></Comment><Text><![CDATA[[XIC(Cmd2_DN) ,XIC(Cmd2_DN_Error) ]XIC(Cmd2)XIO(Config_Cmds_DN)NE(ConfigCmdArrray_POS,0)BTD(PLC_Input[6],0,Cmd_RespLength,0,8)[EQ(Cmd_RespLength,1) [BTD(PLC_Input[6],8,Config_CmdsResp_Buffer[RespArray_POS+12],0,8) ,BTD(0,0,Config_CmdsResp_Buffer[RespArray_POS+12],8,8) ] ,EQ(Cmd_RespLength,2) [BTD(PLC_Input[6],8,Config_CmdsResp_Buffer[RespArray_POS+12],8,8) ,BTD(PLC_Input[7],0,Config_CmdsResp_Buffer[RespArray_POS+12],0,8) ] ];]]></Text></Rung><Rung Number="22" Type="N"><Comment><![CDATA[The command sets (Cmd1 & Cmd2) are counted and the ConfigCmdArray and RespArray positions are incremented. 
When each CmdSet is done processing the logic is ready to process the next command. 
When all CmdSets are completed then appropriate Cmds_DN AOI output bits are set ]]></Comment><Text><![CDATA[XIC(Cmd2ReleaseTrigger)XIO(PLC_Output[5].7)[XIO(Factory_Reset_Set) XIO(Reset_Totalizer_Set) CTU(CmdSetCounter,?,?) [LE(CmdSetCounter.ACC,12) [[ADD(4,ConfigCmdArrray_POS,ConfigCmdArrray_POS) ,GT(CmdSetCounter.ACC,1) ADD(1,RespArray_POS,RespArray_POS) ] ,OTL(CmdSet_DN) ] ,EQ(CmdSetCounter.ACC,13) OTL(Config_Cmds_DN) ] ,XIC(Factory_Reset_Set) OTL(FactoryReset_DN) ,XIC(Reset_Totalizer_Set) OTL(Reset_Totalizer_DN) ];]]></Text></Rung><Rung Number="23" Type="N"><Comment><![CDATA[The Data is set for Cmd1 and the signal to trigger the command is set. ]]></Comment><Text><![CDATA[XIC(Cmd1)XIO(Cmd1ReleaseTrigger)XIO(Device_Not_Connected)OTE(Cmd1_PLC_OutTrigger);]]></Text></Rung><Rung Number="24" Type="N"><Comment><![CDATA[Ready to process command two. TON delays the trigger. For Factory Reset and Get Channel Info Cmd2 is not used and is skipped. ]]></Comment><Text><![CDATA[XIC(Cmd2)XIO(Cmd2ReleaseTrigger)XIO(Device_Not_Connected)XIO(Factory_Reset_Set)XIO(Reset_Totalizer_Set)TON(Cmd2TriggerDelay,?,?);]]></Text></Rung><Rung Number="25" Type="N"><Comment><![CDATA[Local indication to set the Command Trigger bit Data[5].7. The trigger bit is actually set in the next rung]]></Comment><Text><![CDATA[[[XIC(Cmd1_PLC_OutTrigger) ,XIC(Cmd2TriggerDelay.DN) ] ,XIC(ContinueCmdDelay.DN) ]MOVE(1,PLCTrigger);]]></Text></Rung><Rung Number="26" Type="N"><Comment><![CDATA[Set the Trigger Bit in the Controller Output tags Data[5].7 high to process the command]]></Comment><Text><![CDATA[EQ(PLCTrigger,1)[XIO(PLC_Input[5].7) [XIC(Cmd1_PLC_OutTrigger) OTL(Cmd1_Busy) ,XIC(Cmd2TriggerDelay.DN) OTL(Cmd2_Busy) ] ,BTD(PLCTrigger,0,PLC_Output[5],7,1) ];]]></Text></Rung><Rung Number="27" Type="N"><Comment><![CDATA[Set the local trigger indication to 0 and set the Trigger Bit in the Controller Output tags Data[5].7 low]]></Comment><Text><![CDATA[[XIO(Cmd1_PLC_OutTrigger) XIO(Cmd2TriggerDelay.DN) ,XIC(TimeOut) ]MOVE(0,PLCTrigger)[XIC(Cmd1) ,XIC(Cmd2) ]BTD(PLCTrigger,0,PLC_Output[5],7,1);]]></Text></Rung><Rung Number="28" Type="N"><Comment><![CDATA[Set the Cmds_Busy output bit on AOI]]></Comment><Text><![CDATA[[XIC(Cmd1_Busy) ,XIC(Cmd2_Busy) ,XIC(CmdModes_BusySignal) ]XIO(Device_Not_Connected)XIO(TimeOut)OTE(Cmds_Busy)TON(TimeOut1,?,?);]]></Text></Rung><Rung Number="29" Type="N"><Text><![CDATA[[XIC(Config_Cmds_DN) XIC(ConfigCmd_Set) ,XIC(FactoryReset_DN) XIC(Factory_Reset_Set) ,XIC(Reset_Totalizer_DN) XIC(Reset_Totalizer_Set) ][OTU(Cmd1_Busy) ,OTU(Cmd2_Busy) ,OTU(CmdModes_BusySignal) ];]]></Text></Rung><Rung Number="30" Type="N"><Comment><![CDATA[Cycle back to Cmd1 and Cmd2 for another command set or if command sets are complete reset commands]]></Comment><Text><![CDATA[[XIC(CmdSet_DN) OTE(Cmds_DN_Signal) OTU(Cmd1) ,[[EQ(CmdMode,0) XIC(Config_Cmds_DN) OTU(Cmd1) XIO(ConfigCmd_Trigger) ,XIC(Device_Not_Connected) ,XIO(ConfigCmd_Trigger) XIO(FactoryReset_Trigger) XIO(ResetTotalizer_Trigger) XIC(TimeOut) ] [MOVE(0,RespArray_POS) ,MOVE(0,ConfigCmdArrray_POS) ,RES(CmdSetCounter) ] ,EQ(CmdMode,-127) XIC(FactoryReset_DN) OTU(Cmd1) XIO(FactoryReset_Trigger) ,EQ(CmdMode,-126) XIC(Reset_Totalizer_DN) OTU(Cmd1) XIO(ResetTotalizer_Trigger) ] [OTU(ConfigCmd_Set) ,OTU(Factory_Reset_Set) ,OTU(Reset_Totalizer_Set) ] ][OTU(Cmd2) ,OTU(Cmd1_Busy) ,OTU(Cmd2_Busy) ,OTU(Cmd1_DN) ,OTU(Cmd2_DN) ,OTU(Cmd1_DN_Error) ,OTU(Cmd2_DN_Error) ,OTU(Cmd1ReleaseTrigger) ,OTU(Cmd2ReleaseTrigger) ];]]></Text></Rung><Rung Number="31" Type="N"><Comment><![CDATA[After each CmdSet is done processing the CmdSet_DN is reset so the next CmdSet can be run through the Cmd1 and Cmd2 rungs.]]></Comment><Text><![CDATA[XIC(Cmds_DN_Signal)TON(ContinueCmdDelay,?,?)XIC(ContinueCmdDelay.DN)OTU(CmdSet_DN);]]></Text></Rung><Rung Number="32" Type="N"><Text><![CDATA[[XIC(TimeOut1.DN) ,XIC(TimeOut2.DN) ]OTL(TimeOut);]]></Text></Rung><Rung Number="33" Type="N"><Text><![CDATA[XIC(TimeOut)[OTU(Config_Cmds_DN) ,OTU(FactoryReset_DN) ,OTU(Reset_Totalizer_DN) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="TD_TA_TP_8PORT_IOL" Class="Standard" Revision="2.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2022-05-13T19:57:08.674Z" CreatedBy="IFM\ifmengineer" EditedDate="2022-08-29T18:48:10.265Z" EditedBy="IFM\ifmengineer" SoftwareRevision="v32.02"><RevisionNote><![CDATA[5/2022:updated to current AOI standards:LH]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[Reference the Input Controller tag <IOLinkMasterName>:I1.Data]]></Description></Parameter><Parameter Name="Port_Process_Data_Size" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value from the Configuration Controller tag <IOLinkMasterName>:C.Port_Process_Data_Size]]></Description><DefaultData Format="L5K"><![CDATA[4]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="4" /></DefaultData></Parameter><Parameter Name="Port_Number" TagType="Base" DataType="SINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[User Input Value = Port number of the IO-Link Master]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Vendor_ID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value indicating the manufacturer of the IO-Link Device. ifm=310 dec]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_ID" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Read only value set by the manufacturer of the device. Varies by product family]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Port is configured for IO-Link Communication. False: Port is not configured for IO-Link Communication]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_Not_Connected" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: No IO-Link Device is connected
False: IO-Link Device is connected]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Invalid_Data" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Data is invalid False: IO-Link Data is valid]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Wrong_VID_DID" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: Vendor ID and/or Device ID does not match the configured VID or DID set in Configuration Controller Tag(s) <IOLink MasterName>:C.Vendor_ID_Port_n or ...C.Device_ID_Port_n]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Diagnostic_Avail" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[True: IO-Link Event data is available False: No Event data is present]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="AOI_Settings_Error" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[A user input is out of range. Check port process data size and port number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Gradient" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Gradient Value as specified by the IO-Link Device Description pdf]]></Description><DefaultData Format="L5K"><![CDATA[1.00000000e-001]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.1" /></DefaultData></Parameter><Parameter Name="Temperature" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Current Temperature]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Data_Size" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Factor of the RealPort_Num to calcualated the Offset_Address]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_StatusFlgs" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[RealPort_Num+9]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="RealPort_Num" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of the Port_Number-1]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="StatusFlgs_Offset" DataType="SINT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_StatusFlgs+23]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="SINT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Offset_Address" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Data_Size*RealPort_Number]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Process_Offset" DataType="INT" Radix="Decimal" ExternalAccess="None"><Description><![CDATA[Result of Offset_Address+95(8port Master) or Offset_Address+59(4port Master). Used to indicate the word offset for where the IO-Link device’s process input data starts]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[Calculate Data_Size depending on Port_Process_Data_Size input by the user]]></Comment><Text><![CDATA[[EQ(Port_Process_Data_Size,0) MOVE(1,Data_Size) ,EQ(Port_Process_Data_Size,1) MOVE(2,Data_Size) ,EQ(Port_Process_Data_Size,2) MOVE(4,Data_Size) ,EQ(Port_Process_Data_Size,3) MOVE(8,Data_Size) ,EQ(Port_Process_Data_Size,4) MOVE(16,Data_Size) ];]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[If the user input Port_Number <= to the maximum number of ports on the IO-Link master (4 or 8) and the Port_Number != to 0 then 
calculate the Process_Offset  (if process input data is produced by the IO-Link Device) and/or calculate the Process_Value_Offset (if process output data is consumed by the IO-Link Device). 
Parallel to the Calculation of the Process_Offset and/or Process_Value_Offset calculate the value of the StatusFlgs_Offset
]]></Comment><Text><![CDATA[LE(Port_Number,8)GT(Port_Number,0)SUB(Port_Number,1,RealPort_Num)[MUL(Data_Size,RealPort_Num,Offset_Address) ADD(Offset_Address,95,Process_Offset) ,MUL(9,RealPort_Num,Offset_StatusFlgs) ADD(Offset_StatusFlgs,23,StatusFlgs_Offset) ];]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[Sets states of IOL_Mode, Device_Not_Connected, Invalid_Data, Wrong_VID_DID and Diagnostic Available and set the values for the Vendor ID and Device ID from the Controller input tags of the user input Port_Number
]]></Comment><Text><![CDATA[[XIC(PLC_Input[StatusFlgs_Offset].0) OTE(IOL_Mode) ,XIC(PLC_Input[StatusFlgs_Offset].1) OTE(Device_Not_Connected) ,XIC(PLC_Input[StatusFlgs_Offset].2) OTE(Invalid_Data) ,XIC(PLC_Input[StatusFlgs_Offset].3) OTE(Wrong_VID_DID) ,XIC(PLC_Input[StatusFlgs_Offset].7) OTE(Diagnostic_Avail) ,MOVE(PLC_Input[StatusFlgs_Offset+1],Vendor_ID) ,COP(PLC_Input[StatusFlgs_Offset+2],Device_ID,1) ];]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[Set the State of AOI_Setting_Error by verifying the user input setting of Port_Number and Port_Process_Data_Size is within range of the IO-Link Master. GRT instruction for Port_Number compares to value=8 for 8 port masters and =4 for 4 port masters]]></Comment><Text><![CDATA[[LE(Port_Number,0) ,GT(Port_Number,8) ,LT(Port_Process_Data_Size,0) ,GT(Port_Process_Data_Size,4) ]OTE(AOI_Settings_Error);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[MUL(PLC_Input[Process_Offset],Gradient,Temperature);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="TwoWay_AnalogueLineator" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2014-05-21T17:08:16.083Z" CreatedBy="KNOBLESDORFF\Administrator" EditedDate="2025-10-13T14:58:40.633Z" EditedBy="AzureAD\AndrewJenkins" SoftwareRevision="v36.02"><RevisionNote><![CDATA[Knobelsdorf 2023]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only" /><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only" /><Parameter Name="par_ZeroCrossingEnable" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[Keep output on until actual position crosses target position, then apply tolerance deadband]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="par_AnalogCloseTol" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[if o_Position is lower than this the valve is considered close]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="par_AlwaysReadjust" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[Always iniate a movement on SP change or release, even if the position is in tolerance]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="