<AddOnInstructionDefinition Name="SMxx0x_8PORT_Config" Class="Standard" Revision="1.1" Vendor="ifm efector" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2015-07-10T14:51:45.136Z" CreatedBy="EFECTOR\usliyu" EditedDate="2021-10-26T12:07:26.975Z" EditedBy="IFM\ifmengineer" SoftwareRevision="v32.02"><RevisionNote><![CDATA[10/21: Corrected Cmd1 Reset, FlowGrad for DID 570 and 671 & Added Factory Reset]]></RevisionNote><Parameters><Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Input - System Defined Parameter]]></Description></Parameter><Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Enable Output - System Defined Parameter]]></Description></Parameter><Parameter Name="PLC_Input" TagType="Base" DataType="INT" Dimensions="223" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[Input array of the IO-Link Master]]></Description></Parameter><Parameter Name="IOL_Mode" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[If active the IO-Link master port is expecting and IO-Link device connected.]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="PLC_Output" TagType="Base" DataType="INT" Dimensions="151" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[Output Array of the IO-Link Master]]></Description></Parameter><Parameter Name="TimeOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"><Description><![CDATA[Activate if Timeout1 or 2 is met]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="IOLinkMaster_Name" TagType="Base" DataType="DINT" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"><Description><![CDATA[DINT assigned by User. Every IO-Link device's AOI that are on the same master should have the same IOLinkMaster_Name. Controls the AL1x2x_Cmd_Rdy output bit.]]></Description></Parameter><Parameter Name="Port_Process_Data_Size" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><Description><![CDATA[Value from the Configuration Controller tag of the IO-Link master. By default=4 by eds file.]]></Description><DefaultData Format="L5K"><![CDATA[4]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="4" /></DefaultData></Parameter><Parameter Name="Port_Number" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Port number in which the IO-Link device is connected]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Vendor_ID" TagType="Base" DataType="INT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="Device_ID" TagType="Base" DataType="DINT" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[573: SM7001, SM7601
570: SM6001, SM6601
569: SM6000, SM6100, SM6400, SM6500,
390: SM2001, SM2601
671: SM4000, SM4100
392: SM9001, SM9601
576: SM8001, SM8601]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="FlowRate" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="Temperature" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="FlowTotalizer" TagType="Base" DataType="REAL" Usage="Output" Radix="Float" Required="false" Visible="true" ExternalAccess="Read Only"><Description><![CDATA[Flow Totatlizer Value]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="SP1_Flow" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Flow rate for Switch Point 1]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="rp1_Flow" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Flow rate reset of Switch Point 1]]></Description><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></Parameter><Parameter Name="OU1" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[(5) Fno / Window fct normally open (6) Fnc / Window fct normally closed]]></Description><DefaultData Format="L5K"><![CDATA[3]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="INT" Radix="Decimal" Value="3" /></DefaultData></Parameter><Parameter Name="SEL2" TagType="Base" DataType="INT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><Description><![CDATA[Set Hi for to select SP2 to be flow
