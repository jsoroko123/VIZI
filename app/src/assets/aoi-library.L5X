 ]]></Comment><Text><![CDATA[LBL(ParBlend_ExecuteBinChangeBins)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)[OTL(BinControl.BinList[tmp_IndexBin].o_Active) OTU(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,MOVE(BinControl.Recipe.Ingr[tmp_IndexIngr].TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,ADD(BinControl.Plc.o_ActiveBinCount,1,BinControl.Plc.o_ActiveBinCount) ,[XIC(BinControl.Plc.ParSender) XIC(BinControl.BinList[tmp_IndexBin].i_LowLevel) OTL(BinControl.Plc.o_Empty) ,XIC(BinControl.Plc.ParReceiver) XIC(BinControl.BinList[tmp_IndexBin].i_HighLevel) OTL(BinControl.Plc.o_Full) ,XIC(BinControl.BinList[tmp_IndexBin].i_Lock) OTL(BinControl.Plc.o_Empty) OTL(BinControl.Plc.o_Full) ] ,JMP(ParBlend_BinChangeNextIngr) ];]]></Text></Rung><Rung Number="67" Type="N"><Text><![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_ExecuteBinChangeBins) ];]]></Text></Rung><Rung Number="68" Type="N"><Text><![CDATA[LBL(ParBlend_BinChangeNextIngr)[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) MOVE(0,tmp_IndexBin) JMP(ParBlend_ExecuteBinChangeBins) ];]]></Text></Rung><Rung Number="69" Type="N"><Comment><![CDATA[If not available bin is found, Set NoValidBin output
 
