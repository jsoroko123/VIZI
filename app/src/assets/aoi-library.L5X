5_12_2021]]></Comment><Text><![CDATA[XIC(MOTOR.PAR.E300_ENABLE)[XIC(IFILE.TripPresent) OTE(MOTOR.E300.TRIP_PRESENT) ,XIC(MOTOR.E300.TRIP_RESET) OTE(OFILE.TripReset) ,DIV(IFILE.AvgCurrent,100,MOTOR.MOTOR_AMPS) DIV(CFILE.FLA1,100,MOTOR.E300.FLA) MOVE(MOTOR.E300.FLA,MOTOR.PAR.MotorFLA) DIV(IFILE.AvgCurrent,100,MOTOR.E300.AVG_CURRENT) DIV(IFILE.AvgPercentFLA,10,MOTOR.E300.AVG_CURRENT_PERCENT) MOVE(IFILE.PercentTCU,MOTOR.E300.THERMAL_TCU) MOVE(CFILE.TripClass,MOTOR.E300.TRIP_CLASS) ,XIC(OFILE.Pt00Data) OTE(MOTOR.E300.OUTPUT_0) ,XIC(OFILE.Pt01Data) OTE(MOTOR.E300.OUTPUT_1) ,XIC(OFILE.Pt02Data) OTE(MOTOR.E300.OUTPUT_2) ,XIC(IFILE.Pt00Data) OTE(MOTOR.E300.INPUT_0) ,XIC(IFILE.Pt01Data) OTE(MOTOR.E300.INPUT_1) ,XIC(IFILE.Pt02Data) OTE(MOTOR.E300.INPUT_2) ,XIC(IFILE.Pt03Data) OTE(MOTOR.E300.INPUT_3) ,XIC(MOTOR.PAR.E300_ENABLE) XIC(MOTOR.E300.TRIP_PRESENT) XIC(ALARM_CLEAR_FROM_WW) OTE(MOTOR.E300.TRIP_RESET) ];]]></Text></Rung><Rung Number="29" Type="N"><Comment><![CDATA[OUTPUT TO SHOW ON THE AOI
