CDATA[]]></Line><Line Number="90"><![CDATA[ELSE]]></Line><Line Number="91"><![CDATA[]]></Line><Line Number="92"><![CDATA[Sim_TriggerRamp := 0 ;]]></Line><Line Number="93"><![CDATA[Sim_ArrayValue := 0 ;]]></Line><Line Number="94"><![CDATA[]]></Line><Line Number="95"><![CDATA[END_IF ;]]></Line><Line Number="96"><![CDATA[]]></Line><Line Number="97"><![CDATA[SimAnalog(SimSimAnalog, Sim_Amperage, i_LastScan, o_Amperage) ;]]></Line><Line Number="98"><![CDATA[]]></Line><Line Number="99"><![CDATA[(*]]></Line><Line Number="100"><![CDATA[*)]]></Line><Line Number="101"><![CDATA[Sim_PulseTimer.PRE := Sim_PulseTime * 1000 ;]]></Line><Line Number="102"><![CDATA[Sim_PulseTimer.TimerEnable := 1 ;]]></Line><Line Number="103"><![CDATA[RTOR(Sim_PulseTimer) ;]]></Line><Line Number="104"><![CDATA[Sim_PulseTimer.Reset := 0 ;]]></Line><Line Number="105"><![CDATA[]]></Line><Line Number="106"><![CDATA[IF Sim_PulseTimer.DN THEN]]></Line><Line Number="107"><![CDATA[]]></Line><Line Number="108"><![CDATA[Sim_PulseTimer.Reset := 1 ;]]></Line><Line Number="109"><![CDATA[]]></Line><Line Number="110"><![CDATA[END_IF ;]]></Line><Line Number="111"><![CDATA[]]></Line><Line Number="112"><![CDATA[END_IF ;]]></Line><Line Number="113"><![CDATA[]]></Line><Line Number="114"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="115"><![CDATA[' Scale The Amperage Input]]></Line><Line Number="116"><![CDATA[']]></Line><Line Number="117"><![CDATA[******************************************************************************************************************************************************)]]></Line><Line Number="118"><![CDATA[IF NOT i_SimulateEnabled THEN]]></Line><Line Number="119"><![CDATA[Scaling(ScaleAmps, o_Amperage, i_AmperageRaw, i_ScaleMin, i_ScaleMax, i_RawMin, i_RawMax);]]></Line><Line Number="120"><![CDATA[AnalogFilter(OutputFilter,o_Amperage,o_Amperage);]]></Line><Line Number="121"><![CDATA[If o_Amperage < 0 Then]]></Line><Line Number="122"><![CDATA[o_Amperage := 0;]]></Line><Line Number="123"><![CDATA[End_If;]]></Line><Line Number="124"><![CDATA[END_IF ;]]></Line><Line Number="125"><![CDATA[]]></Line><Line Number="126"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="127"><![CDATA[' Amp Alarming Logic, A]]></Line><Line Number="128"><![CDATA[' larm Needs The Reset To Clear]]></Line><Line Number="129"><![CDATA[']]></Line><Line Number="130"><![CDATA[******************************************************************************************************************************************************)]]></Line><Line Number="131"><![CDATA[SetpointMultiplier := i_AlarmPercentageSetpoint / 100;]]></Line><Line Number="132"><![CDATA[o_CurrentAlarmSetpoint := MaxAmps * SetpointMultiplier;]]></Line><Line Number="133"><![CDATA[CurrentAlarmTimer.PRE := i_CurrentAlarmTimerPreset * 1000;]]></Line><Line Number="134"><![CDATA[If i_Running Then]]></Line><Line Number="135"><![CDATA[If o_CurrentAlarmSetpoint <= o_Amperage Then]]></Line><Line Number="136"><![CDATA[CurrentAlarmTimer.TimerEnable := 1;]]></Line><Line Number="137"><![CDATA[End_If;]]></Line><Line Number="138"><![CDATA[End_If;]]></Line><Line Number="139"><![CDATA[If o_CurrentAlarm and i_Reset Then]]></Line><Line Number="140"><![CDATA[CurrentAlarmTimer.Reset := 1;]]></Line><Line Number="141"><![CDATA[o_CurrentAlarm := 0;]]></Line><Line Number="142"><![CDATA[End_If;]]></Line><Line Number="143"><![CDATA[TONR(CurrentAlarmTimer);]]></Line><Line Number="144"><![CDATA[If CurrentAlarmTimer.DN Then]]></Line><Line Number="145"><![CDATA[o_CurrentAlarm := 1;]]></Line><Line Number="146"><![CDATA[End_If;]]></Line><Line Number="147"><![CDATA[CurrentAlarmTimer.TimerEnable := 0;]]></Line><Line Number="148"><![CDATA[CurrentAlarmTimer.Reset := 0;]]></Line><Line Number="149"><![CDATA[]]></Line><Line Number="150"><![CDATA[(******************************************************************************************************************************************************]]></Line><Line Number="151"><![CDATA[' Amp Warning Logic, ]]></Line><Line Number="152"><![CDATA[' Warning Clears Itself]]></Line><Line Number="153"><![CDATA[']]></Line><Line Number="154"><![CDATA[******************************************************************************************************************************************************)]]></Line><Line Number="155"><![CDATA[SetpointMultiplier := i_WarningPercentageSetpoint / 100;]]></Line><Line Number="156"><![CDATA[o_CurrentWarningSetpoint := MaxAmps * SetpointMultiplier;]]></Line><Line Number="157"><![CDATA[CurrentWarningTimer.PRE := i_CurrentWarningTimerPreset * 1000;]]></Line><Line Number="158"><![CDATA[If i_Running AND o_CurrentWarningSetpoint <= o_Amperage Then]]></Line><Line Number="159"><![CDATA[CurrentWarningTimer.TimerEnable := 1;]]></Line><Line Number="160"><![CDATA[Else]]></Line><Line Number="161"><![CDATA[CurrentWarningTimer.Reset := 1;]]></Line><Line Number="162"><![CDATA[End_If;]]></Line><Line Number="163"><![CDATA[TONR(CurrentWarningTimer);]]></Line><Line Number="164"><![CDATA[o_CurrentWarning := CurrentWarningTimer.DN;]]></Line><Line Number="165"><![CDATA[CurrentWarningTimer.TimerEnable := 0;]]></Line><Line Number="166"><![CDATA[CurrentWarningTimer.Reset := 0;]]></Line><Line Number="167"><![CDATA[(* end *)]]></Line></STContent></Routine></Routines></AddOnInstructionDefinition>
