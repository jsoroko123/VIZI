1=ON DELAY IS TIMING NO INPUT YET
2=RUNNING IN GOOD STATE
3=MOTOR OFF STILL GETTING INPUT]]></Description><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="ALARMDELAY" DataType="TIMER" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[[0,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[XIC(MOTORRUNNING)TON(ALARMDELAY,?,?);]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIC(SPEED_SWITCH_I_O)OTE(SPEED_SWITCH_INPUT);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[[XIO(MOTORRUNNING) MOVE(0,SWITCH_STATE_FOR_HMI) ,XIC(MOTORRUNNING) XIC(ALARMDELAY.TT) XIO(SPEED_SWITCH_INPUT) MOVE(1,SWITCH_STATE_FOR_HMI) ,XIC(MOTORRUNNING) XIC(ALARMDELAY.DN) XIC(SPEED_SWITCH_INPUT) MOVE(2,SWITCH_STATE_FOR_HMI) ,XIO(MOTORRUNNING) XIC(SPEED_SWITCH_INPUT) MOVE(3,SWITCH_STATE_FOR_HMI) ];]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[[XIC(ALARMDELAY.DN) XIC(MOTORRUNNING) XIO(SPEED_SWITCH_INPUT) ,XIC(ALARM_FOR_WW) XIO(ALARM_CLEAR_FROM_WW) ][XIO(ALARM_SILENCE) OTE(ALARM_HORN) ,OTE(ALARM_FOR_WW) ,[XIC(ALARM_SILENCE_FROM_WW) ,XIC(ALARM_SILENCE) ] OTE(ALARM_SILENCE) ];]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[MOVE(ALARMDELAYPRE,ALARMDELAY.PRE) MOVE(ALARMDELAY.ACC,ALARMDELAYACC) ,XIC(ALARMDELAY.EN) OTE(ALARMDELAYEN) ,XIC(ALARMDELAY.TT) OTE(ALARMDELAYTT) ,XIC(ALARMDELAY.DN) OTE(ALARMDELAYDN) ];]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
  </Controller>
