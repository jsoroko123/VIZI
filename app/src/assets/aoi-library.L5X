"Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="SimDecreaseTMR" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,100,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="100" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="SimIncreaseTMR" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,100,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="100" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="inDeadband_DEL" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="PosToleranceMin" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag><LocalTag Name="PosToleranceMax" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag><LocalTag Name="Mov1_Req" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Mov2_Req" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="i_PositionTarget_lastscan" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag><LocalTag Name="PositionTarget_diff" DataType="REAL" Radix="Float" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0.00000000e+000]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="REAL" Radix="Float" Value="0.0" /></DefaultData></LocalTag><LocalTag Name="ReleaseMovement" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="ReleaseMovement_ONS" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="TargetCrossed" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[|==================================================|
 Analogue
 Two Way
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIC(S:FS)OTU(o_CmdTowardsPos1)OTU(o_CmdTowardsPos2);]]></Text></Rung><Rung Number="2" Type="N"><Comment><![CDATA[|==================================================|
 Mode Control
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[XIO(Disabled)XIC(HMI_ModeStatus.4)OTL(HMI_Control.2)OTU(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[XIC(HMI_Control.1)OTL(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIC(HMI_Control.2)OTU(HMI_ModeStatus.1)OTL(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[XIC(HMI_Control.3)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTL(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[[[XIC(HMI_Control.10) OTL(Disabled) ,XIC(HMI_Control.10) XIC(Disable_FlipFlop) OTU(Disabled) ] ,XIO(HMI_Control.10) XIC(Disabled) OTE(Disable_FlipFlop) ];]]></Text></Rung><Rung Number="8" Type="N"><Text><![CDATA[XIC(Disabled)OTE(o_Disabled)OTU(HMI_Control.4)OTU(HMI_Control.5)OTU(HMI_Control.6)OTU(HMI_Control.7)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3)OTL(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="9" Type="N"><Comment><![CDATA[|==================================================|
 Postion Logic
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="10" Type="N"><Text><![CDATA[XIC(i_SimulateEnabled)OTE(o_Simulated);]]></Text></Rung><Rung Number="11" Type="N"><Text><![CDATA[XIO(o_Simulated)XIO(i_Force)MOVE(inp_Position,o_Position);]]></Text></Rung><Rung Number="12" Type="N"><Text><![CDATA[[XIC(o_Simulated) ,XIC(i_Force) ][XIC(outp_Pos1Cmd) XIO(o_stInPos1) OTE(PosSimDecrease) ,XIC(outp_Pos2Cmd) XIO(o_stInPos2) OTE(PosSimIncrease) ];]]></Text></Rung><Rung Number="13" Type="N"><Text><![CDATA[[XIC(o_Simulated) ,XIC(i_Force) ][XIC(PosSimDecrease) TON(SimDecreaseTMR,?,?) XIC(SimDecreaseTMR.DN) SUB(o_Position,i_SimDecreaseMul,o_Position) LT(o_Position,0) MOVE(0,o_Position) ,XIC(PosSimIncrease) TON(SimIncreaseTMR,?,?) XIC(SimIncreaseTMR.DN) ADD(o_Position,i_SimAdditionMul,o_Position) GT(o_Position,100) MOVE(100,o_Position) ];]]></Text></Rung><Rung Number="14" Type="N"><Comment><![CDATA[Check for inpPos2 (open)]]></Comment><Text><![CDATA[[XIC(inp_Pos2LimitSwitch) ,GT(o_Position,par_AnalogCloseTol) XIC(o_InPosition) ]XIO(inp_Pos1LimitSwitch)OTE(o_stInPos2);]]></Text></Rung><Rung Number="15" Type="N"><Comment><![CDATA[Check for inpPos1 (close)]]></Comment><Text><![CDATA[[XIC(inp_Pos1LimitSwitch) ,XIO(par_LSOnlyForInPos1) LE(o_Position,par_AnalogCloseTol) ]XIO(inp_Pos2LimitSwitch)OTE(o_stInPos1);]]></Text></Rung><Rung Number="16" Type="N"><Comment><![CDATA[|==================================================|
 Fault Handling
 |==================================================|
 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="17" Type="N"><Text><![CDATA[[[XIO(i_LocalMode) ,XIC(par_AllowLocalModeFaulting) ] [XIO(o_Pos1Fault) XIC(ReleaseMovement) ,XIC(i_InterlockType) ] LE(o_PositionTarget,par_AnalogCloseTol) XIO(o_stInPos1) MOVE(i_Pos1TimerPre,InternalFaultDelay_Timer[0].PRE) TON(InternalFaultDelay_Timer[0],?,?) ,[XIC(InternalFaultDelay_Timer[0].DN) ,XIC(o_Pos1Fault) XIO(i_FaultReset) XIO(HMI_EquipmentReset) ] OTE(o_Pos1Fault) ];]]></Text></Rung><Rung Number="18" Type="N"><Text><![CDATA[[[XIO(i_LocalMode) ,XIC(par_AllowLocalModeFaulting) ] XIO(o_Pos2Fault) XIC(ReleaseMovement) [XIC(outp_Pos2Cmd) ,GT(o_PositionTarget,par_AnalogCloseTol) XIO(o_InPosition) ] MOVE(i_Pos2TimerPre,InternalFaultDelay_Timer[1].PRE) TON(InternalFaultDelay_Timer[1],?,?) ,[XIC(InternalFaultDelay_Timer[1].DN) ,XIC(o_Pos2Fault) XIO(i_FaultReset) XIO(HMI_EquipmentReset) ] OTE(o_Pos2Fault) ];]]></Text></Rung><Rung Number="19" Type="N"><Text><![CDATA[[XIC(i_FaultPresent) ,XIC(o_Pos1Fault) ,XIC(o_Pos2Fault) ]OTE(o_stFaultPresent)ONS(ONS)OTL(o_Horn);]]></Text></Rung><Rung Number="20" Type="N"><Text><![CDATA[XIC(o_ResetExternalFaults)OTU(o_ResetExternalFaults);]]></Text></Rung><Rung Number="21" Type="N"><Text><![CDATA[[XIC(i_HornReset) ,[XIC(i_FaultReset) ,XIC(HMI_EquipmentReset) ] OTL(o_ResetExternalFaults) ]OTU(o_Horn);]]></Text></Rung><Rung Number="22" Type="N"><Comment><![CDATA[|==================================================|
 Commodity and Route
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="23" Type="N"><Text><![CDATA[NE(i_RouteID,0)OTE(o_Owned);]]></Text></Rung><Rung Number="24" Type="N"><Text><![CDATA[[XIC(S:FS) ,XIC(i_ClearProduct) ]OTL(Cleanout.DN);]]></Text></Rung><Rung Number="25" Type="N"><Text><![CDATA[[XIC(i_Feed) ,XIO(Cleanout.DN) ]MOVE(i_DirtyDelayTimerPre,DirtyDelay.PRE)TON(DirtyDelay,?,?)XIC(DirtyDelay.DN)[OTE(o_Dirty) ,MOVE(i_Commodity,Commodity) ];]]></Text></Rung><Rung Number="26" Type="N"><Text><![CDATA[[XIC(o_Dirty) ,XIC(Cleanout.DN) ]XIO(i_Feed)[MOVE(i_CleanoutTimerPre,Cleanout.PRE) TON(Cleanout,?,?) ,XIC(Cleanout.DN) MOVE(0,Commodity) ];]]></Text></Rung><Rung Number="27" Type="N"><Text><![CDATA[CPT(o_CleanoutTimeRemaining,(Cleanout.PRE - Cleanout.ACC));]]></Text></Rung><Rung Number="28" Type="N"><Comment><![CDATA[|==================================================|
 Interlock
 |==================================================|]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="29" Type="N"><Text><![CDATA[[[XIO(i_LocalMode) [XIC(HMI_ModeStatus.1) XIC(i_AutoEnable) [XIC(i_EquipmentPermissive) ,XIC(ReleaseMovement) ] XIC(i_EquipmentInterlock) ,XIC(HMI_ModeStatus.2) [XIC(i_InterlocksEnableInManual) XIC(i_EquipmentInterlock) ,XIO(i_InterlocksEnableInManual) ] ] XIO(o_stFaultPresent) ,XIC(i_LocalMode) ] OTE(ReleaseMovement) ,XIO(ReleaseMovement) OTE(o_Waiting) ];]]></Text></Rung><Rung Number="30" Type="N"><Comment><![CDATA[Commands
 ]]></Comment><Text><![CDATA[[XIO(i_LocalMode) [XIC(HMI_ModeStatus.1) XIC(i_AutoEnable) XIC(i_EquipmentInterlock) XIC(i_EquipmentPermissive) [MOVE(i_PositionRequest,o_PositionTarget) ,XIC(i_AutoPos2) MOVE(100,o_PositionTarget) ,XIC(i_AutoPos1) MOVE(0,o_PositionTarget) ] ,XIO(HMI_ModeStatus.1) [XIC(HMI_Control.6) MOVE(i_PositionRequest,o_PositionTarget) OTU(HMI_Control.6) ,XIC(HMI_Control.4) MOVE(0,o_PositionTarget) OTU(HMI_Control.4) ,XIC(HMI_Control.5) MOVE(100,o_PositionTarget) OTU(HMI_Control.5) ,XIC(HMI_Control.7) MOVE(o_Position,o_PositionTarget) OTU(HMI_Control.7) ] ,XIC(i_InterlockType) XIC(o_stFaultPresent) MOVE(0,o_PositionTarget) ] ,XIC(i_LocalMode) MOVE(o_Position,i_PositionRequest) MOVE(o_Position,o_PositionTarget) ];]]></Text></Rung><Rung Number="31" Type="N"><Text><![CDATA[SUB(o_PositionTarget,i_Tolerance,PosToleranceMin)ADD(o_PositionTarget,i_Tolerance,PosToleranceMax);]]></Text></Rung><Rung Number="32" Type="N"><Text><![CDATA[[XIO(i_LocalMode) [NE(o_PositionTarget,i_PositionTarget_lastscan) ,XIC(ReleaseMovement) ONS(ReleaseMovement_ONS) ] [LIMIT(PosToleranceMax,o_Position,PosToleranceMin) ,XIC(par_AlwaysReadjust) ] OTU(TargetCrossed) SUB(o_PositionTarget,o_Position,PositionTarget_diff) [LE(PositionTarget_diff,0) [OTL(o_CmdTowardsPos1) ,OTU(o_CmdTowardsPos2) ] ,GE(PositionTarget_diff,0) [OTU(o_CmdTowardsPos1) ,OTL(o_CmdTowardsPos2) ] ] ,MOVE(o_PositionTarget,i_PositionTarget_lastscan) ];]]></Text></Rung><Rung Number="33" Type="N"><Text><![CDATA[XIC(par_ZeroCrossingEnable)[XIC(o_CmdTowardsPos1) LE(o_Position,o_PositionTarget) ,XIC(o_CmdTowardsPos2) GE(o_Position,o_PositionTarget) ]OTL(TargetCrossed);]]></Text></Rung><Rung Number="34" Type="N"><Text><![CDATA[[XIO(i_LocalMode) ,XIC(i_LocalMode) XIO(i_LocalModeCmdPos2) XIO(i_LocalModeCmdPos2) OTL(TargetCrossed) ][[XIO(par_ZeroCrossingEnable) ,XIC(par_ZeroCrossingEnable) XIC(TargetCrossed) ] LIMIT(PosToleranceMin,o_Position,PosToleranceMax) ,XIC(par_LimitSwitchesUsedForInPosition) [LE(o_PositionTarget,par_AnalogCloseTol) XIC(inp_Pos1LimitSwitch) ,GE(o_PositionTarget,100) XIC(inp_Pos2LimitSwitch) ] ]OTE(o_InPosition);]]></Text></Rung><Rung Number="35" Type="N"><Text><![CDATA[[XIC(o_InPosition) ,XIO(ReleaseMovement) ,XIC(i_LocalMode) ]OTU(o_CmdTowardsPos2)OTU(o_CmdTowardsPos1);]]></Text></Rung><Rung Number="36" Type="N"><Text><![CDATA[[[[XIC(HMI_ModeStatus.1) XIC(i_AutoEnable) ,XIO(HMI_ModeStatus.1) ] XIC(o_CmdTowardsPos1) XIO(i_AutoPos2) ,XIC(i_LocalMode) XIC(i_LocalModeCmdPos1) ] [XIC(ReleaseMovement) ,XIC(HMI_ModeStatus.3) ] ,XIO(i_LocalMode) XIO(ReleaseMovement) XIC(i_InterlockType) ][XIO(o_stInPos1) ,XIC(i_MaintainOutputEnabled) ]XIO(outp_Pos2Cmd)XIO(Disabled)OTE(outp_Pos1Cmd);]]></Text></Rung><Rung Number="37" Type="N"><Text><![CDATA[[[XIC(HMI_ModeStatus.1) XIC(i_AutoEnable) ,XIO(HMI_ModeStatus.1) ] XIC(o_CmdTowardsPos2) ,XIC(i_LocalMode) XIC(i_LocalModeCmdPos2) ][XIC(ReleaseMovement) ,XIC(HMI_ModeStatus.3) ][XIO(o_stInPos2) ,XIC(i_MaintainOutputEnabled) ]XIO(outp_Pos1Cmd)XIO(Disabled)OTE(outp_Pos2Cmd);]]></Text></Rung><Rung Number="38" Type="N"><Text><![CDATA[XIO(o_stInPos1)XIO(o_stInPos2)[XIC(outp_Pos1Cmd) OTE(o_stInMotiontoPos1) ,XIC(outp_Pos2Cmd) OTE(o_stInMotiontoPos2) ];]]></Text></Rung><Rung Number="39" Type="N"><Text><![CDATA[XIO(o_stInMotiontoPos1)XIO(o_stInMotiontoPos2)XIO(o_stFaultPresent)XIO(o_stInPos1)XIO(o_stInPos2)OTE(o_stNoPosition);]]></Text></Rung><Rung Number="40" Type="N"><Comment><![CDATA[HMI_States]]></Comment><Text><![CDATA[[XIC(o_stInPos1) MOVE(1,HMI_State) ,XIC(o_stInPos2) MOVE(2,HMI_State) ,XIC(o_stNoPosition) MOVE(4,HMI_State) ,XIC(o_stInMotiontoPos1) MOVE(8,HMI_State) ,XIC(o_stInMotiontoPos2) MOVE(16,HMI_State) ,XIC(o_stFaultPresent) MOVE(32,HMI_State) ];]]></Text></Rung><Rung Number="41" Type="N"><Comment><![CDATA[|==================================================|
 Reset HMI Commands
 |==================================================|
 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="42" Type="N"><Text><![CDATA[OTU(HMI_Control.1)OTU(HMI_Control.2)OTU(HMI_Control.3)OTU(HMI_Control.4)OTU(HMI_Control.5)OTU(HMI_Control.6)OTU(HMI_Control.7)OTU(HMI_Control.10)OTU(i_ClearProduct)OTU(HMI_EquipmentReset);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
