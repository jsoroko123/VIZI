ated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="i_SimulateEnabled" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Horn" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Owned" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Dirty" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Disabled" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Simulated" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Waiting" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="o_Idling" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter><Parameter Name="outp_FaultReset" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read/Write"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></Parameter></Parameters><LocalTags><LocalTag Name="Ons_Horn" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="MonTimer" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="FaultResetTimer" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,1000,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="1000" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="Disabled" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="Disable_FlipFlop" DataType="BOOL" Radix="Decimal" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[0]]></DefaultData><DefaultData Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0" /></DefaultData></LocalTag><LocalTag Name="DelayFaultTimer" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag><LocalTag Name="CleanOutTimer" DataType="TIMER" ExternalAccess="None"><DefaultData Format="L5K"><![CDATA[[0,0,0]]]></DefaultData><DefaultData Format="Decorated"><Structure DataType="TIMER"><DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0" /><DataValueMember Name="EN" DataType="BOOL" Value="0" /><DataValueMember Name="TT" DataType="BOOL" Value="0" /><DataValueMember Name="DN" DataType="BOOL" Value="0" /></Structure></DefaultData></LocalTag></LocalTags><Routines><Routine Name="Logic" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment><![CDATA[COPYRIGHT: KE Knobelsdorff - keway.com
 
 TwoWay_VGC Element
 
 Version 1.0
 
 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="1" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Set Timer Values
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[MOVE(i_MonTime,MonTimer.PRE)MOVE(i_DelayFaultTime,DelayFaultTimer.PRE)MOVE(i_CleanOutTime,CleanOutTimer.PRE);]]></Text></Rung><Rung Number="3" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Disable Push Button
 Flip/Flop
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[[[XIC(HMI_Control.10) OTL(Disabled) ,XIC(HMI_Control.10) XIC(Disable_FlipFlop) OTU(Disabled) ] ,XIO(HMI_Control.10) XIC(Disabled) OTE(Disable_FlipFlop) ];]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[XIC(Disabled)OTE(o_Disabled)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3)OTL(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="6" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Mode Control
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="7" Type="N"><Text><![CDATA[XIO(Disabled)XIC(HMI_ModeStatus.4)OTL(HMI_Control.2)OTU(HMI_ModeStatus.4);]]></Text></Rung><Rung Number="8" Type="N"><Text><![CDATA[XIC(HMI_Control.1)OTL(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="9" Type="N"><Text><![CDATA[XIC(HMI_Control.2)OTU(HMI_ModeStatus.1)OTL(HMI_ModeStatus.2)OTU(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="10" Type="N"><Text><![CDATA[XIC(HMI_Control.3)OTU(HMI_ModeStatus.1)OTU(HMI_ModeStatus.2)OTL(HMI_ModeStatus.3);]]></Text></Rung><Rung Number="11" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Equipment Owned
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="12" Type="N"><Text><![CDATA[XIC(i_Owned)OTE(o_Owned);]]></Text></Rung><Rung Number="13" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Equipment cleanout
 ----------------------------------------------------------------------------------------------------
 
 on first scan - complete clean timer.
 ----------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="14" Type="N"><Text><![CDATA[[XIC(S:FS) ,XIC(i_ClearProduct) ]OTL(CleanOutTimer.DN);]]></Text></Rung><Rung Number="15" Type="N"><Text><![CDATA[[XIC(i_Feed) ,XIO(CleanOutTimer.DN) ]OTE(o_Dirty);]]></Text></Rung><Rung Number="16" Type="N"><Text><![CDATA[[XIC(o_Dirty) ,XIC(CleanOutTimer.DN) ]XIO(i_Feed)TON(CleanOutTimer,?,?);]]></Text></Rung><Rung Number="17" Type="N"><Text><![CDATA[[XIC(o_Dirty) CPT(o_CleanoutTimeRemaining,(CleanOutTimer.PRE - CleanOutTimer.ACC)/1000) ,XIO(o_Dirty) MOVE(0,o_CleanoutTimeRemaining) ];]]></Text></Rung><Rung Number="18" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Fault Reset
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="19" Type="N"><Text><![CDATA[[XIC(i_FaultReset) ,XIC(HMI_Control.0) ,XIC(FaultResetTimer.TT) ][TON(FaultResetTimer,?,?) ,OTE(outp_FaultReset) ];]]></Text></Rung><Rung Number="20" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Position Request / Output
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="21" Type="N"><Text><![CDATA[[XIC(HMI_ModeStatus.1) NE(HMI_AutoPositionRequest,outp_PositionRequest) [XIO(i_EquipmentInterlock) ,XIO(i_EquipmentPermissive) ] ,XIC(HMI_ModeStatus.2) NE(HMI_ManualPositionRequest,outp_PositionRequest) XIC(i_InterlocksInHand) XIO(i_EquipmentInterlock) ]OTE(o_Waiting);]]></Text></Rung><Rung Number="22" Type="N"><Text><![CDATA[[XIC(HMI_ModeStatus.1) XIC(i_EquipmentInterlock) XIC(i_EquipmentPermissive) ,XIC(HMI_ModeStatus.2) [XIC(i_EquipmentInterlock) ,XIO(i_InterlocksInHand) ] XIC(HMI_Control.4) ]XIO(o_StFaultPresent)XIO(Disabled)[XIC(HMI_ModeStatus.1) MOVE(HMI_AutoPositionRequest,outp_PositionRequest) ,XIC(HMI_ModeStatus.2) MOVE(HMI_ManualPositionRequest,outp_PositionRequest) ];]]></Text></Rung><Rung Number="23" Type="N"><Comment><![CDATA[|==================================================|
 Local Control
 
 In Maintenance Mode
 Control Of The Distributor Is Moved From The PLC To 
 The Local VGC Controller
 |==================================================|]]></Comment><Text><![CDATA[XIC(HMI_ModeStatus.3)MOVE(0,outp_PositionRequest);]]></Text></Rung><Rung Number="24" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 State Conditions
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="25" Type="N"><Text><![CDATA[[XIO(i_Force) [XIC(DelayFaultTimer.DN) ,XIC(MonTimer.DN) ] ,XIC(o_StFaultPresent) XIO(outp_FaultReset) ]OTE(o_StFaultPresent);]]></Text></Rung><Rung Number="26" Type="N"><Text><![CDATA[[XIO(i_Force) XIO(o_Simulated) EQ(inp_Position,outp_PositionRequest) ,[XIC(o_Simulated) ,XIC(i_Force) ] ]XIO(o_StFaultPresent)OTE(o_StInPosition);]]></Text></Rung><Rung Number="27" Type="N"><Text><![CDATA[NE(inp_Position,outp_PositionRequest)XIO(o_StInPosition)XIO(o_StFaultPresent)OTE(o_StInTransition);]]></Text></Rung><Rung Number="28" Type="N"><Text><![CDATA[XIO(o_StFaultPresent)XIO(o_StInPosition)XIO(o_StInTransition)OTE(o_StNoPosition);]]></Text></Rung><Rung Number="29" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 HMI State Word
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="30" Type="N"><Text><![CDATA[[XIC(o_StInTransition) MOVE(1,HMI_State) ,XIC(o_StInPosition) MOVE(2,HMI_State) ,XIC(o_StNoPosition) MOVE(4,HMI_State) ,XIC(o_StFaultPresent) MOVE(16,HMI_State) ];]]></Text></Rung><Rung Number="31" Type="N"><Text><![CDATA[[XIO(i_Force) XIO(i_SimulateEnabled) [LIMIT(0,inp_Position,100) MOVE(inp_Position,HMI_Position) ,LIMIT(101,inp_Position,198) SUB(inp_Position,100,HMI_Position) ] ,[XIC(i_Force) ,XIC(i_SimulateEnabled) ] MOVE(outp_PositionRequest,HMI_Position) ];]]></Text></Rung><Rung Number="32" Type="N"><Text><![CDATA[XIC(i_SimulateEnabled)OTE(o_Simulated);]]></Text></Rung><Rung Number="33" Type="N"><Text><![CDATA[[XIC(o_StFaultPresent) ONS(Ons_Horn) OTL(o_Horn) ,[XIC(i_FaultReset) ,XIC(HMI_Control.0) ,XIC(i_HornReset) ] OTU(o_Horn) ];]]></Text></Rung><Rung Number="34" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Monitoring Timers
 ----------------------------------------------------------------------------------------------------]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="35" Type="N"><Text><![CDATA[[[NE(inp_Position,outp_PositionRequest) ,XIC(o_StInTransition) ,XIC(o_StNoPosition) ] XIO(HMI_ModeStatus.3) ,XIC(MonTimer.DN) ]XIO(outp_FaultReset)XIO(i_Force)XIO(i_SimulateEnabled)TON(MonTimer,?,?);]]></Text></Rung><Rung Number="36" Type="N"><Text><![CDATA[EQ(inp_Position,100)XIO(i_Force)XIO(i_SimulateEnabled)TON(DelayFaultTimer,?,?);]]></Text></Rung><Rung Number="37" Type="N"><Comment><![CDATA[----------------------------------------------------------------------------------------------------
 Reset HMI Commands
 ----------------------------------------------------------------------------------------------------
 ]]></Comment><Text><![CDATA[NOP();]]></Text></Rung><Rung Number="38" Type="N"><Text><![CDATA[OTU(HMI_Control.0)OTU(HMI_Control.1)OTU(HMI_Control.2)OTU(HMI_Control.3)OTU(HMI_Control.4)OTU(HMI_Control.10)OTU(i_ClearProduct);]]></Text></Rung></RLLContent></Routine></Routines></AddOnInstructionDefinition>
