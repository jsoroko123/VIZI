<![CDATA[XIC(Route_Group.o_Selected[Index])XIC(Group_Control.i_Hand[Index])[XIC(Group_Control.i_Fgr[Index]) OTL(Route_Group.Fgr.o_Hand) ,XIC(Group_Control.i_Mgr[Index]) OTL(Route_Group.Mgr.o_Hand) ,XIC(Group_Control.i_Wgr[Index]) OTL(Route_Group.Wgr.o_Hand) ,XIC(Group_Control.i_Ggr[Index]) OTL(Route_Group.Ggr.o_Hand) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[[XIC(Route_Group.o_Selected[Index]) ,XIC(Route_Group.o_SelectedIdle[Index]) ]XIC(Group_Control.i_Dirty[Index])XIO(Group_Control.o_Shared[Index])XIO(Route_Group.i_NotRelevantRunning[Index])[XIC(Group_Control.i_Fgr[Index]) OTL(Route_Group.Fgr.o_Dirty) ,XIC(Group_Control.i_Mgr[Index]) OTL(Route_Group.Mgr.o_Dirty) ,XIC(Group_Control.i_Wgr[Index]) OTL(Route_Group.Wgr.o_Dirty) ,XIC(Group_Control.i_Ggr[Index]) OTL(Route_Group.Ggr.o_Dirty) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[[XIC(Route_Group.o_Selected[Index]) ,XIC(Route_Group.o_SelectedIdle[Index]) ]XIC(Group_Control.i_Force[Index])[XIC(Group_Control.i_Fgr[Index]) OTL(Route_Group.Fgr.o_Force) ,XIC(Group_Control.i_Mgr[Index]) OTL(Route_Group.Mgr.o_Force) ,XIC(Group_Control.i_Wgr[Index]) OTL(Route_Group.Wgr.o_Force) ,XIC(Group_Control.i_Ggr[Index]) OTL(Route_Group.Ggr.o_Force) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Comment>
<![CDATA[Update OutSelectedIdle bits
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(Route_Group.o_SelectedIdle[Index])[XIO(Route_Group.o_Selected[Index]) [XIC(Group_Control.i_Stopped[Index]) ,XIC(Group_Control.o_Owned[Index]) ] ,XIC(Route_Group.o_Selected[Index]) ]OTU(Route_Group.o_SelectedIdle[Index]);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[ADD(Index,1,Index) ,LT(Index,Route_Group.ArrayLength) JMP(Gr_Loop) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[Cumilitive group status
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(Route_Group.Fgr.o_Running)XIC(Route_Group.Mgr.o_Running)XIC(Route_Group.Wgr.o_Running)XIC(Route_Group.Ggr.o_Running)OTE(Route_Group.All.o_Running);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(Route_Group.Fgr.o_Stopped)XIC(Route_Group.Mgr.o_Stopped)XIC(Route_Group.Wgr.o_Stopped)XIC(Route_Group.Ggr.o_Stopped)OTE(Route_Group.All.o_Stopped);]]>
</Text>
