<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Initialize flags
 
 ]]>
</Comment>
<Text>
<![CDATA[OTU(BinControl.Plc.o_Empty)OTU(BinControl.Plc.o_Full)OTU(BinControl.Plc.o_NoNextBin);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)MOVE(0,tmp_JobWeight)MOVE(0,tmp_JobWeight_Delta);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[If ParBlend, jump to code for blending
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(BinControl.Plc.ParBlend)JMP(ParBlend);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[If TargetValue changed, update
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(BinControl.Plc.o_TargetValueChanged)XIO(BinControl.Plc.o_RecipeChanged)[XIO(BinControl.Plc.o_SpecialBinActive) EQ(BinControl.Recipe.Ingr[BinControl.Plc.IndexIngr].BinNo,BinControl.BinList[BinControl.Plc.IndexBin].BinNo) MOVE(BinControl.Recipe.Ingr[BinControl.Plc.IndexIngr].TargetValue,BinControl.BinList[BinControl.Plc.IndexBin].o_TargetValue) ,XIC(BinControl.Plc.o_SpecialBinActive) EQ(BinControl.Recipe.Special.BinNo,BinControl.BinList[BinControl.Plc.IndexBin].BinNo) MOVE(BinControl.Recipe.Special.TargetValue,BinControl.BinList[BinControl.Plc.IndexBin].o_TargetValue) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[If recipe changed, check if current bin is still in list
 If found update Ingredient Pointer
 If not found CmdFirst
 
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(BinControl.Plc.o_RecipeChanged)NE(BinControl.HMI_Read.BinSelected,BinControl.Recipe.Ingr[BinControl.Plc.IndexIngr].BinNo)EQ(BinControl.HMI_Read.BinSelected,BinControl.HMI_Read.BinPreSelected)XIO(BinControl.Plc.o_SpecialBinActive)OTE(tmp_SearchForBin);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[LBL(Loop_SearchForBin)XIC(tmp_SearchForBin)[EQ(BinControl.HMI_Read.BinSelected,BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo) [MOVE(tmp_IndexIngr,BinControl.Plc.IndexIngr) ,MOVE(BinControl.Recipe.Ingr[BinControl.Plc.IndexIngr].TargetValue,BinControl.BinList[BinControl.Plc.IndexBin].o_TargetValue) ] ,NE(BinControl.HMI_Read.BinSelected,BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo) [ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) JMP(Loop_SearchForBin) ,OTL(BinControl.HMI_Write.CmdFirst) ] ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Check level and lock for current bin
 
 ]]>
</Comment>
<Text>
<![CDATA[[XIC(BinControl.Plc.ParSender) XIC(BinControl.BinList[BinControl.Plc.IndexBin].i_LowLevel) OTL(BinControl.Plc.o_Empty) ,XIC(BinControl.Plc.ParReceiver) XIC(BinControl.BinList[BinControl.Plc.IndexBin].i_HighLevel) OTL(BinControl.Plc.o_Full) ,XIC(BinControl.BinList[BinControl.Plc.IndexBin].i_Lock) ]XIO(BinControl.Plc.o_SpecialBinActive)OTL(BinControl.HMI_Write.CmdNext);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(BinControl.Plc.o_SpecialBinActive)EQ(BinControl.Recipe.Special.BinNo,BinControl.HMI_Read.BinSelected)XIC(BinControl.BinList[BinControl.Plc.IndexBin].i_Lock)OTL(BinControl.Plc.o_Empty)OTL(BinControl.Plc.o_Full);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Comment>
<![CDATA[Update bin Job Weight and HMI Read Job Weight
 
 ]]>
</Comment>
<Text>
<![CDATA[[GT(BinControl.Plc.i_JobWeight,BinControl.Plc.JobWeight_LastScan) SUB(BinControl.Plc.i_JobWeight,BinControl.Plc.JobWeight_LastScan,tmp_JobWeight_Delta) ,GT(tmp_JobWeight_Delta,0) ADD(BinControl.BinList[BinControl.Plc.IndexBin].o_JobWeight,tmp_JobWeight_Delta,BinControl.BinList[BinControl.Plc.IndexBin].o_JobWeight) ,MOVE(BinControl.Plc.i_JobWeight,BinControl.Plc.JobWeight_LastScan) ,MOVE(BinControl.Plc.i_JobWeight,BinControl.HMI_Read.JobWeight) ];]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Comment>
<![CDATA[Handle Special bin
 
 ]]>
</Comment>
<Text>
<![CDATA[OTU(tmp_CmdSpecialBin)OTU(tmp_CmdNotSpecialBin);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(BinControl.Plc.i_SpecialBin)[XIO(BinControl.Plc.o_SpecialBinActive) ,XIC(BinControl.Plc.o_RecipeChanged) ]NE(BinControl.Recipe.Special.BinNo,0)NE(BinControl.Recipe.Special.BinNo,BinControl.HMI_Read.BinSelected)NE(BinControl.Recipe.Special.BinNo,BinControl.HMI_Read.BinPreSelected)OTL(tmp_CmdSpecialBin)JMP(CmdSpecialBin);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIO(BinControl.Plc.i_SpecialBin)XIC(BinControl.Plc.o_SpecialBinActive)[EQ(BinControl.Recipe.Special.BinNo,BinControl.HMI_Read.BinSelected) ,EQ(BinControl.Recipe.Special.BinNo,BinControl.HMI_Read.BinPreSelected) ]OTL(tmp_CmdNotSpecialBin)JMP(CmdNotSpecialBin);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Comment>
<![CDATA[If both CmdFirst and CmdNext are on, CmdFirst takes priority
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(BinControl.HMI_Write.CmdFirst)XIC(BinControl.HMI_Write.CmdNext)OTU(BinControl.HMI_Write.CmdNext);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Comment>
<![CDATA[If NoValidBin found during initialization, then CmdFirst to search for bin
 ]]>
</Comment>
<Text>
<![CDATA[XIC(BinControl.Plc.o_NoValidBin)OTL(BinControl.HMI_Write.CmdFirst);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIO(BinControl.HMI_Write.CmdFirst)XIO(BinControl.HMI_Write.CmdNext)JMP(End);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(BinControl.HMI_Write.CmdFirst)JMP(CmdFirst);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(BinControl.HMI_Write.CmdNext)JMP(CmdNext);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------
 CmdFirst
 ----------------------------------------------------------------------------------------------------
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(CmdFirst)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="19" Type="N">
<Comment>
<![CDATA[Loop through recipe and find available bin
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_RecipeCmdFirst)NOP();]]>
</Text>
</Rung>
<Rung Number="20" Type="N">
<Text>
<![CDATA[LBL(Loop_BinsCmdFirst)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)[XIC(BinControl.Plc.ParSender) XIO(BinControl.BinList[tmp_IndexBin].i_LowLevel) ,XIC(BinControl.Plc.ParReceiver) XIO(BinControl.BinList[tmp_IndexBin].i_HighLevel) ]XIO(BinControl.BinList[tmp_IndexBin].i_Lock)[MOVE(BinControl.BinList[tmp_IndexBin].BinNo,BinControl.HMI_Read.BinPreSelected) ,OTU(BinControl.BinList[BinControl.Plc.IndexBinPreselect].o_PreSelected) ,OTL(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,MOVE(BinControl.Recipe.Ingr[tmp_IndexIngr].TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,MOVE(tmp_IndexIngr,BinControl.Plc.IndexIngrPreselect) MOVE(tmp_IndexBin,BinControl.Plc.IndexBinPreselect) ,OTU(BinControl.HMI_Write.CmdFirst) ,OTU(BinControl.Plc.o_NoValidBin) ,JMP(End) ];]]>
</Text>
</Rung>
<Rung Number="21" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_BinsCmdFirst) ];]]>
</Text>
</Rung>
<Rung Number="22" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) MOVE(0,tmp_IndexBin) JMP(Loop_RecipeCmdFirst) ];]]>
</Text>
</Rung>
<Rung Number="23" Type="N">
<Comment>
<![CDATA[If no available bin is found, Set NoNextBin output
 
 ]]>
</Comment>
<Text>
<![CDATA[OTL(BinControl.Plc.o_NoNextBin)JMP(End);]]>
</Text>
</Rung>
<Rung Number="24" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------
 CmdNext
 ----------------------------------------------------------------------------------------------------
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(CmdNext)MOVE(0,tmp_IndexBin)ADD(BinControl.Plc.IndexIngr,1,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="25" Type="N">
<Text>
<![CDATA[GE(tmp_IndexIngr,BinControl.Plc.ParIngrCount)[XIC(BinControl.Plc.ParLoop) OTL(BinControl.HMI_Write.CmdFirst) OTU(BinControl.HMI_Write.CmdNext) JMP(CmdFirst) ,XIO(BinControl.Plc.ParLoop) OTU(BinControl.HMI_Write.CmdNext) OTL(BinControl.Plc.o_NoNextBin) JMP(End) ];]]>
</Text>
</Rung>
<Rung Number="26" Type="N">
<Comment>
<![CDATA[Loop through recipe and find available bin
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_RecipeCmdNext)NOP();]]>
</Text>
</Rung>
<Rung Number="27" Type="N">
<Text>
<![CDATA[LBL(Loop_BinsCmdNext)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)[XIC(BinControl.Plc.ParSender) XIO(BinControl.BinList[tmp_IndexBin].i_LowLevel) ,XIC(BinControl.Plc.ParReceiver) XIO(BinControl.BinList[tmp_IndexBin].i_HighLevel) ]XIO(BinControl.BinList[tmp_IndexBin].i_Lock)[MOVE(BinControl.BinList[tmp_IndexBin].BinNo,BinControl.HMI_Read.BinPreSelected) ,OTU(BinControl.BinList[BinControl.Plc.IndexBinPreselect].o_PreSelected) ,OTL(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,MOVE(BinControl.Recipe.Ingr[tmp_IndexIngr].TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,MOVE(tmp_IndexIngr,BinControl.Plc.IndexIngrPreselect) MOVE(tmp_IndexBin,BinControl.Plc.IndexBinPreselect) ,OTU(BinControl.HMI_Write.CmdNext) ,JMP(End) ];]]>
</Text>
</Rung>
<Rung Number="28" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_BinsCmdNext) ];]]>
</Text>
</Rung>
<Rung Number="29" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) MOVE(0,tmp_IndexBin) JMP(Loop_RecipeCmdNext) ];]]>
</Text>
</Rung>
<Rung Number="30" Type="N">
<Comment>
<![CDATA[If no available bin is found:
 Not ParLoop - Set NoNextBin output
 ParLoop - Set CmdFirst
 
 ]]>
</Comment>
<Text>
<![CDATA[[XIC(BinControl.Plc.ParLoop) OTL(BinControl.HMI_Write.CmdFirst) OTU(BinControl.HMI_Write.CmdNext) JMP(CmdFirst) ,XIO(BinControl.Plc.ParLoop) OTU(BinControl.HMI_Write.CmdNext) OTL(BinControl.Plc.o_NoNextBin) JMP(End) ];]]>
</Text>
</Rung>
<Rung Number="31" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------
 CmdSpecailBin
 ----------------------------------------------------------------------------------------------------
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(CmdSpecialBin)MOVE(0,tmp_IndexBin)NOP();]]>
</Text>
</Rung>
<Rung Number="32" Type="N">
<Comment>
<![CDATA[If SpecialBin is selected, check if it is available
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_BinsCmdSpecial)NE(BinControl.Recipe.Special.BinNo,0)[EQ(BinControl.Recipe.Special.BinNo,BinControl.BinList[tmp_IndexBin].BinNo) [XIC(BinControl.Plc.ParSender) XIO(BinControl.BinList[tmp_IndexBin].i_LowLevel) ,XIC(BinControl.Plc.ParReceiver) XIO(BinControl.BinList[tmp_IndexBin].i_HighLevel) ] XIO(BinControl.BinList[tmp_IndexBin].i_Lock) [MOVE(BinControl.BinList[tmp_IndexBin].BinNo,BinControl.HMI_Read.BinPreSelected) ,OTU(BinControl.BinList[BinControl.Plc.IndexBinPreselect].o_PreSelected) ,OTL(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,MOVE(BinControl.Recipe.Special.TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,MOVE(tmp_IndexBin,BinControl.Plc.IndexBinPreselect) ,OTL(BinControl.Plc.o_SpecialBinActive) ,JMP(End) ] ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_BinsCmdSpecial) ];]]>
</Text>
</Rung>
<Rung Number="33" Type="N">
<Comment>
<![CDATA[If special bin not available
 
 ]]>
</Comment>
<Text>
<![CDATA[JMP(End);]]>
</Text>
</Rung>
<Rung Number="34" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------
 CmdNotSpecailBin
 ----------------------------------------------------------------------------------------------------
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(CmdNotSpecialBin)MOVE(0,tmp_IndexBin)MOVE(BinControl.Plc.IndexIngr,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="35" Type="N">
<Comment>
<![CDATA[On deselect of Special bin set back to previous bin
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_BinsCmdNotSpecial)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)[MOVE(BinControl.BinList[tmp_IndexBin].BinNo,BinControl.HMI_Read.BinPreSelected) ,OTL(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,MOVE(BinControl.Recipe.Ingr[tmp_IndexIngr].TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,MOVE(tmp_IndexIngr,BinControl.Plc.IndexIngrPreselect) MOVE(tmp_IndexBin,BinControl.Plc.IndexBinPreselect) ,OTU(BinControl.Plc.o_SpecialBinActive) ,JMP(End) ];]]>
</Text>
</Rung>
<Rung Number="36" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_BinsCmdNotSpecial) ];]]>
</Text>
</Rung>
<Rung Number="37" Type="N">
<Comment>
<![CDATA[If previous bin not found in list:
 Set CmdFirst
 
 ]]>
</Comment>
<Text>
<![CDATA[OTU(BinControl.Plc.o_SpecialBinActive)OTL(BinControl.HMI_Write.CmdFirst)OTU(BinControl.HMI_Write.CmdNext)JMP(CmdFirst);]]>
</Text>
</Rung>
<Rung Number="38" Type="N">
<Text>
<![CDATA[LBL(End)NOP();]]>
</Text>
</Rung>
<Rung Number="39" Type="N">
<Comment>
<![CDATA[Handle switching from Preselect to Selected
 
 ]]>
</Comment>
<Text>
<![CDATA[NE(BinControl.HMI_Read.BinSelected,BinControl.HMI_Read.BinPreSelected)OTE(BinControl.Plc.o_BinChangeRequest);]]>
</Text>
</Rung>
<Rung Number="40" Type="N">
<Text>
<![CDATA[NE(BinControl.HMI_Read.BinSelected,BinControl.HMI_Read.BinPreSelected)XIC(BinControl.Plc.o_BinChangeRequest)XIC(BinControl.Plc.i_BinChangeOk)OTL(BinControl.HMI_Read.Hsk_RegisterBinReq);]]>
</Text>
</Rung>
<Rung Number="41" Type="N">
<Text>
<![CDATA[NE(BinControl.HMI_Read.BinSelected,BinControl.HMI_Read.BinPreSelected)XIC(BinControl.Plc.o_BinChangeRequest)XIC(BinControl.Plc.i_BinChangeOk)[XIC(BinControl.HMI_Read.Hsk_RegisterBinReq) [XIC(BinControl.HMI_Write.Hsk_RegisterBinDone) ,XIC(RegisterBinFailTimer.DN) ] ,XIO(BinControl.HMI_Read.Hsk_RegisterBinReq) ][OTU(BinControl.Plc.o_NoValidBin) ,MOVE(BinControl.HMI_Read.BinPreSelected,BinControl.HMI_Read.BinSelected) ,OTU(BinControl.BinList[BinControl.Plc.IndexBin].o_Active) OTU(BinControl.BinList[BinControl.Plc.IndexBin].o_PreSelected) ,OTL(BinControl.BinList[BinControl.Plc.IndexBinPreselect].o_Active) OTU(BinControl.BinList[BinControl.Plc.IndexBinPreselect].o_PreSelected) ,MOVE(0,BinControl.BinList[BinControl.Plc.IndexBin].o_TargetValue) ,MOVE(BinControl.Plc.IndexIngrPreselect,BinControl.Plc.IndexIngr) MOVE(BinControl.Plc.IndexBinPreselect,BinControl.Plc.IndexBin) ,[XIO(BinControl.Plc.o_SpecialBinActive) MOVE(BinControl.Recipe.Ingr[BinControl.Plc.IndexIngr].TargetValue,BinControl.BinList[BinControl.Plc.IndexBin].o_TargetValue) ,XIC(BinControl.Plc.o_SpecialBinActive) MOVE(BinControl.Recipe.Special.TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ] ];]]>
</Text>
</Rung>
<Rung Number="42" Type="N">
<Text>
<![CDATA[JMP(End_Routine);]]>
</Text>
</Rung>
<Rung Number="43" Type="N">
<Comment>
<![CDATA[----------------------------------------------------------------------------------------------------
 ParBlend Section
 ----------------------------------------------------------------------------------------------------
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="44" Type="N">
<Comment>
<![CDATA[Check for Recipe / TargetValue changes
 
 
 
 ]]>
</Comment>
<Text>
<![CDATA[[XIC(BinControl.Plc.o_TargetValueChanged) XIO(BinControl.Plc.o_RecipeChanged) XIO(BinControl.Plc.o_BinChangeRequest) XIO(BinControl.HMI_Write.CmdFirst) JMP(ParBlend_UpdateTargetValue) ,[XIC(BinControl.Plc.o_RecipeChanged) ,XIC(BinControl.Plc.o_BinChangeRequest) ,XIC(BinControl.HMI_Write.CmdFirst) OTL(BinControl.Plc.o_RecipeChanged) ] JMP(ParBlend_UpdateRecipe) ,JMP(ParBlend_CheckLevels) ];]]>
</Text>
</Rung>
<Rung Number="45" Type="N">
<Comment>
<![CDATA[// ParBlend - Update Target Values
 
 Loop through recipe and update TargetValue
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_UpdateTargetValue)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="46" Type="N">
<Text>
<![CDATA[LBL(Loop_UpdateTargetValueBins)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)XIC(BinControl.BinList[tmp_IndexBin].o_Active)[MOVE(BinControl.Recipe.Ingr[tmp_IndexIngr].TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,JMP(Loop_UpdateTargetValue_NextIngr) ];]]>
</Text>
</Rung>
<Rung Number="47" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_UpdateTargetValueBins) ];]]>
</Text>
</Rung>
<Rung Number="48" Type="N">
<Text>
<![CDATA[LBL(Loop_UpdateTargetValue_NextIngr)[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) MOVE(0,tmp_IndexBin) JMP(Loop_UpdateTargetValueBins) ];]]>
</Text>
</Rung>
<Rung Number="49" Type="N">
<Text>
<![CDATA[JMP(ParBlend_CheckLevels);]]>
</Text>
</Rung>
<Rung Number="50" Type="N">
<Comment>
<![CDATA[// ParBlend - Update Recipe
 
 Loop through recipe and PreSelect bins
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_UpdateRecipe)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="51" Type="N">
<Comment>
<![CDATA[Reset PreSelect bits
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_UpdateRecipePreselect)[NE(BinControl.BinList[tmp_IndexBin].BinNo,0) OTU(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_UpdateRecipePreselect) ];]]>
</Text>
</Rung>
<Rung Number="52" Type="N">
<Comment>
<![CDATA[Loop through recipe and find bins
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_UpdateRecipeIngr)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)MOVE(0,BinControl.Plc.o_ActiveBinCountPreselect)NOP();]]>
</Text>
</Rung>
<Rung Number="53" Type="N">
<Text>
<![CDATA[LBL(Loop_UpdateRecipeBins)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)[OTL(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,ADD(BinControl.Plc.o_ActiveBinCountPreselect,1,BinControl.Plc.o_ActiveBinCountPreselect) ,JMP(ParBlend_UpdateRecipe_NextIngr) ];]]>
</Text>
</Rung>
<Rung Number="54" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_UpdateRecipeBins) ];]]>
</Text>
</Rung>
<Rung Number="55" Type="N">
<Text>
<![CDATA[LBL(ParBlend_UpdateRecipe_NextIngr)[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) MOVE(0,tmp_IndexBin) JMP(Loop_UpdateRecipeBins) ];]]>
</Text>
</Rung>
<Rung Number="56" Type="N">
<Text>
<![CDATA[JMP(ParBlend_CheckLevels);]]>
</Text>
</Rung>
<Rung Number="57" Type="N">
<Comment>
<![CDATA[// ParBlend - Check Levels
 
 Check levels and locked for Active bins
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_CheckLevels)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="58" Type="N">
<Text>
<![CDATA[LBL(ParBlend_CheckLevelBins)[XIC(BinControl.BinList[tmp_IndexBin].o_Active) [XIC(BinControl.Plc.ParSender) XIC(BinControl.BinList[tmp_IndexBin].i_LowLevel) OTL(BinControl.Plc.o_Empty) ,XIC(BinControl.Plc.ParReceiver) XIC(BinControl.BinList[tmp_IndexBin].i_HighLevel) OTL(BinControl.Plc.o_Full) ,XIC(BinControl.BinList[tmp_IndexBin].i_Lock) OTL(BinControl.Plc.o_Empty) OTL(BinControl.Plc.o_Full) ] ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_CheckLevelBins) ,MOVE(0,tmp_IndexBin) ];]]>
</Text>
</Rung>
<Rung Number="59" Type="N">
<Comment>
<![CDATA[Update bin Job Weight and HMI Read Job Weight
 
 (in ParBlend mode Job Weight is the sum of the bin Job Weights)
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_UpdateJobWeight)[ADD(BinControl.BinList[tmp_IndexBin].o_JobWeight,tmp_JobWeight,tmp_JobWeight) ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_UpdateJobWeight) ,MOVE(tmp_JobWeight,BinControl.HMI_Read.JobWeight) ,MOVE(0,tmp_IndexBin) ];]]>
</Text>
</Rung>
<Rung Number="60" Type="N">
<Comment>
<![CDATA[// ParBlend - Handle Bin Change
 
 ]]>
</Comment>
<Text>
<![CDATA[[XIC(BinControl.Plc.o_RecipeChanged) ,XIC(BinControl.Plc.o_BinChangeRequest) ]OTE(BinControl.Plc.o_BinChangeRequest);]]>
</Text>
</Rung>
<Rung Number="61" Type="N">
<Text>
<![CDATA[XIC(BinControl.Plc.o_BinChangeRequest)XIC(BinControl.Plc.i_BinChangeOk)OTL(BinControl.HMI_Read.Hsk_RegisterBinReq);]]>
</Text>
</Rung>
<Rung Number="62" Type="N">
<Text>
<![CDATA[[XIO(BinControl.Plc.o_BinChangeRequest) ,XIC(BinControl.Plc.o_BinChangeRequest) [XIO(BinControl.Plc.i_BinChangeOk) ,XIC(BinControl.Plc.i_BinChangeOk) [XIC(BinControl.HMI_Read.Hsk_RegisterBinReq) XIO(BinControl.HMI_Write.Hsk_RegisterBinDone) XIO(RegisterBinFailTimer.DN) ,XIO(BinControl.HMI_Read.Hsk_RegisterBinReq) ] ] ]JMP(End_Routine);]]>
</Text>
</Rung>
<Rung Number="63" Type="N">
<Comment>
<![CDATA[// Execute Bin Change
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_ExecuteBinChange)[MOVE(0,tmp_IndexBin) MOVE(0,tmp_IndexIngr) MOVE(0,BinControl.Plc.o_ActiveBinCount) MOVE(0,BinControl.Plc.o_ActiveBinCountPreselect) ,OTU(BinControl.Plc.o_BinChangeRequest) OTU(BinControl.Plc.o_NoValidBin) ]NOP();]]>
</Text>
</Rung>
<Rung Number="64" Type="N">
<Comment>
<![CDATA[Reset o_Active bits and Target Values
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_ExecuteBinChangeResetActive)[NE(BinControl.BinList[tmp_IndexBin].BinNo,0) [OTU(BinControl.BinList[tmp_IndexBin].o_Active) ,MOVE(0,BinControl.BinList[tmp_IndexBin].o_TargetValue) ] ,ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_ExecuteBinChangeResetActive) ];]]>
</Text>
</Rung>
<Rung Number="65" Type="N">
<Text>
<![CDATA[LBL(ParBlend_ExecuteBinChangeIngr)MOVE(0,tmp_IndexBin)MOVE(0,tmp_IndexIngr)NOP();]]>
</Text>
</Rung>
<Rung Number="66" Type="N">
<Comment>
<![CDATA[Select bins
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(ParBlend_ExecuteBinChangeBins)NE(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,0)EQ(BinControl.Recipe.Ingr[tmp_IndexIngr].BinNo,BinControl.BinList[tmp_IndexBin].BinNo)[OTL(BinControl.BinList[tmp_IndexBin].o_Active) OTU(BinControl.BinList[tmp_IndexBin].o_PreSelected) ,MOVE(BinControl.Recipe.Ingr[tmp_IndexIngr].TargetValue,BinControl.BinList[tmp_IndexBin].o_TargetValue) ,ADD(BinControl.Plc.o_ActiveBinCount,1,BinControl.Plc.o_ActiveBinCount) ,[XIC(BinControl.Plc.ParSender) XIC(BinControl.BinList[tmp_IndexBin].i_LowLevel) OTL(BinControl.Plc.o_Empty) ,XIC(BinControl.Plc.ParReceiver) XIC(BinControl.BinList[tmp_IndexBin].i_HighLevel) OTL(BinControl.Plc.o_Full) ,XIC(BinControl.BinList[tmp_IndexBin].i_Lock) OTL(BinControl.Plc.o_Empty) OTL(BinControl.Plc.o_Full) ] ,JMP(ParBlend_BinChangeNextIngr) ];]]>
</Text>
</Rung>
<Rung Number="67" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(ParBlend_ExecuteBinChangeBins) ];]]>
</Text>
</Rung>
<Rung Number="68" Type="N">
<Text>
<![CDATA[LBL(ParBlend_BinChangeNextIngr)[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl.Plc.ParIngrCount) MOVE(0,tmp_IndexBin) JMP(ParBlend_ExecuteBinChangeBins) ];]]>
</Text>
</Rung>
<Rung Number="69" Type="N">
<Comment>
<![CDATA[If not available bin is found, Set NoValidBin output
 
 ]]>
</Comment>
<Text>
<![CDATA[EQ(BinControl.Plc.o_ActiveBinCount,0)OTL(BinControl.Plc.o_NoValidBin);]]>
</Text>
</Rung>
<Rung Number="70" Type="N">
<Text>
<![CDATA[LBL(End_Routine)[OTU(BinControl.HMI_Write.CmdNext) OTU(BinControl.HMI_Write.CmdFirst) ,OTU(BinControl.Plc.o_TargetValueChanged) OTU(BinControl.Plc.o_RecipeChanged) ];]]>
</Text>
</Rung>
<Rung Number="71" Type="N">
<Comment>
<![CDATA[Handle Bin Register Handshake
 
 ]]>
</Comment>
<Text>
<![CDATA[[[XIC(BinControl.HMI_Read.Hsk_RegisterBinReq) ,XIO(BinControl.HMI_Read.Hsk_RegisterBinReq) ] XIC(BinControl.HMI_Write.Hsk_RegisterBinDone) ,XIC(RegisterBinFailTimer.DN) ]OTU(BinControl.HMI_Read.Hsk_RegisterBinReq)OTU(BinControl.HMI_Write.Hsk_RegisterBinDone);]]>
</Text>
</Rung>
<Rung Number="72" Type="N">
<Text>
<![CDATA[XIC(BinControl.HMI_Read.Hsk_RegisterBinReq)XIO(BinControl.HMI_Write.Hsk_RegisterBinDone)TON(RegisterBinFailTimer,?,?);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="BinControl"/>
