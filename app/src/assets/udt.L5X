</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Selected[IndexGroup])XIC(Group_Control.i_Hand[IndexGroup])LT(Index6,31)[MOVE(IndexGroup,Group_Tool.SelectedInHand[Index6]) ,ADD(Index6,1,Index6) ];]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_SelectedIdle[IndexGroup])XIO(Group_Control.i_Stopped[IndexGroup])XIO(Route_Group.i_NotRelevantStopped[IndexGroup])LT(Index7,31)[MOVE(IndexGroup,Group_Tool.IdlingNotStopped[Index7]) ,ADD(Index7,1,Index7) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Selected[IndexGroup])XIC(Group_Control.i_Dirty[IndexGroup])LT(Index8,31)[MOVE(IndexGroup,Group_Tool.SelectedDirty[Index8]) ,ADD(Index8,1,Index8) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_ConflictCommodity[IndexGroup])LT(Index9,31)[MOVE(IndexGroup,Group_Tool.CommodityConflict[Index9]) ,ADD(Index9,1,Index9) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[[ADD(IndexGroup,1,IndexGroup) ,LT(IndexGroup,tmp_LastGroup) JMP(Gr_Loop) ];]]>
