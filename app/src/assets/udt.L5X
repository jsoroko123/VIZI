<Parameter Name="ArrayDest" TagType="Base" DataType="BOOL" Dimensions="512" Usage="InOut" Radix="Decimal" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="Index" DataType="DINT" Radix="Decimal" ExternalAccess="None">
