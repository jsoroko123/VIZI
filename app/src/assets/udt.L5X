<Text>
<![CDATA[[CLR(IndexGroup) ,CLR(Index1) CLR(Index2) CLR(Index3) CLR(Index4) ,CLR(Index5) CLR(Index6) CLR(Index7) CLR(Index8) ,CLR(Index9) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[[CPS(tmp_EmptyArray[0],Group_Tool.GroupConflict[0],32) CPS(tmp_EmptyArray[0],Group_Tool.FgrSelectedNotRunning[0],32) CPS(tmp_EmptyArray[0],Group_Tool.MgrSelectedNotRunning[0],32) CPS(tmp_EmptyArray[0],Group_Tool.WgrSelectedNotRunning[0],32) ,CPS(tmp_EmptyArray[0],Group_Tool.SelectedFaulted[0],32) CPS(tmp_EmptyArray[0],Group_Tool.SelectedInHand[0],32) CPS(tmp_EmptyArray[0],Group_Tool.IdlingNotStopped[0],32) CPS(tmp_EmptyArray[0],Group_Tool.SelectedDirty[0],32) ,CPS(tmp_EmptyArray[0],Group_Tool.CommodityConflict[0],32) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[ADD(LastGroup,1,tmp_LastGroup) ,GT(tmp_LastGroup,512) MOVE(512,tmp_LastGroup) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[LBL(Gr_Loop)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Conflict[IndexGroup])LT(Index1,31)[MOVE(IndexGroup,Group_Tool.GroupConflict[Index1]) ,ADD(Index1,1,Index1) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Selected[IndexGroup])XIC(Group_Control.i_Fgr[IndexGroup])XIO(Group_Control.i_Running[IndexGroup])XIO(Route_Group.i_NotRelevantRunning[IndexGroup])LT(Index2,31)[MOVE(IndexGroup,Group_Tool.FgrSelectedNotRunning[Index2]) ,ADD(Index2,1,Index2) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Selected[IndexGroup])XIC(Group_Control.i_Mgr[IndexGroup])XIO(Group_Control.i_Running[IndexGroup])XIO(Route_Group.i_NotRelevantRunning[IndexGroup])LT(Index3,31)[MOVE(IndexGroup,Group_Tool.MgrSelectedNotRunning[Index3]) ,ADD(Index3,1,Index3) ];]]>
