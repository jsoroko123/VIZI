<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Loop through groups and update status
 
 ---
 ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[CLR(Index) ,OTU(Tmp_FgrPresent) OTU(Tmp_MgrPresent) OTU(Tmp_WgrPresent) OTU(Tmp_GgrPresent) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Initialize group status
 
 ]]>
</Comment>
<Text>
<![CDATA[[OTL(Route_Group.Fgr.o_Running) OTL(Route_Group.Fgr.o_Stopped) OTU(Route_Group.Fgr.o_Fault) OTU(Route_Group.Fgr.o_Warning) OTU(Route_Group.Fgr.o_Hand) OTU(Route_Group.Fgr.o_Dirty) OTU(Route_Group.Fgr.o_Fault) ,OTL(Route_Group.Mgr.o_Running) OTL(Route_Group.Mgr.o_Stopped) OTU(Route_Group.Mgr.o_Fault) OTU(Route_Group.Mgr.o_Warning) OTU(Route_Group.Mgr.o_Hand) OTU(Route_Group.Mgr.o_Dirty) OTU(Route_Group.Mgr.o_Fault) ,OTL(Route_Group.Wgr.o_Running) OTL(Route_Group.Wgr.o_Stopped) OTU(Route_Group.Wgr.o_Fault) OTU(Route_Group.Wgr.o_Warning) OTU(Route_Group.Wgr.o_Hand) OTU(Route_Group.Wgr.o_Dirty) OTU(Route_Group.Wgr.o_Fault) ,OTL(Route_Group.Ggr.o_Running) OTL(Route_Group.Ggr.o_Stopped) OTU(Route_Group.Ggr.o_Fault) OTU(Route_Group.Ggr.o_Warning) OTU(Route_Group.Ggr.o_Hand) OTU(Route_Group.Ggr.o_Dirty) OTU(Route_Group.Ggr.o_Fault) ];]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[LBL(Gr_Loop)NOP();]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Route_Group.o_Selected[Index]) ,XIC(Route_Group.o_SelectedIdle[Index]) ][XIC(Group_Control.i_Fgr[Index]) OTL(Tmp_FgrPresent) ,XIC(Group_Control.i_Mgr[Index]) OTL(Tmp_MgrPresent) ,XIC(Group_Control.i_Wgr[Index]) OTL(Tmp_WgrPresent) ,XIC(Group_Control.i_Ggr[Index]) OTL(Tmp_GgrPresent) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[Update goup status for each catagory of groups
 
 ]]>
</Comment>
<Text>
<![CDATA[XIC(Route_Group.o_Selected[Index])XIO(Group_Control.i_Running[Index])XIO(Route_Group.i_NotRelevantRunning[Index])[XIC(Group_Control.i_Fgr[Index]) OTU(Route_Group.Fgr.o_Running) ,XIC(Group_Control.i_Mgr[Index]) OTU(Route_Group.Mgr.o_Running) ,XIC(Group_Control.i_Wgr[Index]) OTU(Route_Group.Wgr.o_Running) ,XIC(Group_Control.i_Ggr[Index]) OTU(Route_Group.Ggr.o_Running) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[XIC(Route_Group.o_Selected[Index]) ,XIC(Route_Group.o_SelectedIdle[Index]) ]XIO(Group_Control.i_Stopped[Index])XIO(Group_Control.o_Shared[Index])XIO(Route_Group.i_NotRelevantStopped[Index])[XIC(Group_Control.i_Fgr[Index]) OTU(Route_Group.Fgr.o_Stopped) ,XIC(Group_Control.i_Mgr[Index]) OTU(Route_Group.Mgr.o_Stopped) ,XIC(Group_Control.i_Wgr[Index]) OTU(Route_Group.Wgr.o_Stopped) ,XIC(Group_Control.i_Ggr[Index]) OTU(Route_Group.Ggr.o_Stopped) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Selected[Index])XIC(Group_Control.i_Fault[Index])XIO(Route_Group.i_NotRelevantFault[Index])[XIC(Group_Control.i_Fgr[Index]) OTL(Route_Group.Fgr.o_Fault) ,XIC(Group_Control.i_Mgr[Index]) OTL(Route_Group.Mgr.o_Fault) ,XIC(Group_Control.i_Wgr[Index]) OTL(Route_Group.Wgr.o_Fault) ,XIC(Group_Control.i_Ggr[Index]) OTL(Route_Group.Ggr.o_Fault) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(Route_Group.o_Selected[Index])XIC(Group_Control.i_Warning[Index])[XIC(Group_Control.i_Fgr[Index]) OTL(Route_Group.Fgr.o_Warning) ,XIC(Group_Control.i_Mgr[Index]) OTL(Route_Group.Mgr.o_Warning) ,XIC(Group_Control.i_Wgr[Index]) OTL(Route_Group.Wgr.o_Warning) ,XIC(Group_Control.i_Ggr[Index]) OTL(Route_Group.Ggr.o_Warning) ];]]>
</Text>
