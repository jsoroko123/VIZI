<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Loop through required groups and select if available
 
 ---
 ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[[CLR(Index) CLR(IndexRoute) OTU(Route_Group.GroupConflict) OTU(Route_Group.CommodityConflict) ,ArrayClearBool(Route_Group.ArrayClearBool,Route_Group.o_Conflict,Route_Group.ArrayLength) ,ArrayClearBool(Route_Group.ArrayClearBool,Route_Group.o_ConflictCommodity,Route_Group.ArrayLength) ];]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[LBL(Gr_Loop)NOP();]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[If group was just deselected, Set SelectedIdle bit
 
 ]]>
</Comment>
<Text>
<![CDATA[XIO(Route_Group.i_Required[Index])XIC(Route_Group.o_Selected[Index])OTL(Route_Group.o_SelectedIdle[Index]);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIO(Route_Group.i_Required[Index])[OTU(Route_Group.o_Selected[Index]) ,OTU(Route_Array.Route[RouteArrayPointer].Gr.o_Selected[Index]) ];]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(Route_Group.i_Required[Index])[[XIO(Group_Control.o_Owned[Index]) ,XIC(Group_Control.i_Share[Index]) ] [XIO(Route_Array.Route[IndexRoute].ParCommodityCheck) ,XIC(Route_Array.Route[IndexRoute].ParCommodityCheck) [XIO(Group_Control.i_Dirty[Index]) ,LE(Group_Control.i_Commodity[Index],0) ,LE(Route_Array.Route[IndexRoute].Commodity,0) ,EQ(Group_Control.i_Commodity[Index],Route_Array.Route[IndexRoute].Commodity) ] ] [OTL(Route_Group.o_Selected[Index]) ,OTL(Route_Array.Route[RouteArrayPointer].Gr.o_Selected[Index]) ] ,XIO(Route_Group.o_Selected[Index]) XIC(Route_Array.Route[IndexRoute].ParCommodityCheck) XIC(Group_Control.i_Dirty[Index]) GT(Group_Control.i_Commodity[Index],0) GT(Route_Array.Route[IndexRoute].Commodity,0) NE(Group_Control.i_Commodity[Index],Route_Array.Route[IndexRoute].Commodity) [OTL(Route_Group.o_ConflictCommodity[Index]) ,OTL(Route_Group.CommodityConflict) ] ,XIO(Route_Group.o_Selected[Index]) XIC(Group_Control.o_Owned[Index]) XIO(Group_Control.i_Share[Index]) [OTL(Route_Group.o_Conflict[Index]) ,OTL(Route_Group.GroupConflict) ] ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[ADD(Index,1,Index) ,LT(Index,Route_Group.ArrayLength) JMP(Gr_Loop) ];]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Comment>
<![CDATA[Loop through all routes and update selected / shared
 
 ---
 ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[[CLR(Index) CLR(IndexRoute) SIZE(Route_Array.Route[0],0,RouteArraySize) ,ArrayClearBool(Route_Group.ArrayClearBool,tmp_o_Owned,Route_Group.ArrayLength) ArrayClearBool(Route_Group.ArrayClearBool,tmp_o_Shared,Route_Group.ArrayLength) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[LBL(Section_Loop)NOP();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[LBL(Gr_Loop2)NOP();]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Route_Array.Route[IndexRoute].Gr.o_Selected[Index])[XIC(tmp_o_Owned[Index]) OTL(tmp_o_Shared[Index]) ,OTL(tmp_o_Owned[Index]) ];]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[[ADD(Index,1,Index) ,LT(Index,Route_Group.ArrayLength) JMP(Gr_Loop2) ];]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[[ADD(IndexRoute,1,IndexRoute) CLR(Index) ,LT(IndexRoute,RouteArraySize) JMP(Section_Loop) ];]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[ArrayCopyBool(CopyBool,Route_Group.ArrayLength,tmp_o_Owned,Group_Control.o_Owned)ArrayCopyBool(CopyBool,Route_Group.ArrayLength,tmp_o_Shared,Group_Control.o_Shared);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
