<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* Perform bounds checking of the number of elements parameter *)]]>
</Line>
<Line Number="1">
<![CDATA[(* Limit the number of elements*)]]>
</Line>
<Line Number="2">
<![CDATA[if NumberOfElements < 1 then ]]>
</Line>
<Line Number="3">
<![CDATA[NumberOfElements := 1;]]>
</Line>
<Line Number="4">
<![CDATA[end_if;]]>
</Line>
<Line Number="5">
<![CDATA[if NumberOfElements >= 512 then ]]>
</Line>
<Line Number="6">
<![CDATA[NumberOfElements := 512;]]>
</Line>
<Line Number="7">
<![CDATA[end_if;]]>
</Line>
<Line Number="8">
<![CDATA[(* Set Every Array Value To 0 *)]]>
</Line>
<Line Number="9">
<![CDATA[For Index := 0 To (NumberOfElements-1) Do]]>
</Line>
<Line Number="10">
<![CDATA[Array[Index] := 0;]]>
</Line>
<Line Number="11">
<![CDATA[End_For;]]>
</Line>
<Line Number="12">
<![CDATA[(*End*)]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
