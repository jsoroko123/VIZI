<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Loop through groups and update status
 
 ---
 ]]>
</Comment>
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Initialize Data
 
 ---
 ]]>
