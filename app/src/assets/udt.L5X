<AddOnInstructionDefinition Name="BinController_JobChange" Class="Standard" Revision="1.0" Vendor="KE" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2023-11-16T18:21:28.984Z" CreatedBy="KNOBELSDORFF\Jeremy.Noble" EditedDate="2024-03-14T16:45:44.419Z" EditedBy="KNOBELSDORFF\Jeremy.Noble"
 SoftwareRevision="v33.00">
<RevisionNote>
<![CDATA[v1.0]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="BinControl" TagType="Base" DataType="BinControl" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="tmp_IndexBin" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Initialize flags
 
 ]]>
</Comment>
<Text>
<![CDATA[MOVE(0,tmp_IndexBin);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[Loop through bin list and copy JobWeight to JobWeight_LastJob
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_Bins)MOVE(BinControl.BinList[tmp_IndexBin].o_JobWeight,BinControl.BinList[tmp_IndexBin].o_JobWeight_LastJob);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexBin,1,tmp_IndexBin) ,LT(tmp_IndexBin,BinControl.Plc.ParBinCount) JMP(Loop_Bins) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Copy overall JobWeight to JobWeight_LastJob
 Set Handshake flag for HMI
 
 ]]>
</Comment>
<Text>
<![CDATA[MOVE(BinControl.HMI_Read.JobNo,BinControl.HMI_Read.JobNo_LastJob)MOVE(BinControl.HMI_Read.JobWeight,BinControl.HMI_Read.JobWeight_LastJob)OTL(BinControl.HMI_Read.Hsk_LogLastJob);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="BinControl"/>
</Dependencies>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="BinController_RecipeCheck" Class="Standard" Revision="1.0" Vendor="KE" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2023-10-19T15:06:26.437Z" CreatedBy="KNOBELSDORFF\Jeremy.Noble" EditedDate="2024-03-14T16:45:44.432Z" EditedBy="KNOBELSDORFF\Jeremy.Noble"
 SoftwareRevision="v33.00">
<RevisionNote>
<![CDATA[v1.0]]>
</RevisionNote>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Input - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only">
<Description>
<![CDATA[Enable Output - System Defined Parameter]]>
</Description>
</Parameter>
<Parameter Name="JobRecipe" TagType="Base" DataType="BinControl_Recipe" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="BinControlRecipe" TagType="Base" DataType="BinControl_Recipe" Usage="InOut" Required="true" Visible="true" Constant="false"/>
<Parameter Name="BinControl_Plc" TagType="Base" DataType="BinControl_Plc" Usage="InOut" Required="true" Visible="true" Constant="false"/>
</Parameters>
<LocalTags>
<LocalTag Name="tmp_IndexIngr" DataType="DINT" Radix="Decimal" ExternalAccess="None">
<DefaultData Format="L5K">
<![CDATA[0]]>
</DefaultData>
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</DefaultData>
</LocalTag>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NOP();]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[Initialize flags
 
 ]]>
</Comment>
<Text>
<![CDATA[OTU(BinControl_Plc.o_RecipeChanged)OTU(BinControl_Plc.o_TargetValueChanged);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(0,tmp_IndexIngr);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[Check if there are changes to the special bin
 (only check if special bin is active) 
 
 ]]>
</Comment>
<Text>
<![CDATA[[XIC(BinControl_Plc.i_SpecialBin) ,XIC(BinControl_Plc.o_SpecialBinActive) ][NE(JobRecipe.Special.BinNo,BinControlRecipe.Special.BinNo) OTL(BinControl_Plc.o_RecipeChanged) ,NE(JobRecipe.Special.TargetValue,BinControlRecipe.Special.TargetValue) OTL(BinControl_Plc.o_TargetValueChanged) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Comment>
<![CDATA[Check if bin control recipe for job has changed
 
 ]]>
</Comment>
<Text>
<![CDATA[LBL(Loop_Recipe)NOP();]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[[NE(JobRecipe.Ingr[tmp_IndexIngr].BinNo,BinControlRecipe.Ingr[tmp_IndexIngr].BinNo) OTL(BinControl_Plc.o_RecipeChanged) ,NE(JobRecipe.Ingr[tmp_IndexIngr].TargetValue,BinControlRecipe.Ingr[tmp_IndexIngr].TargetValue) OTL(BinControl_Plc.o_TargetValueChanged) ];]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[ADD(tmp_IndexIngr,1,tmp_IndexIngr) ,LT(tmp_IndexIngr,BinControl_Plc.ParIngrCount) JMP(Loop_Recipe) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
<Dependencies>
<Dependency Type="DataType" Name="BinControl_Recipe"/>
<Dependency Type="DataType" Name="BinControl_Plc"/>
</Dependencies>
</AddOnInstructionDefinition>
<AddOnInstructionDefinition Name="SCP" Class="Standard" Revision="1.2" Vendor="Rockwell Automation" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false" CreatedDate="2007-02-02T20:31:08.937Z" CreatedBy="Not Available" EditedDate="2007-02-13T14:38:40.692Z" EditedBy="Not Available"
 SoftwareRevision="v16.00">
<Description>
<![CDATA[Scale w/Parameters]]>
</Description>
<AdditionalHelpText>
<![CDATA[Use this instruction to scale data from your analog module and bring it into the limits prescribed by the process variable or another analog module. 
Equations used in calculating a linear relationship: 

Scaled value = (input value - input min.) x rate + scaled minimum 
Rate = (scaled max. - scaled min.) / (input max. - input min.) 


]]>
</AdditionalHelpText>
<Parameters>
