<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[(* Copy for Boolean Arrays *)]]>
</Line>
<Line Number="1">
<![CDATA[(* Limit the number of elements*)]]>
</Line>
<Line Number="2">
<![CDATA[IF NumberOfElements < 1 THEN ]]>
</Line>
<Line Number="3">
<![CDATA[NumberOfElements := 1 ;]]>
</Line>
<Line Number="4">
<![CDATA[END_IF ;]]>
</Line>
<Line Number="5">
<![CDATA[IF NumberOfElements >= 512 THEN ]]>
</Line>
<Line Number="6">
<![CDATA[NumberOfElements := 512 ;]]>
</Line>
<Line Number="7">
<![CDATA[END_IF ;]]>
</Line>
<Line Number="8">
<![CDATA[]]>
</Line>
<Line Number="9">
<![CDATA[FOR Index := 0 TO (NumberOfElements-1) DO]]>
</Line>
<Line Number="10">
<![CDATA[ArrayDest[Index] := ArraySource[Index] ;]]>
</Line>
<Line Number="11">
<![CDATA[END_FOR ;]]>
</Line>
<Line Number="12">
<![CDATA[(*End*)]]>
</Line>
</STContent>
</Routine>
</Routines>
